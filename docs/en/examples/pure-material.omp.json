{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground_templates": [
            "{{ .Env.TERMUX_MATERIAL_TERTIARY }}"
          ],
          "options": {
            "android": ""
          },
          "style": "plain",
          "template": "{{ .Icon }} ",
          "type": "os"
        },
        {
          "foreground_templates": [
            "{{ .Env.TERMUX_MATERIAL_PRIMARY }}"
          ],
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "foreground_templates": [
            "{{ .Env.TERMUX_MATERIAL_ON_SURFACE_VARIANT }}"
          ],
          "options": {
            "branch_ahead_icon": "<{{ .Env.TERMUX_MATERIAL_SECONDARY }}>⇡ </>",
            "branch_behind_icon": "<{{ .Env.TERMUX_MATERIAL_SECONDARY }}>⇣ </>",
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "github_icon": ""
          },
          "style": "plain",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<{{ .Env.TERMUX_MATERIAL_TERTIARY }}>*</>{{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "foreground_templates": [
            "{{ .Env.TERMUX_MATERIAL_SECONDARY }}"
          ],
          "options": {
            "style": "austin"
          },
          "style": "plain",
          "template": " {{ .FormattedMs }} ",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground_templates": [
            "{{ .Env.TERMUX_MATERIAL_PRIMARY }}",
            "{{ if gt .Code 0 }}{{ .Env.TERMUX_MATERIAL_ERROR }}{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "❯ ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}}(Admin){{end}} {{.PWD}}",
  "transient_prompt": {
    "foreground_templates": [
      "{{ .Env.TERMUX_MATERIAL_PRIMARY }}",
      "{{ if gt .Code 0 }}{{ .Env.TERMUX_MATERIAL_ERROR }}{{ end }}"
    ],
    "template": "❯ "
  },
  "version": 4
}
