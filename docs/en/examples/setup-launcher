#!/system/bin/sh
# setup-launcher — installs the showcase shell environment: everything, the
# shell essentials, or one item at a time.
#
#   Shell        fish, Oh My Posh with the wallpaper Material palette, zoxide, eza
#   Build tools  build-essential (clang, make, pkg-config), cmake, autotools
#   Editor       neovim + AstroNvim, themed from the same palette
#   Showcase     sigye, the animated-logo fastfetch, kitten
#
# ~/.termux is left alone: the app seeds termux.properties, the bindings conf and
# fonts.conf itself, and rewriting them here would discard the extra-keys row the
# in-app editor writes. Fonts come from the in-app picker (Settings > Terminal >
# Font).
#
# config.fish is launcher-owned and replaced on every run; conf.d/personal.fish
# is installed once and never touched again. Every replaced file gets a
# timestamped .bak.
#
# Templates are fetched from a pinned tag and checked against the digest tables
# below — config.fish and setup-nvim run code every session, so an unverified
# download would own the shell forever. Unpublished binaries are skipped, not
# installed unpinned.
#
# Maintainers: after editing any template run
#   docs/en/examples/update-setup-launcher-digests.sh [dir-with-built-binaries]
# commit the tables, then move TEMPLATES_REF to the release tag.

set -eu

TEMPLATES_REF="${TERMUX_LAUNCHER_REF:-v0.2.35}"
RAW_BASE="${TERMUX_LAUNCHER_RAW_BASE:-https://raw.githubusercontent.com/PickleHik3/termux-launcher/$TEMPLATES_REF/docs/en/examples}"
# Pinned separately from TEMPLATES_REF: these are other people's software on
# their own release schedule.
BINARIES_REF="${TERMUX_LAUNCHER_BINARIES_REF:-2026.08.17}"
BINARIES_BASE="${TERMUX_LAUNCHER_BINARIES_BASE:-https://raw.githubusercontent.com/PickleHik3/termux-launcher-binaries/$BINARIES_REF/bin}"

# --- BEGIN DIGESTS (generated: update-setup-launcher-digests.sh) ---
expected_digest() {
    case "$1" in
        aliens-material.omp.json) echo 87ce6bfdb16335fc543d3c974f19632503f0e803de73e728de8a265ac03da148 ;;
        conf.d-personal.fish)     echo d950402c7b896d34e7fb9e310f6ceef93fbbd0e7e86e6a5743fda80b251f4c7a ;;
        config.fish)              echo 9e977847efd4410075282d686441faa4bb9524e2eb5aecbb3031317d5b857de0 ;;
        setup-nvim)               echo 33f102c400dd706d6bf7fb46eeb363a94899d861c36c36286afaa6a951e48295 ;;
        *) echo "" ;;
    esac
}
# --- END DIGESTS ---

# --- BEGIN BINARY DIGESTS (generated: update-setup-launcher-digests.sh) ---
expected_binary_digest() {
    case "$1" in
        fastfetch)   echo 82fa706a1ad5eeb4a7899212ba6e03c441a1b6a798d81367ebb0d62cfca615e3 ;;
        kitten)      echo 274ff935007bd6aa28dd7ef71439b52e10c2d7e0641f4413fd959508a74bf8c7 ;;
        sigye)       echo be095e85f54c2a462b924ce21916a6586580713785ab5efc79b63050eead5eea ;;
        *) echo "" ;;
    esac
}
# --- END BINARY DIGESTS ---

FISH_CONFIG="${FISH_CONFIG:-$HOME/.config/fish/config.fish}"
OMP_DIR="${OMP_DIR:-$HOME/.config/ohmyposh}"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"

log() { printf '%s\n' "$*"; }
warn() { printf 'setup-launcher: %s\n' "$*" >&2; }
fail() { warn "$*"; exit 1; }

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

timestamp() { date +%Y%m%d-%H%M%S; }

backup_existing() {
    target="$1"
    if [ -e "$target" ]; then
        backup="$target.bak-$(timestamp)"
        cp -a "$target" "$backup"
        log "  existing $(basename "$target") backed up to $(basename "$backup")"
    fi
}

file_digest() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        echo ""
    fi
}

# download <url> <destination> <expected-sha256>
download() {
    url="$1"
    dest="$2"
    expected="$3"
    dest_dir=$(dirname "$dest")
    mkdir -p "$dest_dir"
    tmp="$dest_dir/.$(basename "$dest").download"
    if ! curl -fsSL -o "$tmp" "$url"; then
        rm -f "$tmp"
        fail "download failed: $url"
    fi

    if [ "${TERMUX_LAUNCHER_SKIP_DIGEST:-0}" = 1 ]; then
        warn "digest check skipped for $(basename "$dest") (TERMUX_LAUNCHER_SKIP_DIGEST=1)"
    else
        actual=$(file_digest "$tmp")
        if [ -z "$actual" ]; then
            rm -f "$tmp"
            fail "no sha256 tool available (install coreutils or openssl-tool) — cannot verify $url"
        fi
        if [ "$actual" != "$expected" ]; then
            rm -f "$tmp"
            fail "digest mismatch for $url
  expected $expected
  got      $actual
Refusing to install. Either the pinned ref ($TEMPLATES_REF) does not match this
script's digest table, or the download was tampered with."
        fi
    fi

    backup_existing "$dest"
    mv "$tmp" "$dest"
    log "  installed $dest"
}

# fetch <template-name> <destination>
fetch() {
    expected=$(expected_digest "$1")
    [ -n "$expected" ] || fail "no pinned digest for $1; refusing to install it"
    download "$RAW_BASE/$1" "$2" "$expected"
}

# fetch_once <template-name> <destination> — installed when missing, never replaced.
fetch_once() {
    if [ -e "$2" ]; then
        log "  kept existing $2 (yours to edit; delete it and re-run to refresh)"
    else
        fetch "$1" "$2"
    fi
}

# fetch_binary <name> — a release asset into ~/.local/bin, or a skip.
fetch_binary() {
    name="$1"
    expected=$(expected_binary_digest "$name")
    if [ -z "$expected" ]; then
        warn "$name is not published for $BINARIES_REF — skipping it.
  Build it yourself with recipes/cross/build-$name.sh (see docs/en/Building_Terminal_Showcase_Tools.md)."
        return 0
    fi
    download "$BINARIES_BASE/$name-aarch64" "$BIN_DIR/$name" "$expected"
    chmod +x "$BIN_DIR/$name"
}

ask_yn() {
    prompt="$1"
    default="${2:-y}"
    printf '%s [%s] ' "$prompt" "$([ "$default" = y ] && echo Y/n || echo y/N)"
    read -r answer || answer=""
    [ -n "$answer" ] || answer="$default"
    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

install_pkg() {
    if command -v pacman >/dev/null 2>&1; then
        # shellcheck disable=SC2068
        pacman -S --needed --noconfirm $@ || warn "could not install: $*"
    elif command -v pkg >/dev/null 2>&1; then
        # shellcheck disable=SC2068
        pkg install -y $@ || warn "could not install: $*"
    else
        fail "no supported package manager found (pkg or pacman)"
    fi
}

# ----------------------------------------------------------------------------
# Items
# ----------------------------------------------------------------------------

item_fish() {
    log ""
    log "== fish =="
    install_pkg fish
    fetch config.fish "$FISH_CONFIG"
    fetch_once conf.d-personal.fish "$(dirname "$FISH_CONFIG")/conf.d/personal.fish"
    if command -v fish >/dev/null 2>&1 && command -v chsh >/dev/null 2>&1; then
        if ask_yn "Make fish the default shell?"; then
            chsh -s fish || warn "chsh failed; run 'chsh -s fish' manually"
        fi
    fi
}

item_ohmyposh() {
    log ""
    log "== Oh My Posh =="
    install_pkg oh-my-posh
    fetch aliens-material.omp.json "$OMP_DIR/aliens-material.omp.json"
    log "  the theme follows ~/.termux/material-colors.sh, so it retints with the wallpaper"
}

item_zoxide() {
    log ""
    log "== zoxide =="
    install_pkg zoxide
}

item_eza() {
    log ""
    log "== eza =="
    install_pkg eza
}

item_neovim() {
    log ""
    log "== Neovim + AstroNvim =="
    # treesitter parsers compile on first start (needs a C toolchain) and the
    # pickers shell out to rg/fd.
    install_pkg neovim git build-essential ripgrep fd unzip wget
    fetch setup-nvim "$BIN_DIR/setup-nvim"
    chmod +x "$BIN_DIR/setup-nvim"
    # Safe unattended: setup-nvim will not replace a config without a typed REPLACE.
    "$BIN_DIR/setup-nvim" --distro astronvim --yes || warn "setup-nvim did not finish; run it yourself"
}

item_devtools() {
    log ""
    log "== build tools =="
    # build-essential = clang, make, pkg-config. The rest are its Recommends,
    # named explicitly because Recommends are not guaranteed to be pulled in.
    install_pkg build-essential git cmake autoconf automake libtool m4 bison flex \
                patchelf binutils python
    if command -v cc >/dev/null 2>&1; then
        log "  cc: $(cc --version 2>/dev/null | head -n 1)"
    else
        warn "no cc on PATH after install — package builds will still fail"
    fi
}

item_sigye()     { log ""; log "== sigye =="; fetch_binary sigye; }
item_kitten()    { log ""; log "== kitten (kitty's client) =="; fetch_binary kitten; }

item_fastfetch() {
    log ""
    log "== fastfetch (animated Kitty logo) =="
    # Links libandroid-glob (or it will not start) and dlopens the rest (or there
    # is no image logo, only ASCII art).
    install_pkg imagemagick chafa libandroid-glob zlib
    fetch_binary fastfetch
    if [ -x "$BIN_DIR/fastfetch" ] &&
       ! "$BIN_DIR/fastfetch" --list-features 2>/dev/null | grep -qx imagemagick7; then
        warn "fastfetch reports no imagemagick7 support — the GIF logo will not render."
    fi
}

install_all() {
    item_fish
    item_ohmyposh
    item_zoxide
    item_eza
    item_devtools
    item_neovim
    item_sigye
    item_fastfetch
    item_kitten
}

install_essentials() {
    item_fish
    item_ohmyposh
    item_zoxide
    item_eza
}

install_individually() {
    ask_yn "fish + the launcher's config.fish?"        && item_fish
    ask_yn "Oh My Posh + the Material theme?"          && item_ohmyposh
    ask_yn "zoxide?"                                   && item_zoxide
    ask_yn "eza?"                                      && item_eza
    ask_yn "Build tools (clang, make, cmake, autotools)?"   && item_devtools
    ask_yn "Neovim + AstroNvim (Material theme)?"      && item_neovim
    ask_yn "sigye (clock)?"                        n   && item_sigye
    ask_yn "fastfetch with the animated logo?"     n   && item_fastfetch
    ask_yn "kitten (kitty's client binary)?"       n   && item_kitten
    return 0
}

# ----------------------------------------------------------------------------
# Menu
# ----------------------------------------------------------------------------

welcome() {
    cat <<'EOF'
Termux Launcher setup
=====================

  1) All — fish, Oh My Posh, zoxide, eza, build tools, Neovim + AstroNvim,
     sigye, fastfetch with the animated logo, kitten
  2) Shell essentials — fish, Oh My Posh, zoxide, eza
  3) Pick items one at a time
  q) Quit

Every existing config gets a timestamped .bak before being replaced.
EOF
}

main() {
    require_cmd curl
    mkdir -p "$BIN_DIR"
    welcome
    printf 'Choice [1]: '
    read -r choice || choice=1
    [ -n "$choice" ] || choice=1

    case "$choice" in
        1) install_all ;;
        2) install_essentials ;;
        3) install_individually ;;
        q|Q) exit 0 ;;
        *) fail "unknown choice: $choice" ;;
    esac

    log ""
    log "Done. Open a new session (or run 'exec fish') to pick everything up."
}

main "$@"
