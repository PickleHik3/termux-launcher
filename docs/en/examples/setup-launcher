#!/system/bin/sh
# setup-launcher — Termux Launcher shell environment installer.
#
# Installs the current, secret-free templates derived from the live
# development setup: fish + Oh My Posh with wallpaper Material colors,
# zoxide/eza, and the launcher terminal configs in ~/.termux.
#
# Fonts are no longer handled here: the in-app font picker (Settings >
# Terminal > Font) downloads and wires up curated families, Nerd Font
# builds included.
#
# tmux, btop, and Shizuku are no longer part of this setup. The old installer
# that handled them is kept as docs/en/examples/setup-tmux-btop for existing
# users, but it is deprecated: the launcher's own windows, panes, workspaces,
# and status bar replace what tmux and btop provided here.
#
# The fish config is split in two: config.fish is launcher-owned and replaced
# on every run (with a .bak), while ~/.config/fish/conf.d/personal.fish is
# yours — installed once, never overwritten, and the place for aliases,
# EDITOR, and other personal settings.
#
# Neovim is handled by a separate chooser: this script installs `setup-nvim`
# into ~/.local/bin, and that picks a distro (AstroNvim by default, with a
# colourscheme generated from the wallpaper palette) only when you run it.
#
# Existing files are never overwritten silently — every replaced config gets a
# timestamped .bak alongside it.

# Every file this script installs is fetched from a pinned release tag and checked
# against the digest table below before it is allowed anywhere near your shell.
# Two of them — config.fish and setup-nvim — run code on every session, so a
# mutable branch and an unverified download would mean the repository (or anything
# that can answer for it) gets to choose what your shell executes forever after.
#
# Maintainers: after editing any template, run
#   docs/en/examples/update-setup-launcher-digests.sh
# and commit the refreshed table, then move TEMPLATES_REF to the release tag.

set -eu

TEMPLATES_REF="${TERMUX_LAUNCHER_REF:-v0.2.35}"
RAW_BASE="${TERMUX_LAUNCHER_RAW_BASE:-https://raw.githubusercontent.com/PickleHik3/termux-launcher/$TEMPLATES_REF/docs/en/examples}"

# --- BEGIN DIGESTS (generated: update-setup-launcher-digests.sh) ---
expected_digest() {
    case "$1" in
        aliens-material.omp.json) echo 87ce6bfdb16335fc543d3c974f19632503f0e803de73e728de8a265ac03da148 ;;
        conf.d-personal.fish)     echo 6f7b666475e07ee0447fbdba29485a8681f1f622e7c0ab3f98f3ff15b0142190 ;;
        config.fish)              echo 45d783407d0710d76dbc9d64abd539e6f8b449bd92a29c3108fa0908b810c353 ;;
        keyboard-layout.xml)      echo 06824f3611e7a47ab0ca9dc5d72cc90f50c10a27adf8db60693e335294dcceb5 ;;
        setup-nvim)               echo 345c79f048d4bf26dc5de7022443a470fb55266cb945367d383b2123049fa400 ;;
        termux-launcher.omp.json) echo 756eeb5e6eef28f9cd4d20bd3274d4a374a8e8e0002c27d8df0c1348893d3b5f ;;
        termux.properties)        echo dee11020c1eea3d7d81bae8837c47f3d68daeb7e5f949a4609a8b87052733355 ;;
        *) echo "" ;;
    esac
}
# --- END DIGESTS ---

FISH_CONFIG="${FISH_CONFIG:-$HOME/.config/fish/config.fish}"
OMP_DIR="${OMP_DIR:-$HOME/.config/ohmyposh}"
TERMUX_DIR="$HOME/.termux"

log() { printf '%s\n' "$*"; }
warn() { printf 'setup-launcher: %s\n' "$*" >&2; }
fail() { warn "$*"; exit 1; }

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

timestamp() { date +%Y%m%d-%H%M%S; }

backup_existing() {
    target="$1"
    if [ -e "$target" ]; then
        backup="$target.bak-$(timestamp)"
        cp -a "$target" "$backup"
        log "  existing $(basename "$target") backed up to $(basename "$backup")"
    fi
}

file_digest() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        echo ""
    fi
}

# fetch <relative-name> <destination>
fetch() {
    name="$1"
    dest="$2"
    dest_dir=$(dirname "$dest")
    mkdir -p "$dest_dir"
    tmp="$dest_dir/.$(basename "$dest").download"
    if ! curl -fsSL -o "$tmp" "$RAW_BASE/$name"; then
        rm -f "$tmp"
        fail "download failed: $RAW_BASE/$name"
    fi

    if [ "${TERMUX_LAUNCHER_SKIP_DIGEST:-0}" = 1 ]; then
        warn "digest check skipped for $name (TERMUX_LAUNCHER_SKIP_DIGEST=1)"
    else
        expected=$(expected_digest "$name")
        if [ -z "$expected" ]; then
            rm -f "$tmp"
            fail "no pinned digest for $name; refusing to install it"
        fi
        actual=$(file_digest "$tmp")
        if [ -z "$actual" ]; then
            rm -f "$tmp"
            fail "no sha256 tool available (install coreutils or openssl-tool) — cannot verify $name"
        fi
        if [ "$actual" != "$expected" ]; then
            rm -f "$tmp"
            fail "digest mismatch for $name
  expected $expected
  got      $actual
Refusing to install. Either the pinned ref ($TEMPLATES_REF) does not match this
script's digest table, or the download was tampered with."
        fi
    fi

    backup_existing "$dest"
    mv "$tmp" "$dest"
    log "  installed $dest"
}

# fetch_once <relative-name> <destination> — for files that become the user's
# after the first install: copied when missing, never replaced afterwards.
fetch_once() {
    if [ -e "$2" ]; then
        log "  kept existing $2 (yours to edit; delete it and re-run to refresh)"
    else
        fetch "$1" "$2"
    fi
}

ask_yn() {
    prompt="$1"
    default="${2:-y}"
    printf '%s [%s] ' "$prompt" "$([ "$default" = y ] && echo Y/n || echo y/N)"
    read -r answer || answer=""
    [ -n "$answer" ] || answer="$default"
    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

# ----------------------------------------------------------------------------
# Packages
# ----------------------------------------------------------------------------

install_packages() {
    log ""
    log "== Packages =="
    # Everything the shipped configs actually use, and nothing else:
    #   fish + oh-my-posh   the shell and prompt
    #   zoxide, eza         cd/ls upgrades wired into config.fish
    #   yazi                the `y` file-manager helper
    #   neovim              default $EDITOR in the config
    #   git, curl           used by this script and the prompt's git segment
    packages="fish oh-my-posh zoxide eza yazi neovim git curl"

    if command -v pacman >/dev/null 2>&1; then
        log "Using pacman."
        # shellcheck disable=SC2086
        pacman -S --needed --noconfirm $packages || warn "some packages failed to install"
    elif command -v pkg >/dev/null 2>&1; then
        log "Using pkg."
        # shellcheck disable=SC2086
        pkg install -y $packages || warn "some packages failed to install"
    else
        fail "no supported package manager found (pkg or pacman)"
    fi
}

# ----------------------------------------------------------------------------
# Shell configs
# ----------------------------------------------------------------------------

install_shell_configs() {
    log ""
    log "== Fish + Oh My Posh configs =="
    fetch config.fish "$FISH_CONFIG"
    fetch_once conf.d-personal.fish "$(dirname "$FISH_CONFIG")/conf.d/personal.fish"
    fetch aliens-material.omp.json "$OMP_DIR/aliens-material.omp.json"
    fetch termux-launcher.omp.json "$OMP_DIR/termux-launcher.omp.json"

    fetch setup-nvim "$HOME/.local/bin/setup-nvim"
    chmod +x "$HOME/.local/bin/setup-nvim"
    log "Neovim: run 'setup-nvim' when you want to pick a distro (AstroNvim,"
    log "NvChad, LazyVim, kickstart, or stock); it never runs automatically."

    if command -v fish >/dev/null 2>&1; then
        if command -v chsh >/dev/null 2>&1 && ask_yn "Make fish the default shell?"; then
            chsh -s fish || warn "chsh failed; run 'chsh -s fish' manually"
        fi
    else
        warn "fish is not installed; the config will wait for it"
    fi
}

# ----------------------------------------------------------------------------
# Terminal configs (~/.termux)
# ----------------------------------------------------------------------------

install_terminal_configs() {
    log ""
    log "== Terminal configs (~/.termux) =="

    if ask_yn "Install termux.properties (extra keys with launcher tools, escape back key, underline cursor)?"; then
        fetch termux.properties "$TERMUX_DIR/termux.properties"
    fi

    if ask_yn "Install the custom in-app keyboard layout (fn layer, swipe tools on space)?" n; then
        fetch keyboard-layout.xml "$TERMUX_DIR/keyboard/layout.xml"
    fi

    log "Key bindings: the app refreshes a pristine, fully commented"
    log "termux-launcher-bindings.conf example at every start under"
    log "~/.termux/launcher/examples/ — copy it to ~/.termux to customize."

    if command -v termux-reload-settings >/dev/null 2>&1; then
        termux-reload-settings || true
    fi
}

# ----------------------------------------------------------------------------
# Menu
# ----------------------------------------------------------------------------

welcome() {
    cat <<'EOF'
Termux Launcher setup
=====================

  1) Everything below
  2) Packages + fish/Oh My Posh shell configs
  3) Terminal configs (~/.termux: properties, keyboard layout)
  q) Quit

Fonts (ligatures + Nerd Font icons) are installed from the in-app font
picker: Settings > Terminal > Font.

Every existing config gets a timestamped .bak before being replaced.
EOF
}

main() {
    require_cmd curl
    welcome
    printf 'Choice [1]: '
    read -r choice || choice=1
    [ -n "$choice" ] || choice=1

    case "$choice" in
        1)
            install_packages
            install_shell_configs
            install_terminal_configs
            ;;
        2)
            install_packages
            install_shell_configs
            ;;
        3)
            install_terminal_configs
            ;;
        q|Q)
            exit 0
            ;;
        *)
            fail "unknown choice: $choice"
            ;;
    esac

    log ""
    log "Done. Open a new session (or run 'exec fish') to pick everything up."
}

main "$@"
