#!/system/bin/sh
# setup-launcher — Termux Launcher shell environment installer.
#
# Three choices: everything, the shell essentials, or one item at a time.
# Nothing here is required — the launcher works out of the box, and this only
# installs the shell setup the screenshots were taken with.
#
#   Shell        fish, Oh My Posh with the wallpaper Material palette, zoxide, eza
#   Editor       neovim + AstroNvim, themed from the same palette
#   Showcase     sigye, the animated-logo fastfetch, kitten
#
# ~/.termux is not touched. The app seeds termux.properties,
# termux-launcher-bindings.conf and fonts.conf itself — only when they are
# absent — and ships the extra keys row and the in-app keyboard layout as
# built-in defaults. Rewriting termux.properties from a script would discard the
# extra-keys row the in-app editor writes into it.
#
# Fonts are not handled here either: the in-app font picker (Settings >
# Terminal > Font) downloads and wires up curated families, Nerd Font builds
# included.
#
# tmux, btop, and Shizuku are gone from this setup. The old installer that
# handled them is kept as docs/en/examples/setup-tmux-btop for existing users,
# but it is deprecated: the launcher's own windows, panes, workspaces, and
# status bar replace what tmux and btop provided.
#
# The fish config is split in two: config.fish is launcher-owned and replaced on
# every run (with a .bak), while ~/.config/fish/conf.d/personal.fish is yours —
# installed once, never overwritten, and the place for aliases, EDITOR, and
# other personal settings.
#
# Existing files are never overwritten silently — every replaced config gets a
# timestamped .bak alongside it.

# Every file this script installs is fetched from a pinned release tag and checked
# against a digest table below before it is allowed anywhere near your shell.
# Two of them — config.fish and setup-nvim — run code on every session, so a
# mutable branch and an unverified download would mean the repository (or anything
# that can answer for it) gets to choose what your shell executes forever after.
# The showcase binaries get the same treatment, and are skipped rather than
# installed unverified when a release has not published them.
#
# Maintainers: after editing any template, run
#   docs/en/examples/update-setup-launcher-digests.sh [dir-with-built-binaries]
# and commit the refreshed tables, then move TEMPLATES_REF to the release tag.

set -eu

TEMPLATES_REF="${TERMUX_LAUNCHER_REF:-v0.2.35}"
RAW_BASE="${TERMUX_LAUNCHER_RAW_BASE:-https://raw.githubusercontent.com/PickleHik3/termux-launcher/$TEMPLATES_REF/docs/en/examples}"
BINARIES_BASE="${TERMUX_LAUNCHER_BINARIES_BASE:-https://github.com/PickleHik3/termux-launcher/releases/download/$TEMPLATES_REF}"

# --- BEGIN DIGESTS (generated: update-setup-launcher-digests.sh) ---
expected_digest() {
    case "$1" in
        aliens-material.omp.json) echo 87ce6bfdb16335fc543d3c974f19632503f0e803de73e728de8a265ac03da148 ;;
        conf.d-personal.fish)     echo 6f7b666475e07ee0447fbdba29485a8681f1f622e7c0ab3f98f3ff15b0142190 ;;
        config.fish)              echo 9e977847efd4410075282d686441faa4bb9524e2eb5aecbb3031317d5b857de0 ;;
        setup-nvim)               echo 345c79f048d4bf26dc5de7022443a470fb55266cb945367d383b2123049fa400 ;;
        *) echo "" ;;
    esac
}
# --- END DIGESTS ---

# --- BEGIN BINARY DIGESTS (generated: update-setup-launcher-digests.sh) ---
expected_binary_digest() {
    case "$1" in
        *) echo "" ;;
    esac
}
# --- END BINARY DIGESTS ---

FISH_CONFIG="${FISH_CONFIG:-$HOME/.config/fish/config.fish}"
OMP_DIR="${OMP_DIR:-$HOME/.config/ohmyposh}"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"

log() { printf '%s\n' "$*"; }
warn() { printf 'setup-launcher: %s\n' "$*" >&2; }
fail() { warn "$*"; exit 1; }

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

timestamp() { date +%Y%m%d-%H%M%S; }

backup_existing() {
    target="$1"
    if [ -e "$target" ]; then
        backup="$target.bak-$(timestamp)"
        cp -a "$target" "$backup"
        log "  existing $(basename "$target") backed up to $(basename "$backup")"
    fi
}

file_digest() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        echo ""
    fi
}

# download <url> <destination> <expected-sha256>
download() {
    url="$1"
    dest="$2"
    expected="$3"
    dest_dir=$(dirname "$dest")
    mkdir -p "$dest_dir"
    tmp="$dest_dir/.$(basename "$dest").download"
    if ! curl -fsSL -o "$tmp" "$url"; then
        rm -f "$tmp"
        fail "download failed: $url"
    fi

    if [ "${TERMUX_LAUNCHER_SKIP_DIGEST:-0}" = 1 ]; then
        warn "digest check skipped for $(basename "$dest") (TERMUX_LAUNCHER_SKIP_DIGEST=1)"
    else
        actual=$(file_digest "$tmp")
        if [ -z "$actual" ]; then
            rm -f "$tmp"
            fail "no sha256 tool available (install coreutils or openssl-tool) — cannot verify $url"
        fi
        if [ "$actual" != "$expected" ]; then
            rm -f "$tmp"
            fail "digest mismatch for $url
  expected $expected
  got      $actual
Refusing to install. Either the pinned ref ($TEMPLATES_REF) does not match this
script's digest table, or the download was tampered with."
        fi
    fi

    backup_existing "$dest"
    mv "$tmp" "$dest"
    log "  installed $dest"
}

# fetch <template-name> <destination>
fetch() {
    expected=$(expected_digest "$1")
    [ -n "$expected" ] || fail "no pinned digest for $1; refusing to install it"
    download "$RAW_BASE/$1" "$2" "$expected"
}

# fetch_once <template-name> <destination> — for files that become the user's
# after the first install: copied when missing, never replaced afterwards.
fetch_once() {
    if [ -e "$2" ]; then
        log "  kept existing $2 (yours to edit; delete it and re-run to refresh)"
    else
        fetch "$1" "$2"
    fi
}

# fetch_binary <name> — a release asset into ~/.local/bin, or a clear skip.
fetch_binary() {
    name="$1"
    expected=$(expected_binary_digest "$name")
    if [ -z "$expected" ]; then
        warn "$name is not published for $TEMPLATES_REF — skipping it.
  Build it yourself with recipes/cross/build-$name.sh (see docs/en/Building_Terminal_Showcase_Tools.md)."
        return 0
    fi
    download "$BINARIES_BASE/$name-aarch64" "$BIN_DIR/$name" "$expected"
    chmod +x "$BIN_DIR/$name"
}

ask_yn() {
    prompt="$1"
    default="${2:-y}"
    printf '%s [%s] ' "$prompt" "$([ "$default" = y ] && echo Y/n || echo y/N)"
    read -r answer || answer=""
    [ -n "$answer" ] || answer="$default"
    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

install_pkg() {
    if command -v pacman >/dev/null 2>&1; then
        # shellcheck disable=SC2068
        pacman -S --needed --noconfirm $@ || warn "could not install: $*"
    elif command -v pkg >/dev/null 2>&1; then
        # shellcheck disable=SC2068
        pkg install -y $@ || warn "could not install: $*"
    else
        fail "no supported package manager found (pkg or pacman)"
    fi
}

# ----------------------------------------------------------------------------
# Items
# ----------------------------------------------------------------------------

item_fish() {
    log ""
    log "== fish =="
    install_pkg fish
    fetch config.fish "$FISH_CONFIG"
    fetch_once conf.d-personal.fish "$(dirname "$FISH_CONFIG")/conf.d/personal.fish"
    if command -v fish >/dev/null 2>&1 && command -v chsh >/dev/null 2>&1; then
        if ask_yn "Make fish the default shell?"; then
            chsh -s fish || warn "chsh failed; run 'chsh -s fish' manually"
        fi
    fi
}

item_ohmyposh() {
    log ""
    log "== Oh My Posh =="
    install_pkg oh-my-posh
    fetch aliens-material.omp.json "$OMP_DIR/aliens-material.omp.json"
    log "  the theme follows ~/.termux/material-colors.sh, so it retints with the wallpaper"
}

item_zoxide() {
    log ""
    log "== zoxide =="
    install_pkg zoxide
}

item_eza() {
    log ""
    log "== eza =="
    install_pkg eza
}

item_neovim() {
    log ""
    log "== Neovim + AstroNvim =="
    install_pkg neovim git
    fetch setup-nvim "$BIN_DIR/setup-nvim"
    chmod +x "$BIN_DIR/setup-nvim"
    # setup-nvim never replaces an existing config without an explicit REPLACE,
    # so this is safe to run unattended.
    "$BIN_DIR/setup-nvim" --distro astronvim --yes || warn "setup-nvim did not finish; run it yourself"
}

item_sigye()     { log ""; log "== sigye =="; fetch_binary sigye; }
item_fastfetch() { log ""; log "== fastfetch (animated Kitty logo) =="; fetch_binary fastfetch; }
item_kitten()    { log ""; log "== kitten (kitty's client) =="; fetch_binary kitten; }

install_all() {
    item_fish
    item_ohmyposh
    item_zoxide
    item_eza
    item_neovim
    item_sigye
    item_fastfetch
    item_kitten
}

install_essentials() {
    item_fish
    item_ohmyposh
    item_zoxide
    item_eza
}

install_individually() {
    ask_yn "fish + the launcher's config.fish?"        && item_fish
    ask_yn "Oh My Posh + the Material theme?"          && item_ohmyposh
    ask_yn "zoxide?"                                   && item_zoxide
    ask_yn "eza?"                                      && item_eza
    ask_yn "Neovim + AstroNvim (Material theme)?"      && item_neovim
    ask_yn "sigye (clock)?"                        n   && item_sigye
    ask_yn "fastfetch with the animated logo?"     n   && item_fastfetch
    ask_yn "kitten (kitty's client binary)?"       n   && item_kitten
    return 0
}

# ----------------------------------------------------------------------------
# Menu
# ----------------------------------------------------------------------------

welcome() {
    cat <<'EOF'
Termux Launcher setup
=====================

  1) All — fish, Oh My Posh, zoxide, eza, Neovim + AstroNvim, sigye,
     fastfetch with the animated logo, kitten
  2) Shell essentials — fish, Oh My Posh, zoxide, eza
  3) Pick items one at a time
  q) Quit

Every existing config gets a timestamped .bak before being replaced.
EOF
}

main() {
    require_cmd curl
    mkdir -p "$BIN_DIR"
    welcome
    printf 'Choice [1]: '
    read -r choice || choice=1
    [ -n "$choice" ] || choice=1

    case "$choice" in
        1) install_all ;;
        2) install_essentials ;;
        3) install_individually ;;
        q|Q) exit 0 ;;
        *) fail "unknown choice: $choice" ;;
    esac

    log ""
    log "Done. Open a new session (or run 'exec fish') to pick everything up."
}

main "$@"
