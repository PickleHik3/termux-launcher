+bool ai_bridge_init(void)
+{
+    pthread_mutex_lock(&g_lock);
+    if (!g_curl_ready)
+        g_curl_ready = curl_global_init(CURL_GLOBAL_DEFAULT) == CURLE_OK;
+    bool ready = g_curl_ready;
+    pthread_mutex_unlock(&g_lock);
+    return ready;
+}
