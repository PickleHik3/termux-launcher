+#elif defined(__ANDROID__)
+// Termux: there is no X11 selection and no clipboard device inside the app sandbox, so both
+// directions go through the terminal itself with OSC 52. Termux Launcher answers the read query;
+// a terminal that ignores it stays silent and the paste comes back empty rather than hanging.
+
+static const char DAWN_OSC52_B64[]
+    = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static void posix_clipboard_copy(const char* text, size_t len)
+{
+    size_t b64_len = 0;
+    char* b64 = term_base64_encode((const uint8_t*)text, len, &b64_len);
+    if (!b64)
+        return;
+
+    query_write("\x1b]52;c;", 7);
+    query_write(b64, b64_len);
+    query_write("\x1b\\", 2);
+    free(b64);
+}
+
+static char* osc52_decode(const char* in, size_t* out_len)
+{
+    size_t in_len = strlen(in);
+    char* out = malloc(in_len / 4 * 3 + 4);
+    if (!out)
+        return NULL;
+
+    uint32_t acc = 0;
+    int32_t bits = 0;
+    size_t n = 0;
+    for (size_t i = 0; i < in_len; i++) {
+        const char* slot = memchr(DAWN_OSC52_B64, in[i], sizeof(DAWN_OSC52_B64) - 1);
+        if (!slot)
+            continue;
+        acc = (acc << 6) | (uint32_t)(slot - DAWN_OSC52_B64);
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            out[n++] = (char)((acc >> bits) & 0xff);
+        }
+    }
+    out[n] = '\0';
+    *out_len = n;
+    return out;
+}
+
+static char* posix_clipboard_paste(size_t* out_len)
+{
+    *out_len = 0;
+
+    // The whole reply has to leave the stream, however long it is, or its tail would arrive
+    // later as keystrokes and be typed into the document.
+    const size_t reply_limit = 1u << 20;
+    size_t cap = 4096;
+    size_t len = 0;
+    char* raw = malloc(cap);
+    if (!raw)
+        return NULL;
+
+    drain_input();
+    query_write("\x1b]52;c;?\x1b\\", 9);
+
+    int32_t fd = get_query_read_fd();
+    struct timeval tv = { 0, 200000 };
+    fd_set fds;
+    while (1) {
+        FD_ZERO(&fds);
+        FD_SET(fd, &fds);
+        if (select(fd + 1, &fds, NULL, NULL, &tv) <= 0)
+            break;
+
+        char c;
+        if (read(fd, &c, 1) != 1)
+            break;
+
+        tv.tv_sec = 0;
+        tv.tv_usec = 20000;
+
+        if (c == '\a')
+            break;
+        if (len + 2 > cap && cap < reply_limit) {
+            char* bigger = realloc(raw, cap * 2);
+            if (!bigger)
+                break;
+            raw = bigger;
+            cap *= 2;
+        }
+        if (len + 2 <= cap)
+            raw[len++] = c;
+        if (len >= 2 && raw[len - 2] == '\x1b' && c == '\\') {
+            len -= 2;
+            break;
+        }
+    }
+    raw[len] = '\0';
+
+    char* body = strstr(raw, "]52;");
+    if (!body) {
+        free(raw);
+        return NULL;
+    }
+    char* semi = strchr(body + 4, ';');
+    if (!semi) {
+        free(raw);
+        return NULL;
+    }
+
+    char* result = osc52_decode(semi + 1, out_len);
+    free(raw);
+    if (result && *out_len == 0) {
+        free(result);
+        return NULL;
+    }
+    return result;
+}
+
 #else
 // Linux fallback using xclip/xsel
 static void posix_clipboard_copy(const char* text, size_t len)
