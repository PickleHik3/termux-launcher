+static uint32_t getFrameDelayMs(const Image* image) {
+    if (image->delay == 0) {
+        return 40;
+    }
+
+    if (image->ticks_per_second > 0) {
+        uint64_t delay = (uint64_t) image->delay * 1000 / (uint64_t) image->ticks_per_second;
+        return delay > UINT32_MAX ? UINT32_MAX : (uint32_t) delay;
+    }
+
+    return (uint32_t) image->delay * 10;
+}
+
+static bool printImageKitty(FFLogoRequestData* requestData, const ImageData* imageData, const FFIMData* imData) {
+    FF_STRBUF_AUTO_DESTROY result = ffStrbufCreate();
+    Image* frame = imageData->image;
+    uint32_t frameIndex = 0;
+    uint32_t firstFrameDelay = 40;
+    bool allCompressed = true;
+
+    while (frame) {
+        Image* resized = imData->resizeFunc(frame, requestData->logoPixelWidth, requestData->logoPixelHeight, imageData->exceptionInfo);
+        if (resized == nullptr) {
+            return false;
+        }
+
+        uint32_t frameDelay = getFrameDelayMs(frame);
+        bool compressed = false;
+        bool appended = appendImageKitty(&result, requestData, imageData, resized, frameIndex > 0, frameDelay, &compressed);
+        imageData->ffDestroyImage(resized);
+        if (!appended) {
+            return false;
+        }
+
+        allCompressed = allCompressed && compressed;
+        if (frameIndex == 0) {
+            firstFrameDelay = frameDelay;
+        }
+
+        ++frameIndex;
+        frame = frame->next;
+    }
+
+    if (frameIndex > 1) {
+        // The base frame has no delay by default. Set it explicitly, then let the
+        // terminal loop the uploaded frames after fastfetch has exited.
+        ffStrbufAppendF(&result, "\033_Ga=a,I=1,q=2,r=1,z=%u\033\\", firstFrameDelay);
+        ffStrbufAppendS(&result, "\033_Ga=a,I=1,q=2,s=3,v=1\033\\");
+    }
+
+    printImagePixels(requestData, &result, allCompressed ? FF_CACHE_FILE_KITTY_COMPRESSED : FF_CACHE_FILE_KITTY_UNCOMPRESSED);
+    return true;
+}
