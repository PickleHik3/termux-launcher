+static void appendKittyPlaceholderRow(FFstrbuf* result, uint32_t row, uint32_t columns) {
+    ffStrbufAppendF(result, "\e[38;2;%u;%u;%um",
+        (unsigned) ((FF_KITTY_IMAGE_ID >> 16) & 0xFF),
+        (unsigned) ((FF_KITTY_IMAGE_ID >> 8) & 0xFF),
+        (unsigned) (FF_KITTY_IMAGE_ID & 0xFF));
+    for (uint32_t column = 0; column < columns; ++column) {
+        ffStrbufAppendUtf32CodePoint(result, 0x10EEEEu);
+        ffStrbufAppendUtf32CodePoint(result, kittyRowColumnDiacritics[row]);
+        ffStrbufAppendUtf32CodePoint(result, kittyRowColumnDiacritics[column]);
+    }
+    ffStrbufAppendS(result, "\e[39m");
+}
+
+// Print the grid that references the transmitted image, one image row per terminal line. It ends
+// on the image's last row, which is where a cursor-moving graphics command would have left the
+// cursor, so the callers' existing cursor arithmetic still holds. The grid is printed rather than
+// stored in the transmission cache so that changing a padding does not replay a stale layout.
+static void printKittyPlaceholders(uint32_t characterWidth, uint32_t characterHeight) {
+    const FFOptionsLogo* options = &instance.config.logo;
+    uint32_t limit = (uint32_t) (sizeof(kittyRowColumnDiacritics) / sizeof(*kittyRowColumnDiacritics));
+    uint32_t columns = characterWidth < limit ? characterWidth : limit;
+    uint32_t rows = characterHeight < limit ? characterHeight : limit;
+
+    FF_STRBUF_AUTO_DESTROY result = ffStrbufCreateA(rows * (columns * 12 + 64));
+    for (uint32_t row = 0; row < rows; ++row) {
+        if (row > 0) {
+            ffStrbufAppendC(&result, '\n');
+            if (options->position == FF_LOGO_POSITION_RIGHT) {
+                ffStrbufAppendF(&result, "\e[9999999C\e[%uD", (unsigned) (options->paddingRight + columns));
+            } else if (options->paddingLeft) {
+                ffStrbufAppendF(&result, "\e[%uC", (unsigned) options->paddingLeft);
+            }
+        }
+        appendKittyPlaceholderRow(&result, row, columns);
+    }
+    fflush(stdout);
+    ffWriteFDBuffer(FFUnixFD2NativeFD(STDOUT_FILENO), &result);
+}
