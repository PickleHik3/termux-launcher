<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shape tokens: the Material 3 corner scale, one ShapeAppearance each. The theme points
         shapeAppearanceCorner{ExtraSmall,Small,Medium,Large,ExtraLarge,Full} at these. -->
    <style name="ShapeAppearance.Termux.Corner.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/termux_corner_extra_small</item>
    </style>
    <style name="ShapeAppearance.Termux.Corner.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/termux_corner_small</item>
    </style>
    <style name="ShapeAppearance.Termux.Corner.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/termux_corner_medium</item>
    </style>
    <style name="ShapeAppearance.Termux.Corner.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/termux_corner_large</item>
    </style>
    <style name="ShapeAppearance.Termux.Corner.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/termux_corner_extra_large</item>
    </style>
    <style name="ShapeAppearance.Termux.Corner.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Sheet shape: ExtraLarge on the top corners only. -->
    <style name="ShapeAppearance.Termux.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/termux_corner_extra_large</item>
        <item name="cornerSizeTopRight">@dimen/termux_corner_extra_large</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Cards: Large corners; Outlined is the default materialCardViewStyle. -->
    <style name="Widget.Termux.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>
    <style name="Widget.Termux.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearance">?attr/shapeAppearanceCornerLarge</item>
    </style>

    <!-- Modal sheets: ExtraLarge top corners, via bottomSheetDialogTheme and bottomSheetStyle. -->
    <style name="Widget.Termux.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Termux.BottomSheet</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>
    <style name="ThemeOverlay.Termux.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Termux.BottomSheet.Modal</item>
    </style>

    <!-- sliderStyle: the stock Material 3 slider with the floating value label off (every slider
         row prints its own value beside the control). -->
    <style name="Widget.Termux.Slider" parent="Widget.Material3.Slider">
        <item name="labelBehavior">gone</item>
    </style>

    <!-- BaseToolbar Title text appearance. -->
    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.Material3.TitleLarge"/>

    <!-- BaseToolbar Subtitle text appearance. -->
    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.Material3.BodyMedium"/>

    <!--
     BaseDialog Title Panel materialAlertDialogTitlePanelStyle. No background of its own any more
     (it used to be a red panel); the Material 3 dialog surface shows through.
     https://github.com/material-components/material-components-android/blob/1.4.0/lib/java/com/google/android/material/dialog/res/layout/mtrl_alert_dialog_title.xml#L29
     https://github.com/material-components/material-components-android/blob/1.4.0/lib/java/com/google/android/material/dialog/res/values/themes.xml#L71
    -->
    <style name="BaseDialog.Title.Panel" parent="@style/MaterialAlertDialog.Material3.Title.Panel"/>

    <!--
     BaseDialog Message Text materialAlertDialogBodyTextStyle: on-surface-variant, as an M3 dialog's
     supporting text.
     https://github.com/material-components/material-components-android/blob/1.4.0/lib/java/com/google/android/material/dialog/res/layout/mtrl_alert_dialog.xml#L59
    -->
    <style name="BaseDialog.Message.Text.Dark" parent="@style/MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorLink">?attr/colorPrimary</item>
    </style>
</resources>
