#!/data/data/com.termux/files/usr/bin/sh
set -eu

print_help() {
  cat <<'EOF'
LauncherCtl CLI - local API client for Termux:Launcher Shizuku integration

Usage:
  launcherctl [command] [args]
  launcherctl help [command]

Commands:
  status                    Get backend/API status.
  capabilities              Get launcher capabilities and hardware support.
  tools                     Get launcher agent tool schemas.
  apps                      List launchable app activities.
  launch <query>            Launch an app by label, package, or activity.
  resources                 Get system resource snapshot.
  media                     Get now-playing media info.
  art                       Get current media artwork metadata.
  notifications             Get active notifications snapshot.
  notifications recent [limit]
                            Recent notification events (default limit 50).
  notifications since <epoch-ms> [limit]
                            Notification events since timestamp.
  notifications search <text>
                            Search notification events.
  notifications stats       Notification event statistics.
  notifications pin-rules   List status-bar notification pin rules.
  notifications pin-add [--clear] [package] [match...]
                            Pin notifications matching a package and/or substring.
  notifications pin-remove <id>
                            Remove a pin rule by id.
  agent [--dry-run] <request>
                            Route a request through the agent (dry-run only routes).
  mcp                       Run MCP stdio server backed by LauncherCtl tools.
  events tail [limit]       Tail recent agent/system events (default 100).
  restart                   Restart the launcher through authenticated API.
  update-scripts            Refresh Termux Launcher shell helper scripts.
  tty-doctor                Validate local rish setup and print fixes.
  token rotate              Rotate LauncherCtl API auth token.
  client-config <client>    Generate config for aichat, opencode, crush,
                            codex, or ollama.

Examples:
  launcherctl status
  launcherctl apps
  launcherctl launch whatsapp
  launcherctl agent "open maps"
  launcherctl agent --dry-run "turn on bluetooth"
  launcherctl mcp
  launcherctl events tail 20
  launcherctl update-scripts
  launcherctl restart
  launcherctl tty-doctor
  launcherctl client-config aichat
  tai status

Config files:
  ~/.launcherctl/endpoint   Base URL (for example http://127.0.0.1:40851)
  ~/.launcherctl/token      Bearer token used by this client
EOF
}

print_update_scripts_help() {
  cat <<'EOF'
Usage:
  launcherctl update-scripts

Description:
  Refreshes Termux Launcher shell helper scripts without rerunning Getting Started.
  Existing files are backed up before replacement.

Updated files:
  ~/.local/bin/launcher-system-monitor
  ~/.local/bin/launcher-weather-widget
  ~/.local/bin/kew-tmux-status
  ~/.local/bin/kew-now-playing
  ~/setup-btop-rish
  ~/setup-tmux-btop
  ~/.tmux/material-theme.tmux

Environment:
  TERMUX_LAUNCHER_RAW_BASE  Override examples raw URL.
  TERMUX_LAUNCHER_RAW_ROOT  Override repository raw URL.

Notes:
  - ~/.tmux.conf is not overwritten.
  - rish-backed status fallback is supported, but launcherctl resources is more efficient.
EOF
}

print_tty_doctor_help() {
  cat <<'EOF'
Usage:
  launcherctl tty-doctor

Description:
  Checks ~/.rish/rish setup and prints exact remediation commands.
EOF
}

update_scripts() {
  case "${1:-}" in
    -h|--help|help)
      print_update_scripts_help
      return 0
      ;;
    "")
      ;;
    *)
      echo "usage: launcherctl update-scripts" >&2
      return 2
      ;;
  esac

  command -v curl >/dev/null 2>&1 || {
    echo "launcherctl update-scripts: missing required command: curl" >&2
    echo "install it with: pkg install curl" >&2
    return 1
  }

  raw_root="${TERMUX_LAUNCHER_RAW_ROOT:-https://raw.githubusercontent.com/PickleHik3/termux-launcher/main}"
  raw_base="${TERMUX_LAUNCHER_RAW_BASE:-$raw_root/docs/en/examples}"
  stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null || date +%s)"
  tmp_dir="${TMPDIR:-$HOME/.tmp}/launcherctl-update-scripts.$$"
  mkdir -p "$tmp_dir" || return 1
  trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

  update_one() {
    url="$1"
    dest="$2"
    mode="$3"
    syntax="${4:-sh}"
    tmp="$tmp_dir/$(basename "$dest")"

    printf 'Fetching %s\n' "$url"
    if ! curl -fsSL "$url" -o "$tmp"; then
      echo "launcherctl update-scripts: download failed: $url" >&2
      return 1
    fi

    case "$syntax" in
      sh)
        sh -n "$tmp" || {
          echo "launcherctl update-scripts: shell syntax check failed: $url" >&2
          return 1
        }
        ;;
      bash)
        if command -v bash >/dev/null 2>&1; then
          bash -n "$tmp" || {
            echo "launcherctl update-scripts: bash syntax check failed: $url" >&2
            return 1
          }
        fi
        ;;
      none)
        ;;
      python)
        if command -v python3 >/dev/null 2>&1; then
          python3 -m py_compile "$tmp" || {
            echo "launcherctl update-scripts: python syntax check failed: $url" >&2
            return 1
          }
        fi
        ;;
    esac

    mkdir -p "$(dirname "$dest")" || return 1
    if [ -e "$dest" ]; then
      cp -p "$dest" "$dest.backup.$stamp" || return 1
    fi
    mv "$tmp" "$dest" || return 1
    chmod "$mode" "$dest" || return 1
    printf 'Updated %s\n' "$dest"
  }

  update_one "$raw_base/launcher-system-monitor" "$HOME/.local/bin/launcher-system-monitor" 700 sh
  update_one "$raw_base/launcher-weather-widget" "$HOME/.local/bin/launcher-weather-widget" 700 sh
  update_one "$raw_base/kew-tmux-status" "$HOME/.local/bin/kew-tmux-status" 700 sh
  update_one "$raw_root/resources/scripts/statusbar/kew-now-playing" "$HOME/.local/bin/kew-now-playing" 700 bash
  update_one "$raw_root/resources/bin/tai" "$PREFIX/bin/tai" 700 sh
  update_one "$raw_root/resources/bin/launcherctl-mcp" "$PREFIX/bin/launcherctl-mcp" 700 python
  update_one "$raw_base/setup-btop-rish" "$HOME/setup-btop-rish" 700 sh
  update_one "$raw_base/setup-tmux-btop" "$HOME/setup-tmux-btop" 700 sh
  update_one "$raw_base/material-theme.tmux" "$HOME/.tmux/material-theme.tmux" 700 sh

  cat <<'EOF'
Shell helper scripts are up to date.
Note: ~/.tmux.conf was not changed. Reload tmux if it is already running:
  tmux source-file ~/.tmux.conf
EOF
}

cmd="${1:-status}"

case "$cmd" in
  -h|--help|help)
    sub="${2:-}"
    case "$sub" in
      ""|all)
        print_help
        ;;
      tty-doctor)
        print_tty_doctor_help
        ;;
      update-scripts)
        print_update_scripts_help
        ;;
      *)
        echo "launcherctl: unknown help topic: $sub" >&2
        print_help >&2
        exit 2
        ;;
    esac
    exit 0
    ;;
  update-scripts)
    shift || true
    update_scripts "$@"
    exit $?
    ;;
esac

if [ "$cmd" = "mcp" ]; then
  shift || true
  if ! command -v python3 >/dev/null 2>&1; then
    echo "launcherctl mcp: missing required command: python3" >&2
    echo "install it with: pkg install python" >&2
    exit 1
  fi
  if command -v launcherctl-mcp >/dev/null 2>&1; then
    exec launcherctl-mcp "$@"
  fi
  script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  if [ -x "$script_dir/launcherctl-mcp" ]; then
    exec "$script_dir/launcherctl-mcp" "$@"
  fi
  echo "launcherctl mcp: missing launcherctl-mcp helper" >&2
  echo "install it with: launcherctl update-scripts" >&2
  exit 1
fi

LAUNCHERCTL_DIR="$HOME/.launcherctl"
TOKEN_FILE="$LAUNCHERCTL_DIR/token"
ENDPOINT_FILE="$LAUNCHERCTL_DIR/endpoint"
if [ ! -r "$TOKEN_FILE" ] || [ ! -r "$ENDPOINT_FILE" ]; then
  echo "launcherctl: missing $TOKEN_FILE or $ENDPOINT_FILE" >&2
  echo "run: launcherctl --help" >&2
  exit 1
fi

TOKEN=$(cat "$TOKEN_FILE")
BASE=$(sed -n '1p' "$ENDPOINT_FILE")
CURL_COMMON="-fsS --connect-timeout 2 --max-time 10"
shift || true

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
post_json() {
  path="$1"
  data="$2"
  curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data "$data" "$BASE$path"
}
RISH_DIR="$HOME/.rish"
RISH_BIN="$RISH_DIR/rish"
RISH_DEX="$RISH_DIR/rish_shizuku.dex"

sdk_int() {
  getprop ro.build.version.sdk 2>/dev/null || echo 0
}

tty_doctor() {
  ok=1
  echo "LauncherCtl tty-doctor"
  echo "  rish dir: $RISH_DIR"
  if [ -x "$RISH_BIN" ]; then
    echo "  rish: ok ($RISH_BIN)"
  else
    echo "  rish: missing or not executable ($RISH_BIN)"
    ok=0
  fi
  if [ -f "$RISH_DEX" ]; then
    echo "  dex: ok ($RISH_DEX)"
  else
    echo "  dex: missing ($RISH_DEX)"
    ok=0
  fi
  sdk="$(sdk_int)"
  if [ "$sdk" -ge 34 ] && [ -f "$RISH_DEX" ] && [ -w "$RISH_DEX" ]; then
    echo "  dex perms: not compatible on Android 14+ (dex is writable)"
    ok=0
  fi
  if [ "$ok" -eq 1 ]; then
    echo "  status: healthy"
    return 0
  fi
  cat <<'EOF'

Suggested fix commands:
  mkdir -p ~/.rish
  cp ~/files/.rish/rish ~/.rish/
  cp ~/files/.rish/rish_shizuku.dex ~/.rish/
  chmod 700 ~/.rish/rish
  chmod 400 ~/.rish/rish_shizuku.dex

Then run:
  launcherctl tty-doctor
EOF
  return 1
}

client_config() {
  client="${1:-}"
  case "$client" in
    aichat|opencode|crush|codex|ollama) ;;
    *) echo "usage: launcherctl client-config {aichat|opencode|crush|codex|ollama}" >&2; return 2 ;;
  esac
  command -v jq >/dev/null 2>&1 || {
    echo "launcherctl client-config: install jq with: pkg install jq" >&2
    return 1
  }
  models=$(curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/models")
  tool_model=$(printf '%s' "$models" | jq -r '[.data[] | select(._capabilities | index("tool_use"))][0].id // .data[0].id // empty')
  [ -n "$tool_model" ] || { echo "launcherctl client-config: no installed chat models" >&2; return 1; }
  case "$client" in
    codex)
      cat <<EOF
# Add to ~/.codex/config.toml
model = "$tool_model"
model_provider = "termux_launcher"

[model_providers.termux_launcher]
name = "Termux Launcher"
base_url = "$BASE/v1"
env_key = "LAUNCHERCTL_TOKEN"
wire_api = "responses"

# export LAUNCHERCTL_TOKEN="\$(cat ~/.launcherctl/token)"
EOF
      ;;
    opencode)
      printf '%s' "$models" | jq --arg base "$BASE/v1" '
        {"$schema":"https://opencode.ai/config.json",provider:{"termux-launcher":{
          npm:"@ai-sdk/openai-compatible",name:"Termux Launcher",
          options:{baseURL:$base,apiKey:"{env:LAUNCHERCTL_TOKEN}"},
          models:(.data | map(select(._capabilities | index("text_chat"))) |
            map((([._default_max_output_tokens, ((._endpoint_context_window / 4) | floor)] | min)) as $output |
              {key:.id,value:{
                name:(._display_name // .id),
                tool_call:(((._capabilities | index("tool_use")) != null) and (._tool_mode == "native") and (._endpoint_context_window >= 16384)),
                attachment:(((._capabilities | index("image_input")) != null) or ((._capabilities | index("audio_input")) != null)),
                limit:{context:._endpoint_context_window,input:(._endpoint_context_window - $output),output:$output},
                modalities:{input:(["text"] + (if (._capabilities | index("image_input")) != null then ["image"] else [] end) + (if (._capabilities | index("audio_input")) != null then ["audio"] else [] end)),output:["text"]}
              }}) | from_entries)}}}'
      ;;
    crush)
      printf '%s' "$models" | jq --arg base "$BASE/v1" '
        {"$schema":"https://charm.land/crush.json",providers:{"termux-launcher":{
          type:"openai-compat",name:"Termux Launcher",base_url:$base,api_key:"$LAUNCHERCTL_TOKEN",
          models:(.data | map(select(._capabilities | index("text_chat"))) | map({id:.id,name:(._display_name // .id),
            context_window:._endpoint_context_window,default_max_tokens:._default_max_output_tokens,
            supports_attachments:((._capabilities | index("image_input")) != null)}))}}}'
      ;;
    aichat)
      echo 'clients:'
      echo '  - type: openai-compatible'
      echo '    name: termux-launcher'
      echo "    api_base: $BASE/v1"
      echo '    api_key: ${LAUNCHERCTL_TOKEN}'
      echo '    models:'
      printf '%s' "$models" | jq -r '.data[] | select(._capabilities | index("text_chat")) |
        "      - name: \(.id)\n        max_input_tokens: \(._endpoint_context_window)\n        supports_vision: \((._capabilities | index("image_input")) != null)\n        supports_function_calling: \((._capabilities | index("tool_use")) != null)"'
      ;;
    ollama)
      cat <<EOF
export OLLAMA_HOST="$BASE"
export OLLAMA_API_KEY="\$(cat ~/.launcherctl/token)"
# Clients must send Authorization: Bearer \$OLLAMA_API_KEY.
EOF
      ;;
  esac
}

case "$cmd" in
  status)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/status"
    ;;
  capabilities)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/launcher/capabilities"
    ;;
  tools)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/agent/tools"
    ;;
  apps)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/apps"
    ;;
  launch)
    [ "$#" -gt 0 ] || { echo "usage: launcherctl launch <app name or package>" >&2; exit 2; }
    CMD_ESCAPED=$(json_escape "$*")
    curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \
      --data "{\"query\":\"$CMD_ESCAPED\"}" "$BASE/v1/apps/launch"
    ;;
  resources)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/system/resources"
    ;;
  media)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/media/now-playing"
    ;;
  art)
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/media/art"
    ;;
  notifications)
    sub="${1:-}"
    [ -n "$sub" ] && shift || true
    case "$sub" in
      ""|active)
        curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/notifications"
        ;;
    recent)
      limit="${1:-50}"
      [ "$limit" -ge 1 ] 2>/dev/null || { echo "usage: launcherctl notifications recent [limit]" >&2; exit 2; }
      post_json /v1/notifications/recent "{\"limit\":$limit}"
      ;;
    since)
      [ "$#" -gt 0 ] || { echo "usage: launcherctl notifications since <epoch-ms> [limit]" >&2; exit 2; }
      since="$1"; shift || true
      limit="${1:-200}"
      [ "$since" -ge 0 ] 2>/dev/null || { echo "usage: launcherctl notifications since <epoch-ms> [limit]" >&2; exit 2; }
      [ "$limit" -ge 1 ] 2>/dev/null || { echo "usage: launcherctl notifications since <epoch-ms> [limit]" >&2; exit 2; }
      post_json /v1/notifications/since "{\"since\":$since,\"limit\":$limit}"
      ;;
    search)
      [ "$#" -gt 0 ] || { echo "usage: launcherctl notifications search <text>" >&2; exit 2; }
      query="$*"
      post_json /v1/notifications/search "{\"query\":\"$(json_escape "$query")\"}"
      ;;
      stats)
        post_json /v1/notifications/stats "{}"
        ;;
      pin-rules)
        curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE/v1/notifications/pin-rules"
        ;;
      pin-add)
        clear="false"
        if [ "$#" -gt 0 ] && [ "$1" = "--clear" ]; then
          clear="true"; shift || true
        fi
        pkg="${1:-}"
        [ "$#" -gt 0 ] && shift || true
        match="$*"
        if [ -z "$pkg" ] && [ -z "$match" ]; then
          echo "usage: launcherctl notifications pin-add [--clear] [package] [match...]" >&2
          exit 2
        fi
        post_json /v1/notifications/pin-rules/add \
          "{\"package\":\"$(json_escape "$pkg")\",\"match\":\"$(json_escape "$match")\",\"clear\":$clear}"
        ;;
      pin-remove)
        [ "$#" -gt 0 ] || { echo "usage: launcherctl notifications pin-remove <id>" >&2; exit 2; }
        post_json /v1/notifications/pin-rules/remove "{\"id\":\"$(json_escape "$1")\"}"
        ;;
      *)
        echo "launcherctl: unknown notifications subcommand: $sub" >&2
        echo "usage: launcherctl notifications {active|recent|since|search|stats|pin-rules|pin-add|pin-remove}" >&2
        exit 2
        ;;
    esac
    ;;
  agent)
    dry_run="false"
    if [ "$#" -gt 0 ] && [ "$1" = "--dry-run" ]; then
      dry_run="true"
      shift || true
    fi
    [ "$#" -gt 0 ] || { echo "usage: launcherctl agent [--dry-run] <request>" >&2; exit 2; }
    REQUEST_ESCAPED=$(json_escape "$*")
    route_json=$(post_json /v1/agent/route "{\"request\":\"$REQUEST_ESCAPED\"}")
    printf '%s\n' "$route_json"
    if [ "$dry_run" = "true" ]; then
      exit 0
    fi
    if ! command -v jq >/dev/null 2>&1; then
      echo
      echo "launcherctl agent: non-dry-run requires jq to parse route output" >&2
      echo "install it with: pkg install jq" >&2
      echo "or use: launcherctl agent --dry-run \"$*\"" >&2
      exit 1
    fi
    tool=$(printf '%s' "$route_json" | jq -r '.tool // empty')
    arguments=$(printf '%s' "$route_json" | jq -c '.arguments // {}')
    if [ -z "$tool" ]; then
      echo "launcherctl agent: route did not return a tool" >&2
      exit 1
    fi
    echo
    post_json /v1/agent/execute "{\"tool\":\"$tool\",\"arguments\":$arguments,\"confirm\":true}"
    ;;
  mcp)
    echo "launcherctl mcp: internal dispatch error" >&2
    exit 1
    ;;
  events)
    sub="${1:-}"
    [ -n "$sub" ] && shift || true
    case "$sub" in
      tail)
        limit="${1:-100}"
        [ "$limit" -ge 1 ] 2>/dev/null || { echo "usage: launcherctl events tail [limit]" >&2; exit 2; }
        post_json /v1/events/tail "{\"limit\":$limit}"
        ;;
      *)
        echo "launcherctl: unknown events subcommand: $sub" >&2
        echo "usage: launcherctl events tail" >&2
        exit 2
        ;;
    esac
    ;;
  restart)
    curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" "$BASE/v1/app/restart"
    ;;
  update-scripts)
    update_scripts "$@"
    ;;
  tty-doctor)
    tty_doctor
    ;;
  token)
    sub="${1:-}"; shift || true
    [ "$sub" = "rotate" ] || { echo "usage: launcherctl token rotate" >&2; exit 2; }
    curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" "$BASE/v1/auth/rotate"
    ;;
  client-config)
    client_config "$@"
    ;;
  *)
    echo "launcherctl: unknown command: $cmd" >&2
    echo "run: launcherctl --help" >&2
    exit 2
    ;;
esac
