#!/data/data/com.termux/files/usr/bin/sh
set -eu
print_help() {
  cat <<'EOF'
TAI / Termux AI - local multi-backend model host

Usage:
  tai --json <command>
  tai status
  tai runtime
  tai models
  tai import <path> [model-id]
  tai download <model-id> <https-url> --accept-terms
  tai downloads
  tai download-pause <model-id>
  tai download-resume <model-id>
  tai download-now <model-id>
  tai download-cancel <model-id>
  tai delete <model-id>
  tai preflight [model] [--auto|--cpu|--gpu]
  tai load [model] [--auto|--cpu|--gpu] [--fresh]
  tai unload
  tai keep-warm [model] [--minutes N] [--auto|--cpu|--gpu]
  tai cancel
  tai benchmark [model...] [--preset quick|standard|thorough] [--cpu|--gpu] [--eagle] [--force]
  tai benchmark --results | --clear [model] | --skip-wait
  tai benchmark --native [model] [--gpu|--cpu] [--prefill N] [--decode N] [--runs N] [--force]
  tai transcribe <file.wav> [--model id] [--language xx] [--prompt "words"]
  tai speak [--voice Bruno|Hugo|Jasper|Rosie] [--speed N] [--out file.wav] [text]
  tai speak --stop
  tai doctor

TAI is authenticated through ~/.launcherctl and runs native AI in the isolated :tai_runtime process.
LiteRT-LM and MNN load in :tai_runtime after ABI/API/library/model/memory preflight.
MNN models route through the bundled MNN backend when supported by the installed APK.
GGUF/raw weight files are not supported by this APK.
Auto tries the GPU first and the CPU after a recorded GPU failure. Every load is sized to the memory
free at that moment: the context window shrinks to fit (down to 4096 tokens), and a load that
cannot fit is refused rather than started.
--fresh on tai load throws away the model's MNN mmap weight cache before loading, so it is
rebuilt from scratch instead of reused; use it if a loaded MNN model starts giving degenerate
replies (repeated characters, whatever the sampling settings).
tai benchmark runs bench v1 on each model, timed the same way for LiteRT-LM and MNN: a cold
load, then reading (prompt tok/s over a fixed passage), first word (time to first token),
writing (decode tok/s over 128 tokens) and three check questions with known answers. Standard
runs each test three times on the CPU and on the GPU where the model supports it; quick runs
once on the processor an automatic load would pick; thorough adds a 90 s sustained run. Each
load goes through the usual preflight and memory budget, and a refusal skips that entry with
the reason. Results are kept in files/tai/benchmarks.json: --results prints the leaderboard,
--clear removes them (for one model when named). Chat requests are refused while a benchmark
runs; tai cancel stops it, keeping the phases that finished. A run refuses to start below 30%
battery (unless charging) or above LIGHT thermal status; while running, battery below 15% (and
not charging) or SEVERE+ thermal stops it, and MODERATE thermal pauses it until it recovers.
--force skips the start check only. A later model waits out a cool-down against the run's
starting thermal reading before it loads; --skip-wait ends that wait at once and marks the
next result "warm start". --native runs LiteRT-LM's own benchmark() instead (256 prefill/256
decode tokens, 3 runs; LiteRT-LM models only), the call Google AI Edge Gallery's Benchmark
screen uses, for comparing numbers with it.
tai transcribe runs the speech model voice input uses (Keyboard settings > Voice input > Speech
model) on a WAV file (16 kHz mono PCM16 preferred; other rates are resampled) or raw PCM16
16 kHz mono, on the CPU in :tai_runtime, never queued behind a chat generation. --prompt
gives Whisper a vocabulary line to bias towards (Parakeet has no prompt); --language forces
an ISO 639-1 code on multilingual Whisper models (the -en models always decode English,
Parakeet detects the language itself).
tai speak reads text aloud on the phone with the voice model (Model centre > Speech > Voice
output): the text from the command line or stdin, the voice and speed from the options or
TAI settings. Speech starts after the first sentence; Ctrl-C or tai speak --stop stops it.
--out file.wav saves the audio instead of playing it.
OpenAI-compatible endpoints (default bind mode is localhost):
  /v1/models
  /v1/chat/completions
  /v1/completions
  /v1/embeddings
  /v1/tokenize
  /v1/audio/transcriptions
  /v1/audio/speech
Ollama-compatible endpoints: /api/tags /api/chat /api/generate /api/embed /api/embeddings /api/show /api/ps /api/version

Point OpenAI-compatible terminal tools at this host, e.g.:
  export OPENAI_BASE_URL=http://127.0.0.1:<port>/v1
  export OPENAI_API_KEY=<your-token>
The actual token is stored at ~/.launcherctl/token (do not echo it into shell history).
If token authentication is disabled in settings, any placeholder API key works on localhost.

Security notes:
  LAN mode (opt-in via settings) exposes the API to your local network and always requires the token.
  /v1/embeddings is model-capability dependent. Not all models support embeddings.
  /v1/embeddings accepts input_type ("query" or "document", default "document"), an
  optional document title, dimensions (Matryoshka truncation) and encoding_format ("float"
  or "base64"). Each returned item reports tokens and truncated. /v1/tokenize returns
  {tokens: n} for {model, input} using the same tokenizer, with no task prefix applied.
  /v1/audio/speech speaks with the installed voice model: input, voice, speed, response_format wav|pcm.
  Check /v1/models for capability metadata (for example, _backend and _capabilities per model).

Use tai --json <command> for raw API JSON.
EOF
}
LAUNCHERCTL_DIR="$HOME/.launcherctl"
TOKEN_FILE="$LAUNCHERCTL_DIR/token"
ENDPOINT_FILE="$LAUNCHERCTL_DIR/endpoint"
if [ ! -r "$TOKEN_FILE" ] || [ ! -r "$ENDPOINT_FILE" ]; then
  echo "tai: missing $TOKEN_FILE or $ENDPOINT_FILE; start Termux Launcher first" >&2
  exit 1
fi
TOKEN=$(cat "$TOKEN_FILE")
BASE=$(sed -n '1p' "$ENDPOINT_FILE")
CURL_COMMON="--fail-with-body -sS --connect-timeout 2 --max-time 180"
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
post_json() {
  path="$1"
  data="$2"
  if [ "$OUTPUT_MODE" = "text" ]; then
    curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -H "X-TAI-Output: text" --data "$data" "$BASE$path"
  else
    curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data "$data" "$BASE$path"
  fi
}
get_json() {
  path="$1"
  if [ "$OUTPUT_MODE" = "text" ]; then
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" -H "X-TAI-Output: text" "$BASE$path"
  else
    curl $CURL_COMMON -H "Authorization: Bearer $TOKEN" "$BASE$path"
  fi
}
CURL_LONG="--fail-with-body -sS --connect-timeout 2 --max-time 1200"
post_json_long() {
  path="$1"
  data="$2"
  if [ "$OUTPUT_MODE" = "text" ]; then
    curl $CURL_LONG -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -H "X-TAI-Output: text" --data "$data" "$BASE$path"
  else
    curl $CURL_LONG -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" --data "$data" "$BASE$path"
  fi
}
OUTPUT_MODE=text
case "${1:-}" in
  --json|-j)
    OUTPUT_MODE=json
    shift || true
    ;;
esac
cmd="${1:-status}"
shift || true
case "$cmd" in
  -h|--help|help)
    print_help
    ;;
  status)
    get_json /v1/ai/status
    ;;
  runtime)
    get_json /v1/ai/runtime
    ;;
  models)
    get_json /v1/ai/models
    ;;
  import)
    [ "$#" -gt 0 ] || { echo "usage: tai import <path> [model-id]" >&2; exit 2; }
    path=$(json_escape "$1")
    model="${2:-}"
    if [ -n "$model" ]; then model=$(json_escape "$model"); post_json /v1/ai/models/import "{\"path\":\"$path\",\"modelId\":\"$model\"}"; else post_json /v1/ai/models/import "{\"path\":\"$path\"}"; fi
    ;;
  download)
    [ "$#" -ge 3 ] || { echo "usage: tai download <model-id> <https-url> --accept-terms" >&2; exit 2; }
    model=$(json_escape "$1")
    url=$(json_escape "$2")
    [ "${3:-}" = "--accept-terms" ] || { echo "tai download: pass --accept-terms after reviewing the provider license/terms" >&2; exit 2; }
    post_json /v1/ai/models/download "{\"modelId\":\"$model\",\"url\":\"$url\",\"acceptedTerms\":true}"
    ;;
  downloads)
    get_json /v1/ai/models/downloads
    ;;
  download-cancel)
    [ "$#" -gt 0 ] || { echo "usage: tai download-cancel <model-id>" >&2; exit 2; }
    model=$(json_escape "$1")
    post_json /v1/ai/models/downloads/cancel "{\"modelId\":\"$model\"}"
    ;;
  download-pause)
    [ "$#" -gt 0 ] || { echo "usage: tai download-pause <model-id>" >&2; exit 2; }
    model=$(json_escape "$1")
    post_json /v1/ai/models/downloads/pause "{\"modelId\":\"$model\"}"
    ;;
  download-resume)
    [ "$#" -gt 0 ] || { echo "usage: tai download-resume <model-id>" >&2; exit 2; }
    model=$(json_escape "$1")
    post_json /v1/ai/models/downloads/resume "{\"modelId\":\"$model\"}"
    ;;
  download-now)
    [ "$#" -gt 0 ] || { echo "usage: tai download-now <model-id>" >&2; exit 2; }
    model=$(json_escape "$1")
    post_json /v1/ai/models/downloads/prioritize "{\"modelId\":\"$model\"}"
    ;;
  delete)
    [ "$#" -gt 0 ] || { echo "usage: tai delete <model-id>" >&2; exit 2; }
    model=$(json_escape "$1")
    post_json /v1/ai/models/delete "{\"modelId\":\"$model\",\"confirm\":true}"
    ;;
  preflight)
    model=""
    accelerator=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --auto) accelerator=auto ;;
        --cpu) accelerator=cpu ;;
        --gpu) accelerator=gpu ;;
        --*) echo "usage: tai preflight [model] [--auto|--cpu|--gpu]" >&2; exit 2 ;;
        *) [ -z "$model" ] || { echo "usage: tai preflight [model] [--auto|--cpu|--gpu]" >&2; exit 2; }; model="$1" ;;
      esac
      shift
    done
    accel_json=""
    if [ -n "$accelerator" ]; then accel_json=",\"accelerator\":\"$accelerator\""; fi
    if [ -n "$model" ]; then model_escaped=$(json_escape "$model"); post_json /v1/ai/runtime/preflight "{\"model\":\"$model_escaped\"$accel_json}"; elif [ -n "$accelerator" ]; then post_json /v1/ai/runtime/preflight "{\"accelerator\":\"$accelerator\"}"; else post_json /v1/ai/runtime/preflight '{}'; fi
    ;;
  load)
    model=""
    accelerator=""
    fresh=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --auto) accelerator=auto ;;
        --cpu) accelerator=cpu ;;
        --gpu) accelerator=gpu ;;
        --fresh) fresh=1 ;;
        --*) echo "usage: tai load [model] [--auto|--cpu|--gpu] [--fresh]" >&2; exit 2 ;;
        *) [ -z "$model" ] || { echo "usage: tai load [model] [--auto|--cpu|--gpu] [--fresh]" >&2; exit 2; }; model="$1" ;;
      esac
      shift
    done
    body="{}"
    sep=""
    if [ -n "$model" ]; then model_escaped=$(json_escape "$model"); body="{\"model\":\"$model_escaped\""; sep=","; fi
    if [ -n "$accelerator" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"accelerator\":\"$accelerator\""; sep=","; fi
    if [ -n "$fresh" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body${sep}\"clearCache\":true"; sep=","; fi
    [ "$body" = "{}" ] || body="$body}"
    post_json /v1/ai/runtime/load "$body"
    ;;
  unload)
    post_json /v1/ai/runtime/unload '{}'
    ;;
  keep-warm)
    model=""
    minutes=""
    accelerator=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --minutes) shift; [ "$#" -gt 0 ] || { echo "usage: tai keep-warm [model] [--minutes N] [--auto|--cpu|--gpu]" >&2; exit 2; }; minutes="$1" ;;
        --auto) accelerator=auto ;;
        --cpu) accelerator=cpu ;;
        --gpu) accelerator=gpu ;;
        --*) echo "usage: tai keep-warm [model] [--minutes N] [--auto|--cpu|--gpu]" >&2; exit 2 ;;
        *) [ -z "$model" ] || { echo "usage: tai keep-warm [model] [--minutes N] [--auto|--cpu|--gpu]" >&2; exit 2; }; model="$1" ;;
      esac
      shift
    done
    body="{}"
    sep=""
    if [ -n "$model" ]; then model_escaped=$(json_escape "$model"); body="{\"model\":\"$model_escaped\""; sep=","; fi
    if [ -n "$minutes" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"minutes\":$minutes"; sep=","; fi
    if [ -n "$accelerator" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"accelerator\":\"$accelerator\""; sep=","; fi
    [ "$body" = "{}" ] || body="$body}"
    post_json /v1/ai/runtime/keep-warm "$body"
    ;;
  cancel)
    post_json /v1/ai/runtime/cancel '{}'
    ;;
  benchmark)
    usage_benchmark() { echo "usage: tai benchmark [model...] [--preset quick|standard|thorough] [--cpu|--gpu] [--eagle] [--force] | --results | --clear [model] | --skip-wait | --native [model] [--gpu|--cpu] [--prefill N] [--decode N] [--runs N] [--force]" >&2; exit 2; }
    if [ "${1:-}" = "--native" ]; then
      # The old path: LiteRT-LM's own benchmark(), kept so its numbers can be set against bench v1's.
      shift
      model=""
      accelerator=""
      prefill=""
      decode=""
      runs=""
      force=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --gpu) accelerator=gpu ;;
          --cpu) accelerator=cpu ;;
          --prefill) shift; [ "$#" -gt 0 ] || usage_benchmark; prefill="$1" ;;
          --decode) shift; [ "$#" -gt 0 ] || usage_benchmark; decode="$1" ;;
          --runs) shift; [ "$#" -gt 0 ] || usage_benchmark; runs="$1" ;;
          --force) force=true ;;
          --*) usage_benchmark ;;
          *) [ -z "$model" ] || usage_benchmark; model="$1" ;;
        esac
        shift
      done
      body="{}"
      sep=""
      if [ -n "$model" ]; then model_escaped=$(json_escape "$model"); body="{\"model\":\"$model_escaped\""; sep=","; fi
      if [ -n "$accelerator" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"accelerator\":\"$accelerator\""; sep=","; fi
      if [ -n "$prefill" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"prefillTokens\":$prefill"; sep=","; fi
      if [ -n "$decode" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"decodeTokens\":$decode"; sep=","; fi
      if [ -n "$runs" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"runs\":$runs"; sep=","; fi
      if [ -n "$force" ]; then [ "$body" = "{}" ] && { body="{"; sep=""; }; body="$body$sep\"force\":true"; sep=","; fi
      [ "$body" = "{}" ] || body="$body}"
      post_json_long /v1/ai/runtime/benchmark "$body"
      exit $?
    fi
    models=""
    first_model=""
    preset=""
    processors=""
    eagle=""
    force=""
    results=""
    clear=""
    skip_wait=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --preset) shift; [ "$#" -gt 0 ] || usage_benchmark; preset="$1" ;;
        --quick|--standard|--thorough) preset="${1#--}" ;;
        --cpu) processors="$processors,\"cpu\"" ;;
        --gpu) processors="$processors,\"gpu\"" ;;
        --eagle) eagle=true ;;
        --force) force=true ;;
        --results) results=true ;;
        --clear) clear=true ;;
        --skip-wait) skip_wait=true ;;
        --*) usage_benchmark ;;
        *) model_escaped=$(json_escape "$1"); [ -n "$first_model" ] || first_model="$model_escaped"; models="$models,\"$model_escaped\"" ;;
      esac
      shift
    done
    case "$preset" in ''|quick|standard|thorough) ;; *) usage_benchmark ;; esac
    if [ -n "$results" ]; then
      get_json /v1/ai/benchmarks
      exit $?
    fi
    if [ -n "$clear" ]; then
      if [ -n "$first_model" ]; then body="{\"modelId\":\"$first_model\"}"; else body='{}'; fi
      if [ "$OUTPUT_MODE" = "text" ]; then set -- -H "X-TAI-Output: text"; else set --; fi
      curl $CURL_COMMON -X DELETE -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" "$@" --data "$body" "$BASE/v1/ai/benchmarks"
      exit $?
    fi
    if [ -n "$skip_wait" ]; then
      post_json /v1/ai/benchmarks/skip-wait '{}'
      exit $?
    fi
    body="{\"preset\":\"${preset:-standard}\""
    [ -z "$models" ] || body="$body,\"models\":[${models#,}]"
    [ -z "$processors" ] || body="$body,\"processors\":[${processors#,}]"
    [ -z "$eagle" ] || body="$body,\"eagle\":true"
    [ -z "$force" ] || body="$body,\"force\":true"
    # A thorough run over several models takes a good part of an hour; the stream keeps the
    # connection alive with a line per phase. Ctrl-C stops the runtime too, not just this command.
    CURL_BENCH="--fail-with-body -sS --connect-timeout 2 --max-time 14400"
    trap 'post_json /v1/ai/runtime/cancel "{}" >/dev/null 2>&1; exit 130' INT TERM
    if [ "$OUTPUT_MODE" = "text" ]; then
      body="$body,\"stream\":true}"
      set -- -N -H "X-TAI-Output: text"
    else
      body="$body}"
      set --
    fi
    if curl $CURL_BENCH -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" "$@" --data "$body" "$BASE/v1/ai/benchmarks/run"; then rc=0; else rc=$?; fi
    trap - INT TERM
    exit "$rc"
    ;;
  transcribe)
    file=""
    model=""
    language=""
    prompt=""
    usage_transcribe() { echo "usage: tai transcribe <file.wav> [--model id] [--language xx] [--prompt words]" >&2; exit 2; }
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --model) shift; [ "$#" -gt 0 ] || usage_transcribe; model="$1" ;;
        --language) shift; [ "$#" -gt 0 ] || usage_transcribe; language="$1" ;;
        --prompt) shift; [ "$#" -gt 0 ] || usage_transcribe; prompt="$1" ;;
        --*) usage_transcribe ;;
        *) [ -z "$file" ] || usage_transcribe; file="$1" ;;
      esac
      shift
    done
    [ -n "$file" ] || usage_transcribe
    [ -r "$file" ] || { echo "tai transcribe: cannot read $file" >&2; exit 1; }
    set -- -F "file=@$file"
    [ -z "$model" ] || set -- "$@" -F "model=$model"
    [ -z "$language" ] || set -- "$@" -F "language=$language"
    [ -z "$prompt" ] || set -- "$@" -F "prompt=$prompt"
    if [ "$OUTPUT_MODE" = "text" ]; then set -- "$@" -F "response_format=text" -H "X-TAI-Output: text"; fi
    curl $CURL_COMMON -X POST -H "Authorization: Bearer $TOKEN" "$@" "$BASE/v1/audio/transcriptions"
    ;;
  speak)
    voice=""
    speed=""
    model=""
    out=""
    usage_speak() { echo "usage: tai speak [--voice Bruno|Hugo|Jasper|Rosie] [--speed N] [--out file.wav] [text...]  (reads stdin when no text is given; tai speak --stop stops)" >&2; exit 2; }
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --voice) shift; [ "$#" -gt 0 ] || usage_speak; voice="$1" ;;
        --speed) shift; [ "$#" -gt 0 ] || usage_speak; speed="$1" ;;
        --model) shift; [ "$#" -gt 0 ] || usage_speak; model="$1" ;;
        --out|-o) shift; [ "$#" -gt 0 ] || usage_speak; out="$1" ;;
        --stop) post_json /v1/ai/speak/stop '{}'; exit $? ;;
        --) shift; break ;;
        -*) usage_speak ;;
        *) break ;;
      esac
      shift
    done
    case "$voice$model" in *[!A-Za-z0-9._-]*) echo "tai speak: voice and model are plain names" >&2; exit 2 ;; esac
    case "$speed" in *[!0-9.]*) echo "tai speak: --speed takes a number such as 1.2" >&2; exit 2 ;; esac
    # The text goes up as a plain-text body, so it never has to be escaped into JSON; the options
    # ride as query parameters.
    query=""
    add_query() { if [ -z "$query" ]; then query="?$1"; else query="$query&$1"; fi; }
    [ -z "$voice" ] || add_query "voice=$voice"
    [ -z "$speed" ] || add_query "speed=$speed"
    [ -z "$model" ] || add_query "model=$model"
    [ -z "$out" ] || add_query "format=wav"
    tmp=$(mktemp "${TMPDIR:-$HOME}/tai-speak.XXXXXX") || exit 1
    if [ "$#" -gt 0 ]; then printf '%s' "$*" > "$tmp"; else cat > "$tmp"; fi
    [ -s "$tmp" ] || { rm -f "$tmp"; usage_speak; }
    CURL_SPEAK="--fail-with-body -sS --connect-timeout 2 --max-time 3600"
    if [ -n "$out" ]; then
      if curl $CURL_SPEAK -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: text/plain; charset=utf-8" --data-binary "@$tmp" -o "$out.part" "$BASE/v1/ai/speak$query"; then
        mv -f "$out.part" "$out"
        rm -f "$tmp"
        [ "$OUTPUT_MODE" = "json" ] && printf '{"ok":true,"file":"%s"}\n' "$out" || echo "Saved $out"
        exit 0
      fi
      rc=$?
      cat "$out.part" >&2 2>/dev/null || true
      echo >&2
      rm -f "$out.part" "$tmp"
      exit "$rc"
    fi
    # Ctrl-C stops the voice too, not just this command.
    trap 'post_json /v1/ai/speak/stop "{}" >/dev/null 2>&1; rm -f "$tmp"; exit 130' INT TERM
    if [ "$OUTPUT_MODE" = "text" ]; then set -- -H "X-TAI-Output: text"; else set --; fi
    if curl $CURL_SPEAK -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: text/plain; charset=utf-8" "$@" --data-binary "@$tmp" "$BASE/v1/ai/speak$query"; then rc=0; else rc=$?; fi
    trap - INT TERM
    rm -f "$tmp"
    exit "$rc"
    ;;
  doctor)
    get_json /v1/ai/runtime
    ;;
  *)
    echo "tai: unknown command: $cmd" >&2
    print_help >&2
    exit 2
    ;;
esac
