<?xml version="1.0" encoding="utf-8"?>
<!--
  Space bar swipe slots run launcher actions through `tool:<registry id>[:<glyph>]`. A tool: key
  reaches the same dispatcher as a keybind or a palette row, so any action in the registry can sit
  on any slot with no code change. Override the whole row by writing your own space bar key into
  ~/.termux/keyboard/layout.xml.

  Slots: key1 NW, key2 NE, key3 SW, key4 SE, key5 W, key6 E, key7 N, key8 S.
  North was the keyboard's own layout-switch gesture; the palette takes it, and switch_forward /
  switch_backward stay reachable on the diagonals if you want them back.
-->
<row height="0.95">
  <key width="1.7" role="action" key0="ctrl" key1="loc switch_greekmath" key2="loc meta" key4="switch_numeric"/>
  <key width="1.1" role="action" key0="fn" key1="loc alt" key4="config"/>
  <key width="4.4" role="space_bar" key0="space"
       key7="tool:app.command_palette:⌘"
       key8="switch_backward"
       key5="cursor_left" key6="cursor_right"
       key1="tool:window.previous:◧" key2="tool:window.next:◨"
       key3="tool:session.previous:↰" key4="tool:session.next:↳"/>
  <key width="1.1" role="action" key0="loc compose" key7="up" key6="right" key5="left" key8="down" key1="loc home" key2="loc page_up" key3="loc end" key4="loc page_down"/>
  <key width="1.7" role="action" key0="enter" key2="action"/>
</row>
