<?xml version="1.0" encoding="utf-8"?>
<!--
  Terl's QWERTZ layout (ADR 0042): the letters of latn_qwertz.xml with Terl's corners (Ctrl: Terl key,
  Meta, number pad; Alt: clipboard history, switch keyboard; the space bar keeps its typing gestures; the edit keys
  are south-east swipes on A, X, C and V). Used in place of the launcher layout while the Terl desktop switch
  is on and Settings chose it; no name attribute, so the picker leaves it out.
-->
<keyboard bottom_row="false" script="latin">
  <row>
    <key key0="q" key2="1" key4="loc esc"/>
    <key key0="w" key1="^" key2="2" key3="&quot;" key4="\@"/>
    <key key0="e" key1="§" key2="3" key3="!" key4="€"/>
    <key key0="r" key2="4" key3="$"/>
    <key key0="t" key2="5" key3="%"/>
    <key key0="z" key2="6" key3="&amp;" key4="{"/>
    <key key0="u" key2="7" key3="ü" key4="}"/>
    <key key0="i" key1="(" key2="8" key3="[" key4="]"/>
    <key key0="o" key1=")" key2="9" key3="ö" key4="="/>
    <key key0="p" key2="0" key3="\?"/>
  </row>
  <row>
    <key shift="0.5" key0="a" key1="loc tab" key2="`" key3="ä" key4="selectAll"/>
    <key key0="s" key3="ß"/>
    <key key0="d"/>
    <key key0="f" key1="~"/>
    <key key0="g" key3="-"/>
    <key key0="h" key3="+"/>
    <key key0="j" key3="*"/>
    <key key0="k" key3="/" key4="\\"/>
    <key key0="l" key1="'" key3="\#"/>
  </row>
  <row>
    <key width="1.5" role="action" key0="shift" key2="loc capslock"/>
    <key key0="y" key1="&gt;" key2="|" key3="&lt;"/>
    <key key0="x" key1="loc †" key4="cut"/>
    <key key0="c" key4="copy"/>
    <key key0="v" key4="paste"/>
    <key key0="b" key1=";" key3=","/>
    <key key0="n" key1=":" key3="."/>
    <key key0="m" key1="_" />
    <key width="1.5" role="action" key0="backspace" key2="delete"/>
  </row>
  <row height="0.95">
    <key width="1.7" role="action" c="ctrl" ne="terl" sw="loc meta" se="switch_numeric"/>
    <key width="1.3" role="action" c="loc alt" nw="fn" ne="loc switch_clipboard" sw="loc change_method" se="config"/>
    <key width="4.0" role="space_bar" c="space" split_at="2.5" w="cursor_left" e="cursor_right" s="switch_backward"
         n="tool:app.command_palette:󱎱"/>
    <key width="1.3" role="action" c="loc compose" nw="home" ne="page_up" sw="page_down" se="end" w="left" e="right" n="up" s="down"/>
    <key width="1.7" role="action" c="enter" n="tool:voice.dictate:"/>
  </row>
  <modmap>
    <fn a="q" b="f1"/>
    <fn a="w" b="f2"/>
    <fn a="e" b="f3"/>
    <fn a="r" b="f4"/>
    <fn a="t" b="f5"/>
    <fn a="y" b="f6"/>
    <fn a="u" b="f7"/>
    <fn a="i" b="f8"/>
    <fn a="o" b="f9"/>
    <fn a="p" b="f10"/>
    <fn a="a" b="esc"/>
    <fn a="s" b="tab"/>
    <fn a="d" b="home"/>
    <fn a="f" b="up"/>
    <fn a="g" b="end"/>
    <fn a="h" b="page_up"/>
    <fn a="j" b="left"/>
    <fn a="k" b="down"/>
    <fn a="l" b="right"/>
    <fn a="z" b="f11"/>
    <fn a="x" b="f12"/>
    <fn a="c" b="insert"/>
    <fn a="v" b="delete"/>
    <fn a="b" b="page_down"/>
    <fn a="n" b="^C:ctrl,c"/>
    <fn a="m" b="^D:ctrl,d"/>
  </modmap>
</keyboard>
