+/*
+ * Core glyph cursors have no name, so the server gives them one.
+ *
+ * lorieUpdateCursorName above is the host's only hint that the pointer sits over a text field,
+ * and CursorRec.name is filled by exactly one thing: XFixes' SetCursorName, which libXcursor
+ * calls for cursors it loads from a theme. A client without an Xcursor theme - GTK and Firefox
+ * in a bare Termux prefix - takes the core font cursors instead (XCreateFontCursor, i.e.
+ * CreateGlyphCursor over the "cursor" font), and those reach the host unnamed, so the keyboard
+ * never follows a caret. But the glyph index is the name: glyph N of the cursor font is the
+ * shape XC_<name> == N of X11/cursorfont.h, which is where libXcursor's theme names come from
+ * too. Naming them here gives the host the same "xterm"/"left_ptr" it would get from a themed
+ * client, with no theme installed.
+ *
+ * It wraps the dispatch entry rather than naming the cursor in dix's AllocGlyphCursor because
+ * everything under xserver/ is a pinned freedesktop submodule which CMake already patches on its
+ * own (patches/xserver.patch, applied with `patch -N` at configure time): a hunk of ours in there
+ * would be a second, uncontrolled edit of a tree that is re-fetched on every submodule bump. One
+ * dispatch entry in lorie's own file is the smaller thing to carry.
+ */
+
+// Cursor font shape names, indexed by glyph / 2: XC_X_cursor == 0 ... XC_xterm == 152
+// (X11/cursorfont.h). Odd glyphs are those shapes' masks and name nothing.
+static const char* const lorieCursorShapeNames[] = {
+    "X_cursor", "arrow", "based_arrow_down", "based_arrow_up", "boat", "bogosity",
+    "bottom_left_corner", "bottom_right_corner", "bottom_side", "bottom_tee", "box_spiral",
+    "center_ptr", "circle", "clock", "coffee_mug", "cross", "cross_reverse", "crosshair",
+    "diamond_cross", "dot", "dotbox", "double_arrow", "draft_large", "draft_small", "draped_box",
+    "exchange", "fleur", "gobbler", "gumby", "hand1", "hand2", "heart", "icon", "iron_cross",
+    "left_ptr", "left_side", "left_tee", "leftbutton", "ll_angle", "lr_angle", "man",
+    "middlebutton", "mouse", "pencil", "pirate", "plus", "question_arrow", "right_ptr",
+    "right_side", "right_tee", "rightbutton", "rtl_logo", "sailboat", "sb_down_arrow",
+    "sb_h_double_arrow", "sb_left_arrow", "sb_right_arrow", "sb_up_arrow", "sb_v_double_arrow",
+    "shuttle", "sizing", "spider", "spraycan", "star", "target", "tcross", "top_left_arrow",
+    "top_left_corner", "top_right_corner", "top_side", "top_tee", "trek", "ul_angle", "umbrella",
+    "ur_angle", "watch", "xterm",
+};
+
+/*
+ * The cursor font is the one font of the core protocol with no XLFD name: its FONT property is
+ * the literal "cursor" (xorg-fonts-misc's cursor.pcf.gz). Comparing that property is cheaper
+ * than comparing glyphs, and it keeps a client that draws its own cursors from some other font
+ * out of the table above.
+ */
+static Bool lorieIsCursorFont(FontPtr pFont) {
+    for (int i = 0; i < pFont->info.nprops; i++) {
+        const char* name;
+
+        if (pFont->info.props[i].name != (long) XA_FONT || !pFont->info.isStringProp[i])
+            continue;
+
+        name = ValidAtom((Atom) pFont->info.props[i].value) ? NameForAtom((Atom) pFont->info.props[i].value) : NULL;
+        return name && !strcasecmp(name, "cursor");
+    }
+
+    return FALSE;
+}
+
+static int (*lorieProcCreateGlyphCursorNext)(ClientPtr) = NULL;
+
+static int lorieProcCreateGlyphCursor(ClientPtr client) {
+    REQUEST(xCreateGlyphCursorReq);
+    CursorPtr pCurs;
+    FontPtr pFont;
+    const char* name;
+    unsigned shape;
+    // Upstream first, so the request is length-checked and the cursor exists before we look at
+    // either; `stuff` still points at this request's buffer afterwards.
+    int rc = lorieProcCreateGlyphCursorNext(client);
+
+    if (rc != Success)
+        return rc;
+
+    shape = stuff->sourceChar;
+    if (shape % 2 || shape / 2 >= ARRAY_SIZE(lorieCursorShapeNames))
+        return rc;
+    if (dixLookupResourceByType((void**) &pCurs, stuff->cid, RT_CURSOR, client, DixSetAttrAccess) != Success)
+        return rc;
+    if (ValidAtom(pCurs->name)) // a client that named its own cursor knows better
+        return rc;
+    if (dixLookupResourceByType((void**) &pFont, stuff->source, RT_FONT, client, DixReadAccess) != Success)
+        return rc;
+    if (!lorieIsCursorFont(pFont))
+        return rc;
+
+    name = lorieCursorShapeNames[shape / 2];
+    pCurs->name = MakeAtom(name, strlen(name), TRUE);
+    return rc;
+}
+
+// Called from InitOutput; ProcVector survives a server reset, hence the idempotence check.
+static void lorieNameGlyphCursors(void) {
+    if (ProcVector[X_CreateGlyphCursor] == lorieProcCreateGlyphCursor)
+        return;
+
+    lorieProcCreateGlyphCursorNext = ProcVector[X_CreateGlyphCursor];
+    ProcVector[X_CreateGlyphCursor] = lorieProcCreateGlyphCursor;
+}
