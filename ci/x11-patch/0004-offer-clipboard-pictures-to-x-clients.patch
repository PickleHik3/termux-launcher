+    uint8_t scratch[4096];
+    while (size) {
+        size_t chunk = size < sizeof(scratch) ? size : sizeof(scratch);
+        if (!lorieReadFully(fd, scratch, chunk))
+            return false;
+        size -= chunk;
+    }
+    return true;
