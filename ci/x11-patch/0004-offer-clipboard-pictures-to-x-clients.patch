+// The clipboard picture payloads are far larger than a socket buffer, so one read() may return
+// short; these keep the stream in step whatever the kernel hands back.
+static bool lorieReadFully(int fd, void *buf, size_t size) {
+    auto *p = (uint8_t*) buf;
+    while (size) {
+        ssize_t n = read(fd, p, size);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0)
+            return false;
+        p += n;
+        size -= (size_t) n;
+    }
+    return true;
