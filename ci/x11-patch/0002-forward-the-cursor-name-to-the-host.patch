+/*
+ * Name of the cursor last reported to the activity. Only the X server thread touches it: it is the
+ * thread that calls the sprite funcs below and the one that writes the event socket, the same way
+ * DDXNotifyFocusChanged does, so no locking is needed.
+ */
+static char lorieCursorName[LORIE_CURSOR_NAME_MAX + 1] = {0};
+
+static void lorieUpdateCursorName(CursorPtr pCurs) {
+    const char* name = pCurs && ValidAtom(pCurs->name) ? NameForAtom(pCurs->name) : NULL;
+    char current[sizeof(lorieCursorName)] = {0};
+
+    strncpy(current, name ? name : "", sizeof(current) - 1);
+    if (!strcmp(current, lorieCursorName))
+        return;
+
+    strcpy(lorieCursorName, current);
+    lorieSendCursorName(lorieCursorName);
+}
+
 void lorieActivityConnected(void) {
     pvfb->state->drawRequested = pvfb->state->cursor.updated = true;
     lorieSendSharedServerState(pvfb->stateFd);
+    // The cursor does not change just because an activity attached, so tell it what it is showing.
+    lorieSendCursorName(lorieCursorName);
     lorieRegisterBuffer(LORIE_BUFFER_FROM_PIXMAP(pScreenPtr->devPrivate));
 }
 
