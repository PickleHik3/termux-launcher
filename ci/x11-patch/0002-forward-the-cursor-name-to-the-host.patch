+void lorieSendCursorName(const char* name) {
+    if (conn_fd != -1) {
+        size_t len = strnlen(name, LORIE_CURSOR_NAME_MAX);
+        lorieEvent e = { .cursorName = { .t = EVENT_CURSOR_NAME_CHANGED, .count = (uint32_t) len } };
+        write(conn_fd, &e, sizeof(e));
+        if (len)
+            write(conn_fd, name, len);
+    }
+}
