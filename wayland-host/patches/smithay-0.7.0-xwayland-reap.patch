+    /// Kills Xwayland and waits for it, unless `disconnected` already took it. A compositor that
+    /// stops drops its display without dispatching this client's disconnect, which would leave
+    /// the child a zombie for the life of the process.
+    pub fn reap_child(&self) {
+        let child = self.child.lock().ok().and_then(|mut c| c.take());
+        if let Some(mut child) = child {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+    }
