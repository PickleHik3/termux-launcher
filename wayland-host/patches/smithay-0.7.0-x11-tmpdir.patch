+/// The directory that holds `.X11-unix/` and the `.X<n>-lock` files: `$SMITHAY_X11_TMPDIR`,
+/// else `/tmp`. Android has no `/tmp`; Termux's X clients look under `$PREFIX/tmp`.
+fn x11_tmp_dir() -> String {
+    std::env::var("SMITHAY_X11_TMPDIR").unwrap_or_else(|_| "/tmp".to_string())
+}
