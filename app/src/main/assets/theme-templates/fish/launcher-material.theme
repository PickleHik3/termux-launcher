# name: 'Launcher Material'
#
# Rendered by Termux Launcher - do not edit.
#
# One theme, three sections: fish paints from [light] or [dark] according to
# what the terminal reports its appearance to be, and from [unknown] when the
# terminal says nothing. [unknown] holds whichever palette the launcher last
# rendered for, so a terminal that does not answer still gets the wallpaper's
# colours rather than none.

[dark]
# preferred_background: {{ colors.terminal_background.dark.hex_stripped }}
fish_color_normal {{ colors.terminal_foreground.dark.hex_stripped }}
fish_color_command {{ colors.terminal_normal_blue.dark.hex_stripped }}
fish_color_keyword {{ colors.terminal_normal_magenta.dark.hex_stripped }}
fish_color_quote {{ colors.terminal_normal_green.dark.hex_stripped }}
fish_color_redirection {{ colors.terminal_normal_cyan.dark.hex_stripped }}
fish_color_end {{ colors.terminal_bright_magenta.dark.hex_stripped }}
fish_color_error {{ colors.error.dark.hex_stripped }}
fish_color_param {{ colors.terminal_normal_white.dark.hex_stripped }}
fish_color_option {{ colors.terminal_bright_cyan.dark.hex_stripped }}
fish_color_comment {{ colors.terminal_bright_black.dark.hex_stripped }}
fish_color_operator {{ colors.terminal_normal_yellow.dark.hex_stripped }}
fish_color_escape {{ colors.terminal_bright_magenta.dark.hex_stripped }}
fish_color_autosuggestion {{ colors.outline.dark.hex_stripped }}
fish_color_selection {{ colors.on_surface_variant.dark.hex_stripped }} --background={{ colors.surface_variant.dark.hex_stripped }}
fish_color_search_match --background={{ colors.secondary_container.dark.hex_stripped }}
fish_color_history_current --bold
fish_color_valid_path --underline
fish_color_cancel -r
fish_color_cwd {{ colors.primary.dark.hex_stripped }}
fish_color_cwd_root {{ colors.error.dark.hex_stripped }}
fish_color_user {{ colors.terminal_normal_green.dark.hex_stripped }}
fish_color_host {{ colors.primary.dark.hex_stripped }}
fish_color_host_remote {{ colors.terminal_normal_yellow.dark.hex_stripped }}
fish_color_status {{ colors.error.dark.hex_stripped }}
fish_pager_color_progress {{ colors.on_surface_variant.dark.hex_stripped }} --background={{ colors.surface_container_high.dark.hex_stripped }}
fish_pager_color_prefix {{ colors.primary.dark.hex_stripped }} --bold --underline
fish_pager_color_completion {{ colors.on_surface.dark.hex_stripped }}
fish_pager_color_description {{ colors.outline.dark.hex_stripped }}
fish_pager_color_selected_background --background={{ colors.secondary_container.dark.hex_stripped }}
fish_pager_color_selected_prefix {{ colors.primary.dark.hex_stripped }} --bold
fish_pager_color_selected_completion {{ colors.on_secondary_container.dark.hex_stripped }}
fish_pager_color_selected_description {{ colors.on_secondary_container.dark.hex_stripped }}
fish_pager_color_secondary_background --background={{ colors.surface_container.dark.hex_stripped }}
fish_pager_color_secondary_prefix {{ colors.primary.dark.hex_stripped }}
fish_pager_color_secondary_completion {{ colors.on_surface.dark.hex_stripped }}
fish_pager_color_secondary_description {{ colors.outline.dark.hex_stripped }}

