        { "id": "balanced", "label": "balanced", "uniforms": { "uEnergy": 1.0, "uSaturation": 1.0, "uContrast": 1.0, "uExposure": 1.0 } },
        { "id": "vivid", "label": "vivid", "uniforms": { "uEnergy": 1.35, "uSaturation": 1.28, "uContrast": 1.12, "uExposure": 1.15 } }
      ]
    },
    "tempo": {
      "label": "tempo",
      "words": [
        { "id": "barely", "label": "barely moving", "uniforms": { "uSpeed": 0.3 } },
        { "id": "slow", "label": "moving slowly", "uniforms": { "uSpeed": 1.0 } },
        { "id": "lively", "label": "moving lively", "uniforms": { "uSpeed": 2.2 } }
      ]
    },
    "placement": {
      "label": "placement",
      "words": [
        { "id": "centre", "label": "in the centre", "uniforms": { "uCenter": [0.0, 0.08], "uScale": 0.62, "uMirror": 0, "uScatter": 0 } },
        { "id": "low", "label": "low", "uniforms": { "uCenter": [0.0, -0.72], "uScale": 0.85, "uMirror": 0, "uScatter": 0 } },
        { "id": "corner", "label": "in a corner", "uniforms": { "uCenter": [0.30, -0.70], "uScale": 0.9, "uMirror": 1, "uScatter": 0 } },
        { "id": "scattered", "label": "scattered", "uniforms": { "uCenter": [0.0, 0.0], "uScale": 0.19, "uMirror": 0, "uScatter": 1 } }
      ]
