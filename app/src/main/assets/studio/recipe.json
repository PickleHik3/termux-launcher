{
  "version": 1,
  "comment": "Studio recipe words. Data only: the lab and the app read this one file. A recipe is a family, one word id per slot and a seed. Each word sets the uniforms it lists; the palette sets paletteUniforms from its light or dark version; themeUniform is 1 in dark, 0 in light.",
  "paletteUniforms": {
    "bgTop": "uBgTop",
    "bgBottom": "uBgBottom",
    "inner": "uInner",
    "outer": "uOuter",
    "core": "uCore",
    "rim": "uRim"
  },
  "themeUniform": "uDark",
  "seedUniform": "uSeed",
  "timeUniform": "uTime",
  "resolutionUniform": "uResolution",
  "slots": {
