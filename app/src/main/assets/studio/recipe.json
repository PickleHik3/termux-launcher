    "texture": {
      "label": "texture",
      "words": [
        { "id": "clean", "label": "clean", "uniforms": { "uGrain": 0.0, "uFilm": 0.0 } },
        { "id": "fine-grain", "label": "with fine grain", "uniforms": { "uGrain": 0.035, "uFilm": 0.0 } },
        { "id": "film", "label": "on film", "uniforms": { "uGrain": 0.07, "uFilm": 1.0 } }
      ]
    }
  },
  "families": {
    "bloom": {
      "label": "Bloom",
      "shader": "bloom.agsl",
      "sentence": "A {mood} {material} {form}, {layers} of {petals} petals in {palette}, {tempo}, {placement}, {texture}.",
      "slots": ["mood", "material", "form", "layers", "petals", "palette", "tempo", "placement", "texture"],
      "ownSlots": {
        "form": {
          "label": "form",
          "words": [
            { "id": "flower", "label": "flower", "uniforms": { "uForm": 0 } },
            { "id": "anemone", "label": "anemone", "uniforms": { "uForm": 1 } },
            { "id": "star", "label": "star", "uniforms": { "uForm": 2 } },
            { "id": "shell", "label": "spiral shell", "uniforms": { "uForm": 3 } }
          ]
        },
        "petals": {
          "label": "petals",
          "words": [
            { "id": "three", "label": "three", "uniforms": { "uPetals": 3 } },
            { "id": "four", "label": "four", "uniforms": { "uPetals": 4 } },
            { "id": "five", "label": "five", "uniforms": { "uPetals": 5 } },
            { "id": "six", "label": "six", "uniforms": { "uPetals": 6 } },
            { "id": "seven", "label": "seven", "uniforms": { "uPetals": 7 } },
            { "id": "eight", "label": "eight", "uniforms": { "uPetals": 8 } },
            { "id": "nine", "label": "nine", "uniforms": { "uPetals": 9 } },
            { "id": "ten", "label": "ten", "uniforms": { "uPetals": 10 } },
            { "id": "eleven", "label": "eleven", "uniforms": { "uPetals": 11 } },
            { "id": "twelve", "label": "twelve", "uniforms": { "uPetals": 12 } }
          ]
        },
        "layers": {
          "label": "layers",
          "words": [
            { "id": "one", "label": "a single ring", "uniforms": { "uLayers": 1 } },
            { "id": "two", "label": "two rings", "uniforms": { "uLayers": 2 } },
            { "id": "three", "label": "three rings", "uniforms": { "uLayers": 3 } },
            { "id": "four", "label": "four rings", "uniforms": { "uLayers": 4 } }
          ]
        }
      },
      "materials": ["glass", "frosted", "ink", "glow", "clay"],
      "exclude": [
        { "comment": "Small forms with four rings turn to mush and cost the most.", "when": { "placement": "scattered" }, "deny": { "layers": ["four"] } },
        { "comment": "A three-armed anemone reads as a broken star.", "when": { "form": "anemone" }, "deny": { "petals": ["three"] } }
      ],
      "default": {
        "mood": "quiet", "material": "glass", "form": "flower", "layers": "two", "petals": "six",
        "palette": "dusk", "tempo": "slow", "placement": "low", "texture": "fine-grain", "seed": 1
      }
    }
  }
}
