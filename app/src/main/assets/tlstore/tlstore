#!/system/bin/sh
# written by termux-launcher
# tlstore — the launcher's tool store. Installs, lists, updates and removes the
# tools and configs the launcher shows off but does not ship.
#
# The shebang is /system/bin/sh on purpose: the prefix differs per edition and
# this file is written into it by the app, so it cannot name $PREFIX/bin/sh.
# POSIX sh only (Termux's sh is dash): no locals, no arrays, no [[ ]].
# Functions therefore share one variable namespace — every helper prefixes its
# variables (dl_, bk_, it_, …) so callers and callees cannot clobber each other.
#
# Item definitions come from the catalog: the one shipped in the APK, or a newer
# one refreshed from the repository and verified with minisign.
#
# Env:
#   TLSTORE_PREFIX      install prefix (default $PREFIX) — tests point it at a fake tree
#   TLSTORE_CATALOG_URL where refresh reads the catalog (file:// works)
#   TLSTORE_ASSUME_YES  1 = same as -y
#   TLSTORE_NPM_REGISTRY npm registry base (default https://registry.npmjs.org)
#   TLSTORE_ARCH        override uname -m (tests exercise aarch64 items on a host)
#   TLSTORE_PATCHELF    the patchelf command (tests pass a no-op)
#   TLSTORE_ASSUME_TTY  1 = answer questions from stdin even when it is not a
#                       terminal (the test suite pipes them in)
#   TLSTORE_HOST        launcher|termux — which app the store is running in,
#                       when the detection below should not have the last word
#   TLSTORE_RAW_BASE    the top of the repository a standalone install reads,
#                       the paths below it being the ones in this tree
#                       (default the raw main URL; tests point it at file://)
#   TLSTORE_UI          the tlstore-ui binary bare `tlstore` execs inside the
#                       launcher (default $PREFIX/libexec/termux-launcher/
#                       tlstore/tlstore-ui; tests point it at a fake one, or
#                       one that is not there, to take the other path)
#   TLSTORE_GITHUB      where GitHub is, for an item's README and the pictures
#                       in it: a prefix put in front of the host and path of
#                       every https://…github… address (default none, the real
#                       hosts; tests point it at a file:// tree laid out
#                       <host>/<path>)

set -u

TLSTORE_VERSION=0.4

PREFIX="${TLSTORE_PREFIX:-${PREFIX:-${HOME%/files/home}/files/usr}}"
HOME="${HOME:?tlstore needs HOME}"

# /data/data/<app package>/files/usr — the edition this prefix belongs to.
APP_PACKAGE=""
case "$PREFIX" in
    */files/usr)
        APP_PACKAGE="${PREFIX%/files/usr}"
        APP_PACKAGE="${APP_PACKAGE##*/}"
        ;;
esac

BIN_DIR="$HOME/.local/bin"
LIB_DIR="$HOME/.local/lib"
DATA_DIR="$HOME/.local/share/tlstore"
CACHE_DIR="$HOME/.cache/tlstore"
STORE_DIR="$PREFIX/libexec/termux-launcher/tlstore"
BASE_CATALOG="$STORE_DIR/catalog.tsv"
USER_CATALOG="$DATA_DIR/catalog.tsv"
PUBKEY="$STORE_DIR/trusted.pub"
STATE="$DATA_DIR/installed.tsv"

# The app writes this on every start; a hand install writes the other one, with
# the address it came from inside it.
INSTALLED_MARK="$STORE_DIR/.installed"
STANDALONE_MARK="$STORE_DIR/.standalone"

# Which app the store is running in. The launcher names itself in the
# environment; over ssh nothing does, and then the app's own marker answers.
HOST="${TLSTORE_HOST:-}"
case "$HOST" in
    launcher|termux) ;;
    *)
        if [ "${TERM_PROGRAM:-}" = termux-launcher ]; then
            HOST=launcher
        elif [ -n "${TERM_PROGRAM:-}" ]; then
            HOST=termux
        elif [ -f "$INSTALLED_MARK" ]; then
            HOST=launcher
        else
            HOST=termux
        fi
        ;;
esac

# The launcher's own version, for items that need a recent one. Only the
# launcher sets it, and an item asking for it passes anywhere else.
LAUNCHER_VERSION="${TERM_PROGRAM_VERSION:-}"
[ "$HOST" = launcher ] || LAUNCHER_VERSION=""

CATALOG_URL="${TLSTORE_CATALOG_URL:-https://raw.githubusercontent.com/PickleHik3/termux-launcher/main/app/src/main/assets/tlstore/catalog.tsv}"
NPM_REGISTRY="${TLSTORE_NPM_REGISTRY:-https://registry.npmjs.org}"
PATCHELF="${TLSTORE_PATCHELF:-patchelf}"
TLSTORE_UI_BIN="${TLSTORE_UI:-$STORE_DIR/tlstore-ui}"

LAUNCHER_RAW="https://raw.githubusercontent.com/PickleHik3/termux-launcher"
BINARIES_RAW="https://raw.githubusercontent.com/PickleHik3/termux-launcher-binaries"

# Where an item's own README and its pictures are read from (see cmd_readme).
GITHUB_RAW="https://raw.githubusercontent.com"
GITHUB_MIRROR="${TLSTORE_GITHUB:-}"

# The top of the repository a hand-installed tlstore reads: the address the
# installer wrote down, unless the environment says otherwise. Everything under
# it sits where it sits in this tree.
RAW_BASE="${TLSTORE_RAW_BASE:-}"
if [ -z "$RAW_BASE" ] && [ -f "$STANDALONE_MARK" ]; then
    RAW_BASE=$(head -1 "$STANDALONE_MARK" 2>/dev/null || true)
fi
[ -n "$RAW_BASE" ] || RAW_BASE="$LAUNCHER_RAW/main"
STORE_PATH="app/src/main/assets/tlstore"

ASSUME_YES="${TLSTORE_ASSUME_YES:-0}"
[ "$ASSUME_YES" = 1 ] || ASSUME_YES=0

ASSUME_TTY="${TLSTORE_ASSUME_TTY:-0}"
[ "$ASSUME_TTY" = 1 ] || ASSUME_TTY=0

# -y never answers "replace my config file?"; --configs does, and only that.
REPLACE_CONFIGS=0

# --progress: a machine stream on stdout for install/update/remove, for
# tlstore-ui. It implies -y, and a config file question is always answered by
# keeping the user's file (never replacing it) rather than asking.
PROGRESS=0
PROGRESS_NOTE=""

# Packages this run installed only so something else could be built.
BUILD_ADDED=""

ARCH="${TLSTORE_ARCH:-$(uname -m 2>/dev/null || echo unknown)}"
case "$ARCH" in
    aarch64|arm64) ARCH_OK=1 ;;
    *) ARCH_OK=0 ;;
esac

CATALOG=""
CATALOG_SERIAL=""
CATALOG_FROM=""
FAILED=0

TAB=$(printf '\t')

# What a cancel (SIGTERM to the whole process group — tlstore-ui sends it when
# the person backs out of a running --progress job) has to clean up: the temp
# file the current download is writing (download() keeps this current),
# anywhere else an install leaves a half-built scratch copy before it moves it
# into place (npm-musl's unpack directory), and which item was in flight, so
# the UI still gets a done line for it instead of waiting forever.
CANCEL_TMP=""
CANCEL_EXTRA=""
CANCEL_ITEM=""

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

say() {
    if [ "$PROGRESS" = 1 ]; then
        printf '%s\n' "$*" >&2
    else
        printf '%s\n' "$*"
    fi
}
err() { printf 'tlstore: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

# progress_line <step> <name> <pct> <words> — one line of the --progress
# stream. Always stdout, whether or not PROGRESS is set, since these lines are
# the machine output itself, not incidental narration.
progress_line() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"; }
progress_done() { printf 'done\t%s\t%s\t%s\n' "$1" "$2" "$3"; }

have() { command -v "$1" >/dev/null 2>&1; }

# Runs on SIGTERM (a plain kill or the whole process group tlstore-ui signals
# to cancel a running --progress job): drop whatever the current download had
# not finished writing, drop any other scratch copy an install had not yet
# moved into place, tell the UI the item in flight failed rather than leaving
# it to wait for a line that is never coming, and stop. Nothing already
# recorded in STATE is touched, so an item that finished earlier in this same
# run stays installed.
on_cancel() {
    [ -z "$CANCEL_TMP" ] || rm -f "$CANCEL_TMP"
    for oc_p in $CANCEL_EXTRA; do
        rm -rf "$oc_p"
    done
    if [ "$PROGRESS" = 1 ] && [ -n "$CANCEL_ITEM" ]; then
        progress_done "$CANCEL_ITEM" failed "Cancelled."
    fi
    exit 143
}
trap on_cancel TERM

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------

serial_of() {
    [ -f "$1" ] || return 1
    sed -n 's/^#.*serial=\([0-9][0-9]*\).*$/\1/p' "$1" | head -1
}

# Picks the newer of the refreshed catalog and the one shipped in the app.
pick_catalog() {
    pc_base=$(serial_of "$BASE_CATALOG" 2>/dev/null || true)
    pc_user=$(serial_of "$USER_CATALOG" 2>/dev/null || true)
    CATALOG=""
    if [ -f "$USER_CATALOG" ] && [ -n "$pc_user" ]; then
        if [ -z "$pc_base" ] || [ "$pc_user" -gt "$pc_base" ] 2>/dev/null; then
            CATALOG="$USER_CATALOG"
            CATALOG_SERIAL="$pc_user"
            CATALOG_FROM=refreshed
        fi
    fi
    if [ -z "$CATALOG" ] && [ -f "$BASE_CATALOG" ]; then
        CATALOG="$BASE_CATALOG"
        CATALOG_SERIAL="$pc_base"
        CATALOG_FROM=app
    fi
    [ -n "$CATALOG" ]
}

need_catalog() {
    pick_catalog || die "the list of items is missing — reopen the app to put it back"
}

# Every row that applies here: this edition's prefix, this processor, this app,
# a new enough launcher; first row per name wins.
rows() {
    awk -F "$TAB" -v pkgname="$APP_PACKAGE" -v archok="$ARCH_OK" \
        -v host="$HOST" -v lver="$LAUNCHER_VERSION" '
        function prefix_ok(list,   n, i, parts) {
            if (list == "*" || list == "") return 1
            n = split(list, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] == pkgname) return 1
            return 0
        }
        function arch_ok(kind) {
            if (archok == "1") return 1
            return (kind != "binary" && kind != "npm-musl")
        }
        function optval(list, key,   n, i, parts) {
            n = split(list, parts, ";")
            for (i = 1; i <= n; i++)
                if (index(parts[i], key "=") == 1)
                    return substr(parts[i], length(key) + 2)
            return ""
        }
        function host_ok(list,   want, n, i, parts) {
            want = optval(list, "host")
            if (want == "") return 1
            n = split(want, parts, ",")
            for (i = 1; i <= n; i++) if (parts[i] == host) return 1
            return 0
        }
        function vercmp(a, b,   na, nb, pa, pb, i, n, x, y) {
            na = split(a, pa, /[._-]/)
            nb = split(b, pb, /[._-]/)
            n = (na > nb) ? na : nb
            for (i = 1; i <= n; i++) {
                x = (i <= na) ? pa[i] + 0 : 0
                y = (i <= nb) ? pb[i] + 0 : 0
                if (x > y) return 1
                if (x < y) return -1
            }
            return 0
        }
        function launcher_ok(list,   want) {
            want = optval(list, "min-launcher")
            if (want == "") return 1
            if (lver == "") return 1
            return vercmp(lver, want) >= 0
        }
        /^[ \t]*#/ { next }
        /^[ \t]*$/ { next }
        NF < 10 { next }
        !prefix_ok($4) { next }
        !arch_ok($2) { next }
        !host_ok($9) { next }
        !launcher_ok($9) { next }
        seen[$1]++ { next }
        { print }
    ' "$CATALOG"
}

# The rows a user picks from. The rest are plumbing: parts other items pull in,
# never listed and never installed by name.
visible_rows() {
    rows | awk -F "$TAB" '$9 !~ /(^|;)hidden=1(;|$)/'
}

hidden_item() {
    hi_row=$(row "$1")
    [ -n "$hi_row" ] || return 1
    [ "$(opt "$(field "$hi_row" 9)" hidden)" = 1 ]
}

# row <name> — the row for one item, empty when it has none here.
row() {
    rows | awk -F "$TAB" -v want="$1" '$1 == want { print; exit }'
}

# Loads a row into it_* for the rest of the run.
load_item() {
    it_row=$(row "$1")
    [ -n "$it_row" ] || return 1
    it_name=$(field "$it_row" 1)
    it_kind=$(field "$it_row" 2)
    it_version=$(field "$it_row" 3)
    # shellcheck disable=SC2034  # loaded for completeness; rows() did the matching
    it_prefixes=$(field "$it_row" 4)
    it_source=$(field "$it_row" 5)
    it_digest=$(field "$it_row" 6)
    it_target=$(field "$it_row" 7)
    it_requires=$(field "$it_row" 8)
    it_options=$(field "$it_row" 9)
    it_summary=$(field "$it_row" 10)
    # shellcheck disable=SC2034  # the Revision 5 fields, read out by cmd_info
    it_category=$(field "$it_row" 11)
    it_upstream=$(field "$it_row" 12)
    it_setup=$(field "$it_row" 13)
    it_standfirst=$(field "$it_row" 14)
    it_does1=$(field "$it_row" 15)
    it_does2=$(field "$it_row" 16)
    it_does3=$(field "$it_row" 17)
    it_try=$(field "$it_row" 18)
    it_notes=$(field "$it_row" 19)
    it_author=$(field "$it_row" 20)
    it_licence=$(field "$it_row" 21)
    it_size=$(field "$it_row" 22)
    it_picture=$(field "$it_row" 23)
    it_picture_digest=$(field "$it_row" 24)
    it_demo=$(field "$it_row" 25)
    it_featured=$(field "$it_row" 26)
    # Revision 6: the README sections tlstore-ui leaves out, |-separated. A
    # catalog from before the column has no field 27 at all, which reads as
    # "none" the same way "-" does.
    it_readme_skip=$(field "$it_row" 27)
    [ -n "$it_readme_skip" ] || it_readme_skip="-"
    return 0
}

field() {
    printf '%s\n' "$1" | cut -d "$TAB" -f "$2"
}

# The value of one ;-separated option, empty when unset.
opt() {
    printf '%s' "$1" | tr ';' '\n' | sed -n "s/^$2=//p" | head -1
}

commas() { printf '%s' "$1" | tr ',' ' '; }

# " a  b " → "a, b", for reading out a list of names.
words_list() { printf '%s' "$1" | sed 's/^ *//; s/ *$//; s/  */, /g'; }

# A leading ~ in a target is this user's home, not a shell expansion.
# shellcheck disable=SC2088
expand_path() {
    case "$1" in
        '~'|'~/'*) printf '%s' "$HOME${1#\~}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# The URL a source field points at.
source_url() {
    case "$1" in
        launcher:*)
            su_rest="${1#launcher:}"
            su_path="${su_rest%@*}"
            su_tag="${su_rest##*@}"
            printf '%s/%s/%s' "$LAUNCHER_RAW" "$su_tag" "$su_path"
            ;;
        binaries:*)
            su_rest="${1#binaries:}"
            su_asset="${su_rest%@*}"
            su_tag="${su_rest##*@}"
            printf '%s/%s/bin/%s-aarch64' "$BINARIES_RAW" "$su_tag" "$su_asset"
            ;;
        *) printf '%s' "$1" ;;
    esac
}

# item_targets <name> <kind> <target> [source] — where an item's payload lands,
# space separated; empty for pkg and bundles. An npm-musl item lands twice: the
# directory, then the wrapper, which is named after the executable inside the
# package (claude-code installs the command `claude`). A package that keeps its
# executable in a subdirectory (npm:x#bin/y) still gets the bare name.
item_targets() {
    case "$2" in
        binary|file|file-once)
            if [ "$3" = "-" ] || [ -z "$3" ]; then
                [ "$2" = binary ] || return 0
                printf '%s' "$BIN_DIR/$1"
            else
                expand_path "$3"
            fi
            ;;
        npm-musl)
            it_exe="${4:-}"
            case "$it_exe" in
                *"#"*) it_exe="${it_exe##*#}" ;;
                *) it_exe="$1" ;;
            esac
            it_exe="${it_exe##*/}"
            if [ "$3" = "-" ] || [ -z "$3" ]; then
                printf '%s %s' "$LIB_DIR/$1" "$BIN_DIR/$it_exe"
            else
                printf '%s %s' "$(expand_path "$3")" "$BIN_DIR/$it_exe"
            fi
            ;;
    esac
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------

state_row() {
    [ -f "$STATE" ] || return 1
    awk -F "$TAB" -v want="$1" '/^#/ { next } $1 == want { print; exit }' "$STATE"
}

is_installed() {
    [ -n "$(state_row "$1" 2>/dev/null)" ]
}

installed_version() {
    st_row=$(state_row "$1" 2>/dev/null) || return 1
    [ -n "$st_row" ] || return 1
    field "$st_row" 3
}

installed_names() {
    [ -f "$STATE" ] || return 0
    awk -F "$TAB" '/^#/ { next } NF > 0 { print $1 }' "$STATE"
}

# state_record <name> <kind> <version> <files…>
state_record() {
    sr_name="$1"
    sr_kind="$2"
    sr_version="$3"
    shift 3
    sr_files="$*"
    mkdir -p "$DATA_DIR"
    [ -f "$STATE" ] || printf '# tlstore installed\tname\tkind\tversion\twhen\tfiles\n' > "$STATE"
    sr_tmp="$STATE.new"
    awk -F "$TAB" -v want="$sr_name" '$1 != want' "$STATE" > "$sr_tmp" || return 1
    printf '%s\t%s\t%s\t%s\t%s\n' "$sr_name" "$sr_kind" "$sr_version" "$(timestamp)" "$sr_files" >> "$sr_tmp"
    mv "$sr_tmp" "$STATE"
}

state_forget() {
    [ -f "$STATE" ] || return 0
    sf_tmp="$STATE.new"
    awk -F "$TAB" -v want="$1" '$1 != want' "$STATE" > "$sf_tmp" || return 1
    mv "$sf_tmp" "$STATE"
}

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------

timestamp() { date +%Y%m%d-%H%M%S; }

file_digest() {
    if have sha256sum; then
        sha256sum "$1" | cut -d' ' -f1
    elif have openssl; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        printf ''
    fi
}

backup_existing() {
    bk_target="$1"
    if [ -e "$bk_target" ]; then
        bk_copy="$bk_target.bak-$(timestamp)"
        cp -a "$bk_target" "$bk_copy" || return 1
        say "  kept a copy of $(basename "$bk_target") beside it"
    fi
    return 0
}

# The newest .bak beside a file, put back in its place.
restore_backup() {
    rb_target="$1"
    rb_newest=""
    for rb_f in "$rb_target".bak-*; do
        [ -e "$rb_f" ] || continue
        rb_newest="$rb_f"
    done
    [ -n "$rb_newest" ] || return 1
    mv "$rb_newest" "$rb_target" || return 1
    return 0
}

# download <url> <destination> <sha256 or -> — CANCEL_TMP tracks the part
# file while it is being written, so on_cancel can drop it if a SIGTERM lands
# mid-download; nothing here is left behind once the function returns, either
# way, since every exit path clears it again.
download() {
    dl_url="$1"
    dl_dest="$2"
    dl_expect="$3"
    dl_dir=$(dirname "$dl_dest")
    mkdir -p "$dl_dir" || return 1
    dl_tmp="$dl_dir/.$(basename "$dl_dest").part"
    CANCEL_TMP="$dl_tmp"
    if ! curl -fsSL -o "$dl_tmp" "$dl_url"; then
        rm -f "$dl_tmp"
        CANCEL_TMP=""
        err "could not download $(basename "$dl_dest")"
        return 1
    fi
    if [ "$dl_expect" != "-" ] && [ -n "$dl_expect" ]; then
        dl_actual=$(file_digest "$dl_tmp")
        if [ -z "$dl_actual" ]; then
            rm -f "$dl_tmp"
            CANCEL_TMP=""
            err "cannot check what was downloaded — install coreutils and try again"
            return 1
        fi
        if [ "$dl_actual" != "$dl_expect" ]; then
            rm -f "$dl_tmp"
            CANCEL_TMP=""
            err "$(basename "$dl_dest") does not match what the list expects — nothing was installed"
            return 1
        fi
    fi
    mv "$dl_tmp" "$dl_dest" || { CANCEL_TMP=""; return 1; }
    CANCEL_TMP=""
    return 0
}

# Is someone there to answer a question?
interactive() {
    [ "$ASSUME_TTY" = 1 ] && return 0
    [ -t 0 ]
}

# A full-screen view needs a real terminal at both ends, whatever the knob says.
on_terminal() {
    [ -t 0 ] && [ -t 1 ]
}

# How wide the terminal is; 80 when nothing here will say.
term_cols() {
    tc_n="${COLUMNS:-}"
    case "$tc_n" in
        ''|*[!0-9]*) tc_n="" ;;
    esac
    if [ -z "$tc_n" ] && have tput; then
        tc_n=$(tput cols 2>/dev/null || printf '')
        case "$tc_n" in
            ''|*[!0-9]*) tc_n="" ;;
        esac
    fi
    { [ -n "$tc_n" ] && [ "$tc_n" -gt 0 ]; } || tc_n=80
    printf '%s' "$tc_n"
}

yes_reply() {
    case "$1" in
        y|Y|yes|YES) return 0 ;;
    esac
    return 1
}

# A question that goes ahead unless you say no. -y answers it.
ask_yn() {
    [ "$ASSUME_YES" = 1 ] && return 0
    printf '%s [Y/n] ' "$1"
    read -r ay_answer || ay_answer=""
    [ -n "$ay_answer" ] || ay_answer=y
    yes_reply "$ay_answer"
}

# A question that does nothing unless you say yes. -y answers it; with nobody
# there to ask, the answer is no.
ask_ny() {
    [ "$ASSUME_YES" = 1 ] && return 0
    interactive || return 1
    printf '%s [y/N] ' "$1"
    read -r an_answer || an_answer=""
    yes_reply "$an_answer"
}

# Two files with the same contents.
same_file() {
    if have cmp; then
        cmp -s "$1" "$2"
        return $?
    fi
    sf_a=$(file_digest "$1")
    sf_b=$(file_digest "$2")
    [ -n "$sf_a" ] && [ "$sf_a" = "$sf_b" ]
}

install_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pacman -S --needed --noconfirm $@
    elif have pkg; then
        # shellcheck disable=SC2068
        pkg install -y $@
    else
        err "no package manager here — cannot install $*"
        return 1
    fi
}

upgrade_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pacman -S --needed --noconfirm $@
    elif have apt; then
        # shellcheck disable=SC2068
        apt-get install -y -qq --only-upgrade $@
    elif have pkg; then
        # shellcheck disable=SC2068
        pkg install -y $@
    else
        err "no package manager here — cannot update $*"
        return 1
    fi
}

remove_pkg() {
    if have pacman; then
        # shellcheck disable=SC2068
        pacman -R --noconfirm $@
    elif have apt; then
        # shellcheck disable=SC2068
        apt remove -y $@
    else
        return 1
    fi
}

pkg_present() {
    if have pacman; then
        pacman -Q "$1" >/dev/null 2>&1
    elif have dpkg; then
        dpkg -s "$1" >/dev/null 2>&1
    else
        have "$1"
    fi
}

# ---------------------------------------------------------------------------
# Lists of names (space separated; names are [a-z0-9-]+ so words are safe)
# ---------------------------------------------------------------------------

in_list() {
    case " $1 " in
        *" $2 "*) return 0 ;;
    esac
    return 1
}

# The item and everything it needs, in the order they have to be installed.
plan_for() {
    pf_closure=""
    pf_todo="$*"
    while [ -n "$pf_todo" ]; do
        pf_next=""
        for pf_n in $pf_todo; do
            in_list "$pf_closure" "$pf_n" && continue
            pf_closure="$pf_closure $pf_n"
            pf_deps=$(item_deps "$pf_n")
            pf_next="$pf_next $pf_deps"
        done
        pf_todo="$pf_next"
    done

    pf_plan=""
    pf_left="$pf_closure"
    while [ -n "$pf_left" ]; do
        pf_moved=0
        pf_rest=""
        for pf_n in $pf_left; do
            if deps_ready "$pf_n" "$pf_closure" "$pf_plan"; then
                pf_plan="$pf_plan $pf_n"
                pf_moved=1
            else
                pf_rest="$pf_rest $pf_n"
            fi
        done
        pf_left=$(printf '%s' "$pf_rest" | sed 's/^ *//')
        if [ "$pf_moved" = 0 ]; then
            pf_plan="$pf_plan $pf_left"
            break
        fi
    done
    printf '%s' "$pf_plan" | sed 's/^ *//'
}

# What a name needs installed before it.
item_deps() {
    id_row=$(row "$1")
    [ -n "$id_row" ] || return 0
    id_req=$(commas "$(field "$id_row" 8)")
    [ "$id_req" = "-" ] && id_req=""
    printf '%s' "$id_req"
}

deps_ready() {
    for dr_d in $(item_deps "$1"); do
        in_list "$2" "$dr_d" || continue
        in_list "$3" "$dr_d" || return 1
    done
    return 0
}

# ---------------------------------------------------------------------------
# Tools that are only needed while installing
# ---------------------------------------------------------------------------

# Is this item already here in the version the list offers?
already_here() {
    ah_row=$(row "$1")
    [ -n "$ah_row" ] || return 1
    is_installed "$1" || return 1
    case "$(field "$ah_row" 2)" in
        pkg|bundle|fisher) return 0 ;;
    esac
    [ "$(installed_version "$1")" = "$(field "$ah_row" 3)" ]
}

# build_tools_for <names> <force> — the build= packages the plan will really
# need, each named once. Nothing is fetched for an item that is already here.
build_tools_for() {
    bt_out=""
    for bt_n in $1; do
        bt_row=$(row "$bt_n")
        [ -n "$bt_row" ] || continue
        if [ "$2" = 0 ] && already_here "$bt_n"; then
            continue
        fi
        for bt_p in $(commas "$(opt "$(field "$bt_row" 9)" build)"); do
            [ "$bt_p" = "-" ] && continue
            in_list "$bt_out" "$bt_p" || bt_out="$bt_out $bt_p"
        done
    done
    printf '%s' "$bt_out" | sed 's/^ *//'
}

# Installs the ones that are not here already, remembering which those were so
# they can be offered back afterwards.
# add_build_tools <names> <force>
add_build_tools() {
    ab_missing=""
    for ab_p in $(build_tools_for "$1" "$2"); do
        pkg_present "$ab_p" || ab_missing="$ab_missing $ab_p"
    done
    [ -n "$(printf '%s' "$ab_missing" | tr -d ' ')" ] || return 0
    say "Installing what is needed to build:$ab_missing"
    # shellcheck disable=SC2086
    if ! install_pkg $ab_missing; then
        err "could not install what is needed to build:$ab_missing"
        return 1
    fi
    BUILD_ADDED="$BUILD_ADDED$ab_missing"
    return 0
}

drop_build_tools() {
    db_pkgs=$(printf '%s' "$BUILD_ADDED" | sed 's/^ *//')
    BUILD_ADDED=""
    [ -n "$db_pkgs" ] || return 0
    ask_ny "Remove the tools that were only needed for installing ($(words_list "$db_pkgs"))?" || return 0
    # shellcheck disable=SC2086
    remove_pkg $db_pkgs >/dev/null 2>&1 || true
    rm -rf "${CACHE_DIR:?}"/* 2>/dev/null || true
    say "Removed them, and cleared what was downloaded."
    return 0
}

# ---------------------------------------------------------------------------
# Installing
# ---------------------------------------------------------------------------

install_item() {
    ii_name="$1"
    ii_force="${2:-0}"
    # Something a bundle asks for that has no row here — another edition's
    # build, or an aarch64 tool on a different processor — is skipped, not an
    # error. A name typed on the command line is checked before we get here.
    load_item "$ii_name" || {
        say "$ii_name is not available on this device"
        PROGRESS_NOTE="$ii_name is not available on this device"
        return 0
    }
    ii_kind="$it_kind"
    ii_version="$it_version"
    ii_source="$it_source"
    ii_digest="$it_digest"
    ii_target="$it_target"
    ii_options="$it_options"

    if [ "$ii_force" = 0 ] && already_here "$ii_name"; then
        say "$ii_name is already installed"
        PROGRESS_NOTE="already installed"
        return 0
    fi

    case "$ii_kind" in
        pkg) do_pkg ;;
        binary) do_binary ;;
        file) do_file 0 ;;
        file-once) do_file 1 ;;
        fisher) do_fisher ;;
        npm-musl) do_npm_musl ;;
        bundle) do_bundle ;;
        *) err "$ii_name cannot be installed here"; return 1 ;;
    esac
}

do_pkg() {
    say "installing $ii_name"
    # shellcheck disable=SC2086  # the source column is a list of package names
    if ! install_pkg $ii_source; then
        err "could not install $ii_name"
        return 1
    fi
    state_record "$ii_name" pkg "$ii_version"
    return 0
}

do_binary() {
    db_dest=$(item_targets "$ii_name" binary "$ii_target")
    db_mode=$(opt "$ii_options" mode)
    [ -n "$db_mode" ] || db_mode=755
    say "installing $ii_name"
    mkdir -p "$(dirname "$db_dest")"
    backup_existing "$db_dest"
    download "$(source_url "$ii_source")" "$db_dest" "$ii_digest" || return 1
    chmod "$db_mode" "$db_dest"
    state_record "$ii_name" binary "$ii_version" "$db_dest"
    say "  $db_dest"
    return 0
}

# Shows what would change in a config file and asks. Only --configs answers this
# for you; -y deliberately does not, because a config is the user's own work.
# confirm_replace <name> <current> <new>
confirm_replace() {
    cf_name="$1"
    cf_cur="$2"
    cf_new="$3"
    # --progress never opens a prompt tlstore-ui cannot answer: the user's file
    # is always kept, whatever --configs says.
    [ "$PROGRESS" = 1 ] && return 1
    [ "$REPLACE_CONFIGS" = 1 ] && return 0
    interactive || return 1
    say "$cf_name"
    if have diff; then
        diff -u "$cf_cur" "$cf_new" || true
    else
        say "  before:"
        head -25 "$cf_cur" | sed 's/^/    /'
        say "  after:"
        head -25 "$cf_new" | sed 's/^/    /'
    fi
    printf 'Replace your %s? [y/N] ' "$(basename "$cf_cur")"
    read -r cf_answer || cf_answer=""
    yes_reply "$cf_answer"
}

# do_file <once>
do_file() {
    df_once="$1"
    df_dest=$(item_targets "$ii_name" file "$ii_target")
    if [ -z "$df_dest" ]; then
        err "$ii_name has nowhere to go"
        return 1
    fi
    df_mode=$(opt "$ii_options" mode)
    [ -n "$df_mode" ] || df_mode=644
    if [ "$df_once" = 1 ] && [ -e "$df_dest" ]; then
        say "kept your $(basename "$df_dest") — it is yours to edit"
        PROGRESS_NOTE="kept your $(basename "$df_dest")"
        is_installed "$ii_name" || state_record "$ii_name" file-once "$ii_version"
        return 0
    fi
    # A config file you already have is never replaced without being shown the
    # change first. It is recorded either way, so declining is not asked again
    # until the shipped file itself moves on.
    if [ "$df_once" = 0 ] && [ -e "$df_dest" ]; then
        mkdir -p "$CACHE_DIR"
        df_new="$CACHE_DIR/$ii_name.new"
        download "$(source_url "$ii_source")" "$df_new" "$ii_digest" || return 1
        if same_file "$df_dest" "$df_new"; then
            rm -f "$df_new"
            state_record "$ii_name" file "$ii_version" "$df_dest"
            return 0
        fi
        if ! confirm_replace "$ii_name" "$df_dest" "$df_new"; then
            rm -f "$df_new"
            say "kept your $(basename "$df_dest")"
            PROGRESS_NOTE="kept your $(basename "$df_dest")"
            state_record "$ii_name" file "$ii_version" "$df_dest"
            return 0
        fi
        backup_existing "$df_dest"
        cp "$df_new" "$df_dest" || return 1
        rm -f "$df_new"
        chmod "$df_mode" "$df_dest"
        state_record "$ii_name" file "$ii_version" "$df_dest"
        say "  $df_dest"
        return 0
    fi
    say "installing $ii_name"
    mkdir -p "$(dirname "$df_dest")"
    backup_existing "$df_dest"
    download "$(source_url "$ii_source")" "$df_dest" "$ii_digest" || return 1
    chmod "$df_mode" "$df_dest"
    if [ "$df_once" = 1 ]; then
        state_record "$ii_name" file-once "$ii_version" "$df_dest"
    else
        state_record "$ii_name" file "$ii_version" "$df_dest"
    fi
    say "  $df_dest"
    return 0
}

# Plugins fish's own plugin manager fetches. Keeping them current is fisher's
# job, not tlstore's, so update never touches them.
do_fisher() {
    if ! have fish; then
        err "$ii_name needs fish — install it first"
        return 1
    fi
    say "installing $ii_name"
    if ! fish -c "fisher install $ii_source" </dev/null; then
        err "could not install $ii_name"
        return 1
    fi
    state_record "$ii_name" fisher "$ii_version"
    return 0
}

do_bundle() {
    state_record "$ii_name" bundle "$ii_version"
    return 0
}

# Reads one string field out of a single-line npm registry document.
json_field() {
    tr -d '\n' | sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" | head -1
}

# npm_latest_version <npm:package#exe> — the version the registry's latest
# dist-tag points at now, or nothing when it cannot be reached.
npm_latest_version() {
    nl_package="${1#npm:}"
    nl_package="${nl_package%#*}"
    curl -fsSL "$NPM_REGISTRY/$nl_package/latest" 2>/dev/null | json_field version
}

do_npm_musl() {
    np_package="${ii_source#npm:}"
    np_exe="${np_package##*#}"
    np_package="${np_package%#*}"
    np_dir=$(item_targets "$ii_name" npm-musl "$ii_target" "$ii_source")
    np_wrapper="${np_dir##* }"
    np_dir="${np_dir%% *}"

    for np_tool in curl tar sha512sum base64 od; do
        have "$np_tool" || { err "$np_tool is missing — install coreutils and tar"; return 1; }
    done
    have "$PATCHELF" || { err "patchelf is missing — install it and try again"; return 1; }

    np_loader_row=$(row musl-loader)
    if [ -z "$np_loader_row" ]; then
        err "$ii_name has no loader for this device"
        return 1
    fi

    say "installing $ii_name"
    np_want="${ii_version:-latest}"
    np_meta=$(curl -fsSL "$NPM_REGISTRY/$np_package/$np_want") || {
        err "could not reach the $ii_name download"
        return 1
    }
    np_version=$(printf '%s' "$np_meta" | json_field version)
    np_tarball=$(printf '%s' "$np_meta" | json_field tarball)
    np_integrity=$(printf '%s' "$np_meta" | json_field integrity)
    case "$np_integrity" in
        sha512-*) ;;
        *) err "$ii_name came without a checksum — nothing was installed"; return 1 ;;
    esac
    np_expect=$(printf '%s' "${np_integrity#sha512-}" | base64 -d | od -An -v -tx1 | tr -d ' \n')

    if [ -x "$np_dir/$np_exe" ] && [ "$(cat "$np_dir/version" 2>/dev/null)" = "$np_version" ]; then
        say "  $ii_name $np_version is already here"
    else
        say "  downloading $ii_name $np_version"
        mkdir -p "$(dirname "$np_dir")"
        np_tmp="$CACHE_DIR/$ii_name.tgz"
        mkdir -p "$CACHE_DIR"
        CANCEL_TMP="$np_tmp"
        curl -fsSL -o "$np_tmp" "$np_tarball" || { rm -f "$np_tmp"; CANCEL_TMP=""; err "could not download $ii_name"; return 1; }
        np_actual=$(sha512sum "$np_tmp" | cut -d' ' -f1)
        if [ "$np_actual" != "$np_expect" ]; then
            rm -f "$np_tmp"
            CANCEL_TMP=""
            err "$ii_name does not match its checksum — nothing was installed"
            return 1
        fi
        CANCEL_TMP=""
        rm -rf "$np_dir.new"
        mkdir -p "$np_dir.new"
        CANCEL_EXTRA="$np_dir.new"
        if ! tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 "package/$np_exe"; then
            rm -f "$np_tmp"
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            err "the $ii_name download is not what was expected"
            return 1
        fi
        tar xzf "$np_tmp" -C "$np_dir.new" --strip-components=1 package/LICENSE.md 2>/dev/null || true
        rm -f "$np_tmp"

        np_loader="$np_dir.new/ld-musl-aarch64.so.1"
        np_have_loader=$(item_targets musl-loader binary "$(field "$np_loader_row" 7)")
        if [ -f "$np_have_loader" ]; then
            cp -f "$np_have_loader" "$np_loader"
        elif ! download "$(source_url "$(field "$np_loader_row" 5)")" "$np_loader" "$(field "$np_loader_row" 6)"; then
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            return 1
        fi
        chmod 755 "$np_loader" "$np_dir.new/$np_exe"

        # Some of these binaries need more of the musl world than its libc —
        # opencode links libstdc++ and libgcc_s, and Termux's own are Bionic
        # ones the musl loader cannot use. They go in beside the loader,
        # because the rpath set below is this directory and nothing else.
        for np_lib in $(commas "$(opt "$ii_options" musl-libs)"); do
            np_lib_row=$(row "$np_lib")
            if [ -z "$np_lib_row" ]; then
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                err "$ii_name has no $np_lib for this device"
                return 1
            fi
            np_lib_have=$(item_targets "$np_lib" binary "$(field "$np_lib_row" 7)")
            np_lib_dest="$np_dir.new/${np_lib_have##*/}"
            if [ -f "$np_lib_have" ]; then
                cp -f "$np_lib_have" "$np_lib_dest"
            elif ! download "$(source_url "$(field "$np_lib_row" 5)")" "$np_lib_dest" "$(field "$np_lib_row" 6)"; then
                rm -rf "$np_dir.new"
                CANCEL_EXTRA=""
                return 1
            fi
            chmod 644 "$np_lib_dest"
        done

        if ! "$PATCHELF" --set-interpreter "$np_dir/ld-musl-aarch64.so.1" --set-rpath "$np_dir" "$np_dir.new/$np_exe"; then
            rm -rf "$np_dir.new"
            CANCEL_EXTRA=""
            err "could not prepare $ii_name for this device"
            return 1
        fi
        printf '%s\n' "$np_version" > "$np_dir.new/version"
        CANCEL_EXTRA=""
        rm -rf "$np_dir.old"
        [ ! -e "$np_dir" ] || mv "$np_dir" "$np_dir.old"
        mv "$np_dir.new" "$np_dir"
        rm -rf "$np_dir.old"
    fi

    mkdir -p "$BIN_DIR"
    backup_existing "$np_wrapper"
    np_envs=$(commas "$(opt "$ii_options" env)")
    {
        printf '#!%s/bin/sh\n' "$PREFIX"
        printf '# written by termux-launcher\n'
        for np_e in $np_envs; do
            printf 'export %s\n' "$np_e"
        done
        if [ "$(opt "$ii_options" tz)" = 1 ]; then
            # shellcheck disable=SC2016  # written into the wrapper, expanded there
            printf '%s\n' '[ -n "${TZ:-}" ] || TZ=$(getprop persist.sys.timezone 2>/dev/null) && export TZ'
        fi
        printf 'exec "%s" "$@"\n' "$np_dir/$np_exe"
    } > "$np_wrapper"
    chmod 755 "$np_wrapper"
    state_record "$ii_name" npm-musl "$np_version" "$np_dir" "$np_wrapper"
    say "  $np_wrapper"
    return 0
}

# ---------------------------------------------------------------------------
# Removing
# ---------------------------------------------------------------------------

remove_item() {
    ri_name="$1"
    ri_row=$(state_row "$ri_name" 2>/dev/null || true)
    if [ -z "$ri_row" ]; then
        say "$ri_name is not installed"
        return 0
    fi
    ri_kind=$(field "$ri_row" 2)
    ri_files=$(field "$ri_row" 5)
    if [ "$ri_kind" = fisher ]; then
        ri_item=$(row "$ri_name")
        if [ -n "$ri_item" ] && have fish; then
            fish -c "fisher remove $(field "$ri_item" 5)" </dev/null >/dev/null 2>&1 || true
        fi
    fi
    for ri_f in $ri_files; do
        if [ -d "$ri_f" ]; then
            rm -rf "$ri_f"
        else
            rm -f "$ri_f"
        fi
        restore_backup "$ri_f" && say "  put your own $(basename "$ri_f") back"
    done
    state_forget "$ri_name"
    case "$ri_kind" in
        pkg) say "$ri_name is no longer tracked; the package itself stays installed" ;;
        bundle) say "removed $ri_name" ;;
        *) say "removed $ri_name" ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Refresh
# ---------------------------------------------------------------------------

# refresh_catalog <quiet> — 0 took a newer list, 1 kept the one we had, 2 refused
# what was offered.
refresh_catalog() {
    rc_quiet="${1:-0}"
    if ! have minisign; then
        [ "$rc_quiet" = 1 ] && return 1
        if ask_yn "Updating the list of items needs minisign. Install it?"; then
            install_pkg minisign >/dev/null 2>&1 || true
        fi
        if ! have minisign; then
            say "Using the list that came with the app."
            return 1
        fi
    fi
    if [ ! -f "$PUBKEY" ]; then
        [ "$rc_quiet" = 1 ] || say "Using the list that came with the app."
        return 1
    fi
    mkdir -p "$CACHE_DIR"
    rc_new="$CACHE_DIR/catalog.tsv"
    rc_sig="$CACHE_DIR/catalog.tsv.minisig"
    if ! curl -fsL -o "$rc_new" "$CATALOG_URL" 2>/dev/null || ! curl -fsL -o "$rc_sig" "$CATALOG_URL.minisig" 2>/dev/null; then
        rm -f "$rc_new" "$rc_sig"
        [ "$rc_quiet" = 1 ] || say "Could not reach the item list; using the one you have."
        return 1
    fi
    if ! minisign -Q -V -p "$PUBKEY" -x "$rc_sig" -m "$rc_new" >/dev/null 2>&1; then
        rm -f "$rc_new" "$rc_sig"
        err "the downloaded item list is not signed by the launcher — ignoring it"
        return 2
    fi
    rc_serial=$(serial_of "$rc_new" 2>/dev/null || true)
    case "$rc_serial" in
        ''|*[!0-9]*)
            rm -f "$rc_new" "$rc_sig"
            err "the downloaded item list is unreadable — ignoring it"
            return 2
            ;;
    esac
    if [ -n "$CATALOG_SERIAL" ] && [ "$rc_serial" -lt "$CATALOG_SERIAL" ]; then
        rm -f "$rc_new" "$rc_sig"
        err "the downloaded item list is older than the one you have — ignoring it"
        return 2
    fi
    if [ -n "$CATALOG_SERIAL" ] && [ "$rc_serial" -eq "$CATALOG_SERIAL" ]; then
        rm -f "$rc_new" "$rc_sig"
        [ "$rc_quiet" = 1 ] || say "The item list is already up to date."
        return 1
    fi
    mkdir -p "$DATA_DIR"
    mv "$rc_new" "$USER_CATALOG" || return 1
    rm -f "$rc_sig"
    pick_catalog
    say "Updated the list of items."
    return 0
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

# pick_items <candidates file: name TAB summary> <chosen file>
pick_items() {
    pi_list="$1"
    pi_out="$2"
    : > "$pi_out"
    [ -s "$pi_list" ] || return 0
    pi_count=$(awk 'END { print NR }' "$pi_list")
    pi_sel=""
    while :; do
        say ""
        awk -F "$TAB" -v sel=" $pi_sel " '
            { mark = (index(sel, " " NR " ") > 0) ? "x" : " "
              printf "  [%s] %2d  %-18s %s\n", mark, NR, $1, $2 }
        ' "$pi_list"
        say ""
        say "Type numbers to pick, a for all, n for none, Enter when you are done."
        printf '> '
        read -r pi_reply || pi_reply=""
        case "$pi_reply" in
            '') break ;;
            a|A)
                pi_sel=""
                pi_i=1
                while [ "$pi_i" -le "$pi_count" ]; do
                    pi_sel="$pi_sel $pi_i"
                    pi_i=$((pi_i + 1))
                done
                ;;
            n|N) pi_sel="" ;;
            q|Q) pi_sel=""; break ;;
            *)
                for pi_tok in $pi_reply; do
                    case "$pi_tok" in
                        ''|*[!0-9]*) say "  $pi_tok is not one of the numbers"; continue ;;
                    esac
                    if [ "$pi_tok" -lt 1 ] || [ "$pi_tok" -gt "$pi_count" ]; then
                        say "  $pi_tok is not one of the numbers"
                        continue
                    fi
                    if in_list "$pi_sel" "$pi_tok"; then
                        pi_sel=$(printf '%s' " $pi_sel " | sed "s/ $pi_tok / /")
                    else
                        pi_sel="$pi_sel $pi_tok"
                    fi
                done
                ;;
        esac
    done
    [ -n "$pi_sel" ] || return 0
    for pi_n in $pi_sel; do
        awk -F "$TAB" -v want="$pi_n" 'NR == want { print $1 }' "$pi_list" >> "$pi_out"
    done
    return 0
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

usage() {
    cat <<'EOF'
tlstore installs the tools and configs the launcher shows off.

  tlstore list [-i|-a]        everything, what you have (-i), what you do not (-a)
  tlstore search <term>       find an item by name or description
  tlstore info <name>         what an item is and where it goes
  tlstore install [name...]   install items; with no names, pick from a list
  tlstore remove <name...>    remove items tlstore installed
  tlstore update [name...]    bring what you have up to date
  tlstore refresh             update the list of items
  tlstore shell               install the fish shell setup
  tlstore display             set up graphics for Linux apps
  tlstore doctor              check that everything is in place
  tlstore version

  -y          say yes to everything except a config file of yours
  --configs   take the new version of every config file too
EOF
}

# emit_items <style list|search> <all|installed|available> <tsv 0|1> [term]
# The one place the item list is printed, for people and for programs. The
# machine-readable columns are name, state, version, installed, kind, summary,
# category, featured — the two tlstore-ui needs for the Apps screen's chips
# and cover picture without an `info` call per item.
emit_items() {
    ei_style="$1"
    ei_mode="$2"
    ei_tsv="$3"
    ei_term="${4:-}"
    visible_rows | awk -F "$TAB" -v term="$ei_term" '
        BEGIN { t = tolower(term) }
        t == "" || index(tolower($1), t) > 0 || index(tolower($10), t) > 0 {
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", $1, $2, $3, $9, $10, $11, $26
        }' |
    while IFS="$TAB" read -r ei_name ei_kind ei_version ei_options ei_summary ei_category ei_featured; do
        if is_installed "$ei_name"; then
            [ "$ei_mode" = available ] && continue
            ei_state=installed
            ei_have=$(installed_version "$ei_name")
            ei_mark="*"
        else
            [ "$ei_mode" = installed ] && continue
            ei_state=available
            ei_have=""
            ei_mark=" "
        fi
        if [ "$ei_tsv" = 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$ei_name" "$ei_state" "$ei_version" "$ei_have" "$ei_kind" "$ei_summary" \
                "$ei_category" "$ei_featured"
            continue
        fi
        if [ "$ei_style" = list ]; then
            printf '%s %-14s %s\n' "$ei_mark" "$ei_name" "$ei_summary"
            ei_build=$(opt "$ei_options" build)
            [ -z "$ei_build" ] || printf '    needs while installing: %s\n' "$ei_build"
        else
            printf '  %-14s %s\n' "$ei_name" "$ei_summary"
        fi
    done
    return 0
}

cmd_list() {
    cl_mode=all
    cl_tsv=0
    for cl_a in "$@"; do
        case "$cl_a" in
            -i) cl_mode=installed ;;
            -a) cl_mode=available ;;
            --tsv) cl_tsv=1 ;;
            *) err "unknown option: $cl_a"; return 2 ;;
        esac
    done
    need_catalog
    emit_items list "$cl_mode" "$cl_tsv"
}

cmd_search() {
    cs_tsv=0
    cs_term=""
    for cs_a in "$@"; do
        case "$cs_a" in
            --tsv) cs_tsv=1 ;;
            -*) err "unknown option: $cs_a"; return 2 ;;
            *)
                if [ -n "$cs_term" ]; then
                    err "search takes one thing to look for"
                    return 2
                fi
                cs_term="$cs_a"
                ;;
        esac
    done
    [ -n "$cs_term" ] || { err "search needs something to look for"; return 2; }
    need_catalog
    emit_items search all "$cs_tsv" "$cs_term"
}

cmd_info() {
    ci_tsv=0
    ci_want=""
    for ci_a in "$@"; do
        case "$ci_a" in
            --tsv) ci_tsv=1 ;;
            -*) err "unknown option: $ci_a"; return 2 ;;
            *)
                if [ -n "$ci_want" ]; then
                    err "info needs one name"
                    return 2
                fi
                ci_want="$ci_a"
                ;;
        esac
    done
    [ -n "$ci_want" ] || { err "info needs one name"; return 2; }
    need_catalog
    load_item "$ci_want" || { err "$ci_want is not in the list"; return 1; }
    ci_files=$(item_targets "$it_name" "$it_kind" "$it_target" "$it_source")
    ci_where="$ci_files"
    case "$it_kind" in
        pkg) ci_where="$it_source" ;;
        bundle) ci_where="-" ;;
    esac
    [ -n "$ci_where" ] || ci_where="-"
    ci_build=$(opt "$it_options" build)
    if [ "$ci_tsv" = 1 ]; then
        printf '%s\t%s\n' Kind "$it_kind"
        printf '%s\t%s\n' Version "$it_version"
        printf '%s\t%s\n' From "$it_source"
        printf '%s\t%s\n' Checksum "$it_digest"
        printf '%s\t%s\n' Needs "$it_requires"
        [ -z "$ci_build" ] || printf '%s\t%s\n' "Builds with" "$ci_build"
        printf '%s\t%s\n' Files "$ci_where"
        if is_installed "$it_name"; then
            printf '%s\t%s\n' Installed "$(installed_version "$it_name")"
        fi
        printf '%s\t%s\n' Summary "$it_summary"
        # The item spread, for tlstore-ui: everything item-spread-rules.md
        # needs to draw the item's own page, one key per line, an unknown
        # value ("-") dropping its row the same way "Builds with" does above.
        [ "$it_category" = - ] || printf '%s\t%s\n' Category "$it_category"
        [ "$it_upstream" = - ] || printf '%s\t%s\n' Upstream "$it_upstream"
        printf '%s\t%s\n' Setup "$it_setup"
        [ "$it_standfirst" = - ] || printf '%s\t%s\n' Standfirst "$it_standfirst"
        [ "$it_does1" = - ] || printf '%s\t%s\n' Does1 "$it_does1"
        [ "$it_does2" = - ] || printf '%s\t%s\n' Does2 "$it_does2"
        [ "$it_does3" = - ] || printf '%s\t%s\n' Does3 "$it_does3"
        [ "$it_try" = - ] || printf '%s\t%s\n' Try "$it_try"
        [ "$it_notes" = - ] || printf '%s\t%s\n' Notes "$it_notes"
        [ "$it_author" = - ] || printf '%s\t%s\n' Author "$it_author"
        [ "$it_licence" = - ] || printf '%s\t%s\n' Licence "$it_licence"
        [ "$it_size" = - ] || printf '%s\t%s\n' Size "$it_size"
        if [ "$it_picture" != - ]; then
            printf '%s\t%s\n' Picture "$it_picture"
            printf '%s\t%s\n' Picture-digest "$it_picture_digest"
        fi
        [ "$it_demo" = - ] || printf '%s\t%s\n' Demo "$it_demo"
        printf '%s\t%s\n' Featured "$it_featured"
        [ "$it_readme_skip" = - ] || printf '%s\t%s\n' Readme-skip "$it_readme_skip"
        return 0
    fi
    say "$it_name"
    say "  $it_summary"
    printf '  %-11s %s\n' Kind "$it_kind"
    printf '  %-11s %s\n' Version "$it_version"
    printf '  %-11s %s\n' From "$it_source"
    printf '  %-11s %s\n' Checksum "$it_digest"
    printf '  %-11s %s\n' Needs "$it_requires"
    [ -z "$ci_build" ] || printf '  %-11s %s\n' "Builds with" "$ci_build"
    printf '  %-11s %s\n' Files "$ci_where"
    if is_installed "$it_name"; then
        printf '  %-11s %s\n' Installed "$(installed_version "$it_name")"
    fi
    [ "$it_category" = - ] || printf '  %-11s %s\n' Category "$it_category"
    [ "$it_upstream" = - ] || printf '  %-11s %s\n' Upstream "$it_upstream"
    [ "$it_author" = - ] || printf '  %-11s %s\n' Author "$it_author"
    [ "$it_licence" = - ] || printf '  %-11s %s\n' Licence "$it_licence"
    [ "$it_size" = - ] || printf '  %-11s %s\n' Size "$it_size"
    return 0
}

# sha256 of a short string, for caching a fetch that carries no digest of its
# own (a demo has none in the catalog — only the item's own picture does).
string_digest() {
    sd_tmp="$CACHE_DIR/.picture-url.$$"
    mkdir -p "$CACHE_DIR"
    printf '%s' "$1" > "$sd_tmp"
    sd_out=$(file_digest "$sd_tmp")
    rm -f "$sd_tmp"
    printf '%s' "$sd_out"
}

# A local, verified copy of <url> (checked against <digest> unless it is "-"),
# cached under CACHE_DIR/pictures keyed by the digest so a second call for the
# same picture never touches the network. Prints the path on success only.
# cache_fetch <url> <digest> <extension>
cache_fetch() {
    cf_url="$1"
    cf_digest="$2"
    cf_ext="$3"
    mkdir -p "$CACHE_DIR/pictures"
    if [ -n "$cf_digest" ] && [ "$cf_digest" != "-" ]; then
        cf_key="$cf_digest"
    else
        cf_key=$(string_digest "$cf_url")
    fi
    cf_dest="$CACHE_DIR/pictures/$cf_key.$cf_ext"
    if [ -f "$cf_dest" ]; then
        printf '%s\n' "$cf_dest"
        return 0
    fi
    download "$cf_url" "$cf_dest" "$cf_digest" || return 1
    printf '%s\n' "$cf_dest"
    return 0
}

# tlstore picture <name> [demo] — for tlstore-ui: the local path of the item's
# cover picture, or its demo when "demo" is given, fetched and digest-checked
# the same way any other launcher: source is (see load_item / picture,
# picture-digest). A demo carries no digest column of its own, so it is only
# cached by its URL, not verified against one. Prints nothing and exits
# non-zero when the item has no such picture, the download fails, or the
# digest does not match.
cmd_picture() {
    cp_name=""
    cp_demo=0
    for cp_a in "$@"; do
        case "$cp_a" in
            demo) cp_demo=1 ;;
            -*) err "unknown option: $cp_a"; return 2 ;;
            *)
                if [ -n "$cp_name" ]; then
                    err "picture needs one name"
                    return 2
                fi
                cp_name="$cp_a"
                ;;
        esac
    done
    [ -n "$cp_name" ] || { err "picture needs a name"; return 2; }
    need_catalog
    load_item "$cp_name" || return 1
    if [ "$cp_demo" = 1 ]; then
        cp_source="$it_demo"
        cp_digest="-"
    else
        cp_source="$it_picture"
        cp_digest="$it_picture_digest"
    fi
    [ "$cp_source" != "-" ] && [ -n "$cp_source" ] || return 1
    cp_url=$(source_url "$cp_source")
    cp_ext="${cp_url##*.}"
    case "$cp_ext" in
        ''|*[!a-zA-Z0-9]*) cp_ext=jpg ;;
    esac
    cache_fetch "$cp_url" "$cp_digest" "$cp_ext"
}

# ---------------------------------------------------------------------------
# The upstream README, for tlstore-ui's item page
# ---------------------------------------------------------------------------

# github_url <https address> — the address actually fetched: the real one, or
# the same host and path under the TLSTORE_GITHUB tree when it is set.
github_url() {
    if [ -n "$GITHUB_MIRROR" ]; then
        printf '%s/%s' "$GITHUB_MIRROR" "${1#https://}"
    else
        printf '%s' "$1"
    fi
}

# github_host_ok <address> — only https on GitHub's own hosts is fetched for a
# README's pictures; anything else is left where it is.
github_host_ok() {
    case "$1" in
        https://*) ;;
        *) return 1 ;;
    esac
    gh_host="${1#https://}"
    gh_host="${gh_host%%/*}"
    gh_host="${gh_host##*@}"
    gh_host="${gh_host%%:*}"
    case "$gh_host" in
        github.com|raw.githubusercontent.com|user-images.githubusercontent.com) return 0 ;;
        *.githubusercontent.com|github.io|*.github.io) return 0 ;;
    esac
    return 1
}

# quiet_fetch <https address> <destination> <cap in bytes, 0 for none> — a
# silent download, written beside its destination first so a failure leaves
# nothing behind. A missing file, a network error and a file over the cap all
# fail the same way; the caller says what that means.
quiet_fetch() {
    qf_dir=$(dirname "$2")
    mkdir -p "$qf_dir" || return 1
    qf_tmp="$qf_dir/.$(basename "$2").part"
    if ! curl -fsL --max-filesize "$3" -o "$qf_tmp" "$(github_url "$1")" 2>/dev/null; then
        rm -f "$qf_tmp"
        return 1
    fi
    # The cap above only holds when the server says the size up front.
    if [ "$3" != 0 ] && [ "$(wc -c < "$qf_tmp" | tr -d ' ')" -gt "$3" ]; then
        rm -f "$qf_tmp"
        return 1
    fi
    mv "$qf_tmp" "$2"
}

# fresh <file> — is there a copy, less than a day old?
fresh() {
    [ -f "$1" ] || return 1
    [ -z "$(find "$1" -mtime +0 2>/dev/null)" ]
}

# readme_ref <version> — the revision an item's README is read at: the commit
# in a +<hash> suffix (dawn's 0.1.3+0e958747.2 is read at 0e958747), else
# v<version> for an x.y.z version, else HEAD.
readme_ref() {
    case "$1" in
        *+*)
            rr_hash="${1#*+}"
            rr_hash=$(printf '%s' "$rr_hash" | sed 's/[^0-9a-fA-F].*//')
            case "$rr_hash" in
                ???????*) printf '%s' "$rr_hash"; return 0 ;;
            esac
            ;;
    esac
    case "$1" in
        [0-9]*.[0-9]*.[0-9]*) printf 'v%s' "$1" ;;
        *) printf 'HEAD' ;;
    esac
}

# readme_resolve — after load_item: sets RD_PATH to the item's cached README
# and RD_REF to the revision it was read at, fetching when the copy is missing
# or a day old. A tag that is not there falls back to HEAD, and when nothing
# can be fetched a stale copy still counts. Returns 1 when there is no copy at
# all, 2 when the item has no upstream to read (a setup, or a part).
readme_resolve() {
    RD_PATH=""
    RD_REF=""
    [ -n "$it_upstream" ] && [ "$it_upstream" != "-" ] || return 2
    rd_dir="$CACHE_DIR/readme"
    rd_md="$rd_dir/$it_name-$it_version.md"
    rd_reffile="$rd_dir/$it_name-$it_version.ref"
    rd_want=$(readme_ref "$it_version")
    if ! fresh "$rd_md"; then
        rd_new="$rd_dir/.$it_name-$it_version.new"
        for rd_try in "$rd_want" HEAD; do
            if quiet_fetch "$GITHUB_RAW/$it_upstream/$rd_try/README.md" "$rd_new" 0; then
                mv "$rd_new" "$rd_md" || return 1
                printf '%s\n' "$rd_try" > "$rd_reffile"
                break
            fi
            [ "$rd_try" != HEAD ] || break
        done
    fi
    [ -f "$rd_md" ] || return 1
    RD_PATH="$rd_md"
    RD_REF=$(cat "$rd_reffile" 2>/dev/null || true)
    [ -n "$RD_REF" ] || RD_REF="$rd_want"
    return 0
}

# tlstore readme <name> — for tlstore-ui: the path of the item's README, read
# from its upstream at the revision the item is built from (readme_ref) and
# kept for a day under CACHE_DIR/readme. Prints the path alone on stdout; exits
# 1 with one line on stderr when nothing could be fetched and nothing is kept,
# 2 when the item has no upstream (a setup).
cmd_readme() {
    [ $# -eq 1 ] || { err "readme needs one name"; return 2; }
    case "$1" in
        -*) err "unknown option: $1"; return 2 ;;
    esac
    need_catalog
    load_item "$1" || { err "$1 is not in the list"; return 1; }
    readme_resolve
    rd_rc=$?
    case "$rd_rc" in
        0) printf '%s\n' "$RD_PATH"; return 0 ;;
        2) err "$it_name has no readme: it does not come from a GitHub project"; return 2 ;;
        *) err "could not fetch the readme for $it_name, and no copy is kept here"; return 1 ;;
    esac
}

# tlstore readme-asset <name> <src> — for tlstore-ui: a picture the README
# refers to, downloaded into CACHE_DIR/readme/<name>/ and kept for a day the
# way the README is. <src> is the address as written in the README: relative
# (resolved against the README's own revision on raw.githubusercontent.com)
# or an https address on one of GitHub's hosts; anything else exits 1. At most
# 5 MB. Prints the path alone on stdout.
cmd_readme_asset() {
    [ $# -eq 2 ] || { err "readme-asset needs a name and a picture address"; return 2; }
    case "$1" in
        -*) err "unknown option: $1"; return 2 ;;
    esac
    need_catalog
    load_item "$1" || { err "$1 is not in the list"; return 1; }
    ra_src="$2"
    case "$ra_src" in
        https://*)
            github_host_ok "$ra_src" || { err "$ra_src is not on GitHub — left alone"; return 1; }
            ra_url="$ra_src"
            ;;
        *:*|//*)
            err "$ra_src is not on GitHub — left alone"
            return 1
            ;;
        *)
            readme_resolve
            ra_rc=$?
            case "$ra_rc" in
                0) ;;
                2) err "$it_name has no readme: it does not come from a GitHub project"; return 2 ;;
                *) err "could not fetch the readme for $it_name, so $ra_src has nothing to be relative to"; return 1 ;;
            esac
            ra_rel="${ra_src#./}"
            ra_rel="${ra_rel#/}"
            ra_url="$GITHUB_RAW/$it_upstream/$RD_REF/$ra_rel"
            ;;
    esac
    ra_file="${ra_url%%\?*}"
    ra_file="${ra_file%%#*}"
    ra_file="${ra_file##*/}"
    ra_ext=""
    case "$ra_file" in
        *.*)
            ra_ext="${ra_file##*.}"
            case "$ra_ext" in
                ''|*[!a-zA-Z0-9]*) ra_ext="" ;;
                *) ra_ext=".$ra_ext" ;;
            esac
            ;;
    esac
    ra_dest="$CACHE_DIR/readme/$it_name/$(string_digest "$ra_url")$ra_ext"
    if ! fresh "$ra_dest"; then
        # A stale copy is only replaced by a fetch that worked, and stays
        # when one did not.
        ra_new="$CACHE_DIR/readme/$it_name/.$(basename "$ra_dest").new"
        if quiet_fetch "$ra_url" "$ra_new" 5242880; then
            mv "$ra_new" "$ra_dest" || return 1
        fi
    fi
    [ -f "$ra_dest" ] || { err "could not fetch $ra_src for $it_name"; return 1; }
    printf '%s\n' "$ra_dest"
    return 0
}

cmd_install() {
    ci_names=""
    for ci_a in "$@"; do
        case "$ci_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --configs) REPLACE_CONFIGS=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -*) err "unknown option: $ci_a"; return 2 ;;
            *) ci_names="$ci_names $ci_a" ;;
        esac
    done
    need_catalog

    if [ -z "$ci_names" ]; then
        mkdir -p "$CACHE_DIR"
        ci_cand="$CACHE_DIR/choices"
        ci_chosen="$CACHE_DIR/chosen"
        # Only what is not installed yet: the picker is for adding.
        : > "$ci_cand"
        visible_rows | awk -F "$TAB" '{ printf "%s\t%s\n", $1, $10 }' |
        while IFS="$TAB" read -r ci_pn ci_ps; do
            is_installed "$ci_pn" || printf '%s\t%s\n' "$ci_pn" "$ci_ps" >> "$ci_cand"
        done
        if [ ! -s "$ci_cand" ]; then
            rm -f "$ci_cand"
            say "You already have everything in the list."
            return 0
        fi
        say "Pick what you want."
        pick_items "$ci_cand" "$ci_chosen"
        ci_names=$(tr '\n' ' ' < "$ci_chosen")
        rm -f "$ci_cand" "$ci_chosen"
        if [ -z "$(printf '%s' "$ci_names" | tr -d ' ')" ]; then
            say "Nothing to install."
            return 0
        fi
    fi

    for ci_n in $ci_names; do
        [ -n "$(row "$ci_n")" ] || { err "$ci_n is not in the list"; return 1; }
        ! hidden_item "$ci_n" || { err "$ci_n is part of another item"; return 1; }
    done

    # shellcheck disable=SC2086  # a list of names, split on purpose
    ci_plan=$(plan_for $ci_names)
    say "Installing: $(words_list "$ci_plan")"
    ask_yn "Go ahead?" || { say "Nothing was installed."; return 0; }
    add_build_tools "$ci_plan" 0 || return 1
    for ci_n in $ci_plan; do
        if [ "$PROGRESS" = 1 ]; then
            CANCEL_ITEM="$ci_n"
            progress_line step "$ci_n" 10 fetched
            PROGRESS_NOTE=""
            if install_item "$ci_n"; then
                progress_line step "$ci_n" 60 "signature checked"
                progress_line step "$ci_n" 90 "putting files in place"
                progress_line step "$ci_n" 100 ready
                progress_done "$ci_n" ok "${PROGRESS_NOTE:-installed}"
            else
                FAILED=1
                progress_done "$ci_n" failed "could not install $ci_n"
            fi
            CANCEL_ITEM=""
        else
            install_item "$ci_n" || FAILED=1
        fi
    done
    drop_build_tools
    [ "$FAILED" = 0 ] || return 1
    return 0
}

cmd_remove() {
    cr_names=""
    for cr_a in "$@"; do
        case "$cr_a" in
            -y|--yes) ASSUME_YES=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -*) err "unknown option: $cr_a"; return 2 ;;
            *) cr_names="$cr_names $cr_a" ;;
        esac
    done
    [ -n "$cr_names" ] || { err "remove needs a name"; return 2; }
    pick_catalog || true

    # A bundle takes the members it brought in with it.
    cr_all=""
    for cr_n in $cr_names; do
        cr_all="$cr_all $cr_n"
        cr_row=$(state_row "$cr_n" 2>/dev/null || true)
        [ -n "$cr_row" ] || continue
        [ "$(field "$cr_row" 2)" = bundle ] || continue
        [ -n "$CATALOG" ] || continue
        cr_item=$(row "$cr_n")
        [ -n "$cr_item" ] || continue
        for cr_m in $(commas "$(field "$cr_item" 8)"); do
            [ "$cr_m" = "-" ] && continue
            is_installed "$cr_m" || continue
            in_list "$cr_all" "$cr_m" || cr_all="$cr_all $cr_m"
        done
    done

    say "Removing: $(words_list "$cr_all")"
    ask_yn "Go ahead?" || { say "Nothing was removed."; return 0; }
    for cr_n in $cr_all; do
        if [ "$PROGRESS" = 1 ]; then
            CANCEL_ITEM="$cr_n"
            progress_line step "$cr_n" 30 fetched
            if remove_item "$cr_n"; then
                progress_line step "$cr_n" 75 "putting files in place"
                progress_line step "$cr_n" 100 ready
                progress_done "$cr_n" ok removed
            else
                FAILED=1
                progress_done "$cr_n" failed "could not remove $cr_n"
            fi
            CANCEL_ITEM=""
        else
            remove_item "$cr_n" || FAILED=1
        fi
    done
    [ "$FAILED" = 0 ] || return 1
    return 0
}

# The item half of update; cmd_update adds the self-update on top of it.
update_items() {
    cu_check=0
    cu_offline=0
    cu_tsv=0
    cu_names=""
    for cu_a in "$@"; do
        case "$cu_a" in
            --check) cu_check=1 ;;
            --offline) cu_offline=1 ;;
            --tsv) cu_tsv=1 ;;
            --configs) REPLACE_CONFIGS=1 ;;
            --progress) PROGRESS=1; ASSUME_YES=1 ;;
            -y|--yes) ASSUME_YES=1 ;;
            -*) err "unknown option: $cu_a"; return 2 ;;
            *) cu_names="$cu_names $cu_a" ;;
        esac
    done
    need_catalog
    [ "$cu_offline" = 1 ] || refresh_catalog 1 || true
    need_catalog

    [ -n "$cu_names" ] || cu_names=$(installed_names | tr '\n' ' ')
    if [ -z "$(printf '%s' "$cu_names" | tr -d ' ')" ]; then
        [ "$cu_tsv" = 1 ] || say "Nothing is installed yet."
        return 0
    fi

    cu_out=""
    cu_pkgs=""
    cu_latest=""
    cu_resolved=""
    for cu_n in $cu_names; do
        if ! is_installed "$cu_n"; then
            [ "$cu_tsv" = 1 ] || say "$cu_n is not installed"
            continue
        fi
        cu_row=$(row "$cu_n")
        if [ -z "$cu_row" ]; then
            [ "$cu_tsv" = 1 ] || say "$cu_n is no longer in the list"
            continue
        fi
        cu_kind=$(field "$cu_row" 2)
        cu_new=$(field "$cu_row" 3)
        cu_have=$(installed_version "$cu_n")
        case "$cu_kind" in
            pkg) cu_pkgs="$cu_pkgs $(field "$cu_row" 5)" ;;
            bundle|fisher) ;;
            npm-musl)
                # An item pinned to latest is whatever its source says today.
                # --check asks the registry which version that is and names the
                # item only when it differs from what is here; offline, or when
                # the registry cannot be reached, it says nothing about it.
                if [ "$cu_new" = latest ]; then
                    cu_latest="$cu_latest $cu_n"
                    if [ "$cu_check" = 1 ] && [ "$cu_offline" = 0 ]; then
                        cu_now=$(npm_latest_version "$(field "$cu_row" 5)")
                        if [ -n "$cu_now" ] && [ "$cu_now" != "$cu_have" ]; then
                            cu_resolved="$cu_resolved $cu_n=$cu_now"
                        fi
                    fi
                elif [ "$cu_new" != "$cu_have" ]; then
                    cu_out="$cu_out $cu_n"
                fi
                ;;
            *)
                [ "$cu_new" = "$cu_have" ] || cu_out="$cu_out $cu_n"
                ;;
        esac
    done

    if [ "$cu_check" = 1 ] && [ "$cu_tsv" = 1 ]; then
        for cu_n in $cu_out; do
            cu_row=$(row "$cu_n")
            cu_note=""
            [ "$(field "$cu_row" 2)" = file ] && cu_note=config-asks
            printf '%s\t%s\t%s\t%s\n' "$cu_n" \
                "$(installed_version "$cu_n")" "$(field "$cu_row" 3)" "$cu_note"
        done
        for cu_nv in $cu_resolved; do
            printf '%s\t%s\t%s\t%s\n' "${cu_nv%%=*}" "$(installed_version "${cu_nv%%=*}")" "${cu_nv#*=}" latest
        done
        return 0
    fi

    if [ "$cu_check" = 1 ]; then
        for cu_nv in $cu_resolved; do
            say "${cu_nv%%=*} ${cu_nv#*=} is available; you have $(installed_version "${cu_nv%%=*}")"
        done
        if [ -z "$(printf '%s%s' "$cu_out" "$cu_resolved" | tr -d ' ')" ]; then
            say "Everything is up to date."
        else
            for cu_n in $cu_out; do
                cu_row=$(row "$cu_n")
                if [ "$(field "$cu_row" 2)" = file ]; then
                    say "$cu_n has a new version; update shows the change and asks"
                else
                    say "$cu_n $(field "$cu_row" 3) is available; you have $(installed_version "$cu_n")"
                fi
            done
        fi
        [ -z "$(printf '%s' "$cu_pkgs" | tr -d ' ')" ] || say "Packages are checked by the package manager when you update."
        if [ "$cu_offline" = 1 ]; then
            for cu_n in $cu_latest; do
                say "$cu_n is checked against its source when you update."
            done
        fi
        return 0
    fi

    if [ -n "$(printf '%s' "$cu_pkgs" | tr -d ' ')" ]; then
        say "Updating packages"
        # shellcheck disable=SC2086
        upgrade_pkg $cu_pkgs || FAILED=1
    fi
    cu_out="$cu_out $cu_latest"
    if [ -z "$(printf '%s' "$cu_out" | tr -d ' ')" ]; then
        [ -n "$(printf '%s' "$cu_pkgs" | tr -d ' ')" ] || say "Everything is up to date."
    else
        add_build_tools "$cu_out" 1 || return 1
        for cu_n in $cu_out; do
            if [ "$PROGRESS" = 1 ]; then
                CANCEL_ITEM="$cu_n"
                progress_line step "$cu_n" 10 fetched
                PROGRESS_NOTE=""
                if install_item "$cu_n" 1; then
                    progress_line step "$cu_n" 60 "signature checked"
                    progress_line step "$cu_n" 90 "putting files in place"
                    progress_line step "$cu_n" 100 ready
                    progress_done "$cu_n" ok "${PROGRESS_NOTE:-updated}"
                else
                    FAILED=1
                    progress_done "$cu_n" failed "could not update $cu_n"
                fi
                CANCEL_ITEM=""
            else
                install_item "$cu_n" 1 || FAILED=1
            fi
        done
        drop_build_tools
    fi
    [ "$FAILED" = 0 ] || return 1
    return 0
}

cmd_update() {
    update_items "$@"
    cu_status=$?
    # Self-update is not part of the item stream tlstore-ui reads; a --progress
    # run leaves tlstore itself alone until a plain `update` asks again.
    if [ "$cu_status" != 2 ] && [ "${cu_check:-0}" = 0 ] && [ "${cu_offline:-0}" = 0 ] \
        && [ "$PROGRESS" != 1 ]; then
        self_update
    fi
    return "$cu_status"
}

cmd_refresh() {
    for cf_a in "$@"; do
        case "$cf_a" in
            -y|--yes) ASSUME_YES=1 ;;
            *) err "unknown option: $cf_a"; return 2 ;;
        esac
    done
    pick_catalog || true
    refresh_catalog 0
    cf_status=$?
    [ "$cf_status" = 2 ] && return 1
    return 0
}

# ---------------------------------------------------------------------------
# Keeping tlstore itself current
# ---------------------------------------------------------------------------

# version_newer <a> <b> — true when a is ahead of b.
version_newer() {
    awk -v a="$1" -v b="$2" '
        function vercmp(x, y,   nx, ny, px, py, i, n, p, q) {
            nx = split(x, px, /[._-]/)
            ny = split(y, py, /[._-]/)
            n = (nx > ny) ? nx : ny
            for (i = 1; i <= n; i++) {
                p = (i <= nx) ? px[i] + 0 : 0
                q = (i <= ny) ? py[i] + 0 : 0
                if (p > q) return 1
                if (p < q) return -1
            }
            return 0
        }
        BEGIN { exit (vercmp(a, b) > 0) ? 0 : 1 }'
}

# A tlstore installed by hand keeps itself current. Inside the launcher the app
# writes the file on every start, so there this does nothing.
self_update() {
    [ -f "$STANDALONE_MARK" ] || return 0
    [ ! -f "$INSTALLED_MARK" ] || return 0
    su_target="$PREFIX/bin/tlstore"
    [ -f "$su_target" ] || return 0
    have curl || return 0
    have minisign || return 0
    [ -f "$PUBKEY" ] || return 0
    mkdir -p "$CACHE_DIR"
    su_new="$CACHE_DIR/tlstore.new"
    su_sig="$CACHE_DIR/tlstore.new.minisig"
    if ! curl -fsL -o "$su_new" "$RAW_BASE/$STORE_PATH/tlstore" 2>/dev/null ||
       ! curl -fsL -o "$su_sig" "$RAW_BASE/$STORE_PATH/tlstore.minisig" 2>/dev/null; then
        rm -f "$su_new" "$su_sig"
        return 0
    fi
    if ! minisign -Q -V -p "$PUBKEY" -x "$su_sig" -m "$su_new" >/dev/null 2>&1; then
        rm -f "$su_new" "$su_sig"
        err "the tlstore that was offered is not signed by the launcher — ignoring it"
        return 0
    fi
    su_version=$(sed -n 's/^TLSTORE_VERSION=\([0-9][0-9.]*\)$/\1/p' "$su_new" | head -1)
    if [ -z "$su_version" ] || ! version_newer "$su_version" "$TLSTORE_VERSION"; then
        rm -f "$su_new" "$su_sig"
        return 0
    fi
    if cp "$su_new" "$su_target.new" && chmod 755 "$su_target.new" &&
       mv "$su_target.new" "$su_target"; then
        say "tlstore is now version $su_version."
    else
        rm -f "$su_target.new"
        err "could not put the newer tlstore in place"
    fi
    rm -f "$su_new" "$su_sig"
    return 0
}

cd_line() { printf '%-13s %s\n' "$1" "$2"; }

cmd_doctor() {
    pick_catalog || true
    cd_bad=0
    cd_line Prefix "$PREFIX"
    if [ -n "$APP_PACKAGE" ]; then
        cd_line Edition "$APP_PACKAGE"
    else
        cd_line Edition "unknown"
    fi
    cd_pkg="${APP_PACKAGE:-unknown}"
    if [ "$HOST" = launcher ]; then
        if [ -n "$LAUNCHER_VERSION" ]; then
            cd_line App "Termux Launcher $LAUNCHER_VERSION ($cd_pkg)"
        else
            cd_line App "Termux Launcher ($cd_pkg)"
        fi
    else
        cd_line App "Termux ($cd_pkg)"
    fi
    case ":$PATH:" in
        *":$BIN_DIR:"*)
            cd_first=$(printf '%s' "$PATH" | tr ':' '\n' | grep -n -x -e "$BIN_DIR" -e "$PREFIX/bin" | head -1)
            case "$cd_first" in
                *"$BIN_DIR") cd_line PATH "$BIN_DIR comes first" ;;
                *) cd_line PATH "put $BIN_DIR before $PREFIX/bin so the tools here win" ;;
            esac
            ;;
        *) cd_line PATH "add $BIN_DIR to it, or the tools here will not run" ;;
    esac

    for cd_t in curl tar sha256sum; do
        if have "$cd_t"; then
            cd_line "$cd_t" ready
        else
            cd_line "$cd_t" missing
            cd_bad=1
        fi
    done
    if have minisign; then
        cd_line minisign ready
    else
        cd_line minisign "not installed (needed to refresh the item list)"
    fi

    if [ -n "$CATALOG" ]; then
        cd_line "Item list" "$CATALOG_SERIAL, $CATALOG_FROM"
    else
        cd_line "Item list" "missing — reopen the app to put it back"
        cd_bad=1
    fi

    cd_missing=""
    for cd_n in $(installed_names); do
        cd_row=$(state_row "$cd_n")
        for cd_f in $(field "$cd_row" 5); do
            [ -e "$cd_f" ] || in_list "$cd_missing" "$cd_n" || cd_missing="$cd_missing $cd_n"
        done
    done
    if [ -n "$(printf '%s' "$cd_missing" | tr -d ' ')" ]; then
        cd_line "Missing" "$(printf '%s' "$cd_missing" | sed 's/^ *//') — install them again"
        cd_bad=1
    fi

    if [ "$ARCH_OK" = 1 ] && [ -n "$CATALOG" ]; then
        cd_row=$(row musl-loader)
        if [ -n "$cd_row" ]; then
            cd_loader=$(item_targets musl-loader binary "$(field "$cd_row" 7)")
            if [ -f "$cd_loader" ]; then
                cd_line Loader ready
            else
                cd_line Loader "not installed (Claude Code needs it)"
            fi
        fi
    fi

    [ "$cd_bad" = 0 ] || return 1
    return 0
}

cmd_display() {
    cy_setup="$PREFIX/bin/termux-x11-gpu-setup"
    if [ ! -x "$cy_setup" ]; then
        err "graphics setup is not here yet — update the app and try again"
        return 1
    fi
    "$cy_setup" "$@"
}

cmd_version() {
    pick_catalog || true
    say "tlstore $TLSTORE_VERSION"
    [ -z "$CATALOG_SERIAL" ] || say "Item list $CATALOG_SERIAL"
    return 0
}

# ---------------------------------------------------------------------------

main() {
    if [ $# -eq 0 ]; then
        # Inside the launcher, with a real terminal at both ends and the store
        # program in place, hand the screen to it; it calls back into this
        # script for every install, update and remove. Everywhere else — plain
        # Termux, ssh, tmux, or before the app has put tlstore-ui down — there
        # is nothing to draw with, so this just prints the list.
        if [ "$HOST" = launcher ] && on_terminal && [ -x "$TLSTORE_UI_BIN" ]; then
            exec "$TLSTORE_UI_BIN"
        fi
        cmd_list
        say ""
        say "Run 'tlstore install' to add what you want."
        return 0
    fi
    tl_cmd="$1"
    shift
    case "$tl_cmd" in
        list) cmd_list "$@" ;;
        search) cmd_search "$@" ;;
        info) cmd_info "$@" ;;
        picture) cmd_picture "$@" ;;
        readme) cmd_readme "$@" ;;
        readme-asset) cmd_readme_asset "$@" ;;
        install|add) cmd_install "$@" ;;
        remove|uninstall) cmd_remove "$@" ;;
        update|upgrade) cmd_update "$@" ;;
        refresh) cmd_refresh "$@" ;;
        shell) cmd_install fish-shell "$@" ;;
        display) cmd_display "$@" ;;
        doctor) cmd_doctor "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) usage ;;
        *) err "unknown command: $tl_cmd"; usage >&2; return 2 ;;
    esac
}

main "$@"
