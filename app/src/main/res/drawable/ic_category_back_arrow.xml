<?xml version="1.0" encoding="utf-8"?>
<!-- Back arrow for the expanded category header, in the same stroked 24dp/2px round-capped style
     as the other chevrons in this app. Geometry, not a typographic glyph: the old "‹" was a single
     angle quotation mark, which the font places high and small inside its em box, so it never sat
     on the header's row no matter how the box was aligned. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M19,12L5.5,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M11.5,18L5.5,12L11.5,6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
</vector>
