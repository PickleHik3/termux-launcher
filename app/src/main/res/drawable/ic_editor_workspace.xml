<?xml version="1.0" encoding="utf-8"?>
<!-- The Workspace card's glyph (appearance-cards overhaul §2): a window outline, its title bar
     drawn, with ">_" inside; the Terminal card keeps the bare prompt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:tint="?attr/colorControlNormal"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The window: a 2dp-cornered outline, 1.75 stroke. -->
    <path
        android:pathData="M5,3.5h14a2,2 0,0 1,2 2v13a2,2 0,0 1,-2 2h-14a2,2 0,0 1,-2 -2v-13a2,2 0,0 1,2 -2z"
        android:strokeWidth="1.75"
        android:strokeColor="@android:color/white"
        android:fillColor="#00000000" />
    <!-- The title bar's rule. -->
    <path
        android:pathData="M3,8h18"
        android:strokeWidth="1.5"
        android:strokeColor="@android:color/white" />
    <!-- > -->
    <path
        android:pathData="M7,11.5l2.75,2.5l-2.75,2.5"
        android:strokeWidth="1.75"
        android:strokeColor="@android:color/white"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- _ -->
    <path
        android:pathData="M12,17h5"
        android:strokeWidth="1.75"
        android:strokeColor="@android:color/white"
        android:strokeLineCap="round" />
</vector>
