<?xml version="1.0" encoding="utf-8"?>
<!-- Undo and Discard: the two ways out that lose something, so they are outlines rather than
     fills. They stand beside Done only while there is something to lose. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/termuxColorOnSurface">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/editor_shell_hairline" />
        </shape>
    </item>
</ripple>
