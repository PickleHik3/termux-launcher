<?xml version="1.0" encoding="utf-8"?>
<!-- Keycap chip for the keybind hint popup: a faint filled capsule with a hairline, echoing the
     in-app keyboard's key styling so the popup reads as part of the keyboard. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="#33FFFFFF" />
    <stroke android:width="1dp" android:color="#55FFFFFF" />
</shape>
