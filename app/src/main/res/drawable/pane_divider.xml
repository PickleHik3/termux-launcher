<?xml version="1.0" encoding="utf-8"?>
<!-- Structural gap between panes. Kept transparent so it never draws a line clashing with the
     active pane's Material border (that border is the only visible pane separator). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
