<?xml version="1.0" encoding="utf-8"?>
<!-- The rule under an editor section heading: a 1dp accent line along the bottom
     edge that separates the groups without boxing them in. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="bottom|fill_horizontal"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/termuxColorPrimary" />
        </shape>
    </item>
</layer-list>
