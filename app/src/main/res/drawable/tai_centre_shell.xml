<?xml version="1.0" encoding="utf-8"?>
<!-- Model centre: the outer tonal shell of a nested card row. The inner surface
     (tai_centre_core) sits 4dp inside it, so every row reads as a card in a tray. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/termuxColorSurfacePanel" />
    <stroke
        android:width="1dp"
        android:color="?attr/termuxColorOutlineVariant" />
    <corners android:radius="20dp" />
</shape>
