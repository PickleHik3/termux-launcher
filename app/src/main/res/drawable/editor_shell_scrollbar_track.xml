<?xml version="1.0" encoding="utf-8"?>
<!-- The track the thumb's share is read against. Quiet enough not to read as a rule between the
     rows and the card's edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.12">
        <shape android:shape="rectangle">
            <solid android:color="?attr/termuxColorOnSurface" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
