<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Oversized radius clamps to half the view's short edge, so every pill gets true capsule
         arc ends at whatever size code gives it. -->
    <corners android:radius="999dp" />
    <!-- The editor's grab points read as chrome, not decoration: outlineVariant left them nearly
         invisible over glass, so they take the brighter on-surface variant role instead. -->
    <solid android:color="?attr/termuxColorOnSurfaceVariant" />
</shape>
