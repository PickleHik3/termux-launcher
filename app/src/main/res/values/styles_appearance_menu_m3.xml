<?xml version="1.0" encoding="utf-8"?>
<!--
  Private styles of the Appearance / Layout editor panel (Material 3 menu rework, 2026-10-04).
  Kept out of styles.xml, which the shared Settings work owns. A segment of the panel's toggle
  groups is tonal rather than outlined: the chosen one on the secondary container, the rest on a
  quiet container, no stroke. The 12dp content padding, the check icon and the single line come
  from Widget.Termux.Button.Segment unchanged.
-->
<resources>
    <style name="Widget.Termux.Editor.Segment" parent="Widget.Termux.Button.Segment">
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/termux_editor_segment_container</item>
        <item name="android:textColor">@color/termux_editor_segment_content</item>
        <item name="iconTint">@color/termux_editor_segment_content</item>
    </style>

    <!--
      The Look editor's Custom row (M3 sliders spec, "M" size, vertical): a 40dp track with full
      outer corners and 2dp inside corners, a 4 x 44dp handle 6dp clear of the track, a stop
      indicator, and no value label: LegendSlider draws the legend inside the track instead. The
      track colours are the stock ones.
    -->
    <dimen name="appearance_editor_slider_track">40dp</dimen>
    <!-- Half the track again and more: a corner this large rounds the whole short side. -->
    <dimen name="appearance_editor_slider_track_corner">40dp</dimen>
    <dimen name="appearance_editor_slider_inside_corner">2dp</dimen>
    <dimen name="appearance_editor_slider_thumb_width">4dp</dimen>
    <dimen name="appearance_editor_slider_thumb_height">44dp</dimen>
    <dimen name="appearance_editor_slider_gap">6dp</dimen>
    <dimen name="appearance_editor_slider_stop">4dp</dimen>
    <!-- The sliders' length: the sheet's one fixed Appearance height is the rows above plus this. -->
    <dimen name="appearance_editor_slider_length">168dp</dimen>

    <style name="Widget.Termux.LegendSlider" parent="Widget.Material3.Slider">
        <item name="android:orientation">vertical</item>
        <item name="trackHeight">@dimen/appearance_editor_slider_track</item>
        <item name="trackCornerSize">@dimen/appearance_editor_slider_track_corner</item>
        <item name="trackInsideCornerSize">@dimen/appearance_editor_slider_inside_corner</item>
        <item name="thumbWidth">@dimen/appearance_editor_slider_thumb_width</item>
        <item name="thumbHeight">@dimen/appearance_editor_slider_thumb_height</item>
        <item name="thumbTrackGapSize">@dimen/appearance_editor_slider_gap</item>
        <item name="trackStopIndicatorSize">@dimen/appearance_editor_slider_stop</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSecondaryContainer</item>
        <item name="labelBehavior">gone</item>
    </style>
</resources>
