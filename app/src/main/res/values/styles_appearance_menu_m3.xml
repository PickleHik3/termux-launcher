<?xml version="1.0" encoding="utf-8"?>
<!-- Private dimensions of the Appearance editor, kept out of styles.xml, which the shared Settings
     work owns. -->
<resources>
    <!-- The bar over the wallpaper picker when it stands over the editor. -->
    <dimen name="appearance_page_bar_height">64dp</dimen>

    <!--
      The cards' glass strips (LegendSlider; M3 sliders spec, "M" size, vertical): a 28dp track
      with full outer corners and 2dp inside corners, a 4dp handle 6dp clear of the track, a stop
      indicator, and the legend beside the track instead of a value label.
    -->
    <dimen name="appearance_editor_slider_track">28dp</dimen>
    <dimen name="appearance_editor_slider_inside_corner">2dp</dimen>
    <dimen name="appearance_editor_slider_thumb_width">4dp</dimen>
    <dimen name="appearance_editor_slider_gap">6dp</dimen>
    <dimen name="appearance_editor_slider_stop">4dp</dimen>
    <!-- The sliders' length: one for every strip, so a strip is one height on every card. -->
    <dimen name="appearance_editor_slider_length">120dp</dimen>
</resources>
