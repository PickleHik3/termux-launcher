<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The wallpaper picker page's full-screen dialog window, laid over the activity's theme
         (TermuxActivity's own shows the system wallpaper through a transparent window; the page
         is opaque and draws edge to edge, its root padded by the system bar insets). -->
    <style name="ThemeOverlay.Termux.WallpaperPickerPage" parent="">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
