<resources>
    <!-- The two chips at the top of every Appearance editor card (ADR 0017). -->
    <string name="editor_chip_where">Where it applies</string>
    <string name="editor_chip_what">What it applies to</string>
    <string name="editor_chip_everywhere">Everywhere</string>
    <!-- The Where chip's kind of page: every page of the kind in front. -->
    <string name="editor_chip_kind_home">Home pages</string>
    <string name="editor_chip_kind_terminal">Terminal pages</string>
    <string name="editor_chip_kind_display">Display pages</string>
    <string name="editor_chip_all_glass">All glass</string>
    <string name="editor_element_widgets">Widgets</string>
    <string name="editor_element_sheets">Sheets</string>
    <!-- A row's name with where its value comes from, as accessibility reads the row. -->
    <string name="editor_source_from">%1$s, from %2$s</string>
