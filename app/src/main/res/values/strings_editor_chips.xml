<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Applies to row of the status bar, dock, keyboard and menus cards
         (appearance-cards-overhaul §1): Global · Home · Workspace. -->
    <string name="editor_applies_to">Applies to</string>
    <string name="editor_applies_global">Global</string>
    <!-- ⋮'s Reset on a card with the Applies to row, e.g. "Reset dock for Home". -->
    <string name="editor_reset_for">%1$s for %2$s</string>
    <!-- A kind of page, in a row's source: every page of that kind. -->
    <string name="editor_chip_kind_home">Home pages</string>
    <string name="editor_chip_kind_terminal">Terminal pages</string>
    <string name="editor_chip_kind_display">Display pages</string>
    <string name="editor_chip_all_glass">All glass</string>
    <string name="editor_element_widgets">Widgets</string>
    <string name="editor_element_sheets">Menus and dialogs</string>
    <!-- A row's name with where its value comes from, as accessibility reads the row. -->
    <string name="editor_source_from">%1$s, from %2$s</string>
    <!-- The caption of a row's long-press menu: the row, then where its value comes from. -->
    <string name="editor_source_caption">%1$s: from %2$s</string>
    <!-- An element on one page, e.g. "Dock on Home". -->
    <string name="editor_source_element_on_page">%1$s on %2$s</string>
    <!-- An element on every page, e.g. "Dock everywhere". -->
    <string name="editor_source_element">%1$s everywhere</string>
    <string name="editor_row_reset">Reset this row</string>
    <!-- Under Margin and Vibrancy, which every glass shares. -->
    <string name="editor_row_all_glass_only">Applies to all glass</string>
</resources>
