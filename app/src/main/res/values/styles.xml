<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/termuxColorOnSurface</item>
    </style>

    <style name="TextAppearance.Termux.Settings.ToolbarTitle" parent="@style/TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/termuxColorOnSurface</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- The Layout editor's keyboard-type chips (spec §3.5): stock Material 3 filter chips that
         carry a glyph and no word — docked, floating, split — each saying its word to a screen
         reader. The checked state is the chip's own container colour; the tick a filter chip
         would add is left off, since the glyph is the whole label. -->
    <style name="Widget.Termux.LayoutEditor.KeyboardFormChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checkable">true</item>
        <item name="android:text">@null</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="iconStartPadding">4dp</item>
        <item name="iconEndPadding">4dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="chipMinTouchTargetSize">48dp</item>
    </style>

    <!-- A chip in the Layout editor's restore tray (spec §3.6): a stock Material 3 assist chip
         with the eye-off glyph and the hidden element's name; a tap brings the element back. -->
    <style name="Widget.Termux.LayoutEditor.TrayChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipIcon">@drawable/ic_symbol_visibility_off</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">18dp</item>
    </style>


    <!-- preferenceTheme: the stock overlay with the switch preference's widget swapped for the
         Material 3 switch (a MaterialSwitch, same switchWidget id), so every SwitchPreferenceCompat
         in Settings is a MaterialSwitch without each one setting its own layout. -->
    <style name="ThemeOverlay.Termux.Preference" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Termux</item>
    </style>
    <style name="Preference.SwitchPreferenceCompat.Termux" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <!-- A text segment of any MaterialButtonToggleGroup: the check shows on the chosen one. The
         unchecked state keeps an empty slot of the same size, so choosing never moves the row. -->
    <style name="Widget.Termux.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="icon">@drawable/segment_checked_icon</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">4dp</item>
        <!-- All four: Widget.Material3.Button.OutlinedButton sets paddingLeft / paddingRight to
             24dp, and they win over a paddingStart / paddingEnd stated beside them, which made a
             text segment 32dp wider than its content. -->
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
