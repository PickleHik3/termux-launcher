<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert" />

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/termuxColorOnSurfaceVariant</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/termuxColorOnSurface</item>
    </style>

    <style name="TextAppearance.Termux.Settings.ToolbarTitle" parent="@style/TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">?attr/termuxColorOnSurface</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- One segment of the surface editor's two style pills. Tighter than a stock outlined button
         on every axis the card is short of: no vertical inset, a 34dp bar, 11.5sp text that
         autosizes down rather than truncating, and no minimum width, so three segments still fit
         beside two on one row at a large font scale. -->
    <style name="Widget.Termux.SurfaceEditor.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <!-- A fixed height, not wrap_content: appcompat switches auto-sizing off entirely when
             either dimension wraps, and auto-sizing is what keeps "Floating" whole at a large font
             scale in a segment this narrow. -->
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <!-- Material3's outlined button ships 24dp of horizontal padding, set as left/right; both
             pairs have to go or a five-letter label has ~48dp less room than the segment looks. -->
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">8sp</item>
        <item name="autoSizeMaxTextSize">11.5sp</item>
        <item name="autoSizeStepGranularity">0.5sp</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="SettingsSegmentLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">?attr/termuxColorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>
