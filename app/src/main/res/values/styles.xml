<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/termuxColorOnSurface</item>
    </style>

    <style name="TextAppearance.Termux.Settings.ToolbarTitle" parent="@style/TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/termuxColorOnSurface</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- preferenceTheme: the stock overlay with the switch preference's widget swapped for the
         Material 3 switch (a MaterialSwitch, same switchWidget id), so every SwitchPreferenceCompat
         in Settings is a MaterialSwitch without each one setting its own layout. -->
    <style name="ThemeOverlay.Termux.Preference" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.Termux</item>
    </style>
    <style name="Preference.SwitchPreferenceCompat.Termux" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>

    <!-- A text segment of any MaterialButtonToggleGroup: the check shows on the chosen one. The
         unchecked state keeps an empty slot of the same size, so choosing never moves the row.
         Filled: the chosen one on the primary container, the rest tonal, no outline, 20dp
         corners. minWidth 0 lets a narrow segment take only its share; SegmentedPillPreference
         stacks the segments when a label still does not fit. -->
    <style name="Widget.Termux.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/settings_segment_container</item>
        <item name="android:textColor">@color/settings_segment_content</item>
        <item name="iconTint">@color/settings_segment_content</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Termux.Segment</item>
        <item name="android:minWidth">0dp</item>
        <item name="icon">@drawable/segment_checked_icon</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">4dp</item>
        <!-- All four: Widget.Material3.Button.OutlinedButton sets paddingLeft / paddingRight to
             24dp, and they win over a paddingStart / paddingEnd stated beside them, which made a
             text segment 32dp wider than its content. -->
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ShapeAppearance.Termux.Segment" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- A row of filled segments: a 2dp gap keeps neighbouring tonal segments apart now that
         they have no outline; inner corners stay small so the row reads as one control. -->
    <style name="Widget.Termux.SegmentGroup" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="android:spacing">2dp</item>
        <item name="innerCornerSize">8dp</item>
    </style>

    <!-- The pinned section filter's chips, dressed as filled segments: same colours, height and
         corners, no outline and no check mark (the colour carries the selection). -->
    <style name="Widget.Termux.SectionChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/settings_segment_container</item>
        <item name="android:textColor">@color/settings_segment_content</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Termux.Segment</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
