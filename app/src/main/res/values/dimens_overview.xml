<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Overview's cards (OverviewGrid): the page's shape, the longer side at most max_long (four
         columns on a phone in portrait), never narrower than min_width while that fits across
         (a caption keeps a few letters beside its glyph); past that they get shorter, down to
         min_height. -->
    <dimen name="overview_card_max_long">200dp</dimen>
    <dimen name="overview_card_min_width">64dp</dimen>
    <dimen name="overview_card_min_height">40dp</dimen>
    <!-- A row block narrowest, so its title reads when blocks share a line. -->
    <dimen name="overview_block_min_width">96dp</dimen>
    <dimen name="overview_card_corner">12dp</dimen>
    <!-- Between two cards, across and down. -->
    <dimen name="overview_card_gap">8dp</dimen>
    <dimen name="overview_ring">3dp</dimen>
    <dimen name="overview_gutter">16dp</dimen>
    <dimen name="overview_header_pad_top">8dp</dimen>
    <dimen name="overview_header_pad_bottom">12dp</dimen>
    <dimen name="overview_close_target">48dp</dimen>
    <dimen name="overview_glyph">20dp</dimen>
    <dimen name="overview_glyph_gap">6dp</dimen>
    <dimen name="overview_caption_gap">4dp</dimen>
    <dimen name="overview_title_text">22sp</dimen>
    <dimen name="overview_label_text">13sp</dimen>
    <!-- What a card draws of its page, in dp so the picture does not grow with the font scale. -->
    <dimen name="overview_card_pad">6dp</dimen>
    <dimen name="overview_pane_gap">2dp</dimen>
    <dimen name="overview_pane_corner">4dp</dimen>
    <dimen name="overview_pane_stroke">1dp</dimen>
    <dimen name="overview_pane_text_pad">3dp</dimen>
    <!-- A small card shows fewer, larger rows: a pane narrower than min_width is a block. -->
    <dimen name="overview_pane_text_size">6dp</dimen>
    <dimen name="overview_pane_text_line">8dp</dimen>
    <dimen name="overview_pane_text_min_width">44dp</dimen>
    <dimen name="overview_cell_gap">2dp</dimen>
    <dimen name="overview_icon_inset">4dp</dimen>
    <dimen name="overview_bubble_height">14dp</dimen>
    <dimen name="overview_bubble_gap">5dp</dimen>
    <!-- Dragging a card: the accent bar where it would land. -->
    <dimen name="overview_drag_bar">4dp</dimen>
    <!-- Go to's field, over the bottom edge. -->
    <dimen name="overview_field_height">48dp</dimen>
</resources>
