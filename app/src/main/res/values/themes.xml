<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxApp DayNight DarkActionBar theme. The one app theme: the Light.* names below are thin
         aliases kept for anything still naming them. preferenceTheme is set here (not in the shared
         base theme) because the switch layout it points at lives in this module. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar">
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="preferenceTheme">@style/ThemeOverlay.Termux.Preference</item>
    </style>

    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Light aliases of the DayNight themes. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.TermuxApp.DayNight.DarkActionBar"/>
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar"/>

    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/termuxColorSurfaceBase</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Transparent Status Bar and NavigationBar -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:navigationBarColor">?attr/termuxColorSurfaceBase</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <item name="android:popupBackground">?attr/termuxColorSurfacePanelHigh</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">?attr/termuxColorSurfacePanelHigh</item>
        <item name="termuxActivityDrawerImageTint">?attr/termuxColorOnSurface</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">?attr/termuxColorOnSurface</item>
        <item name="extraKeysButtonActiveTextColor">?attr/termuxColorPrimary</item>
        <item name="extraKeysButtonBackgroundColor">@android:color/transparent</item>
        <item name="extraKeysButtonActiveBackgroundColor">@android:color/transparent</item>

    </style>

    <!-- Wallpaper theme for transparent terminal background -->
    <style name="Theme.TermuxActivity.Wallpaper" parent="Theme.TermuxActivity.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!--
      Applied on top of Material's own personalized-colour overlay when the chrome is themed from
      the terminal colour scheme; see LauncherSchemeTheme.

      Material's overlay only rewires the Material role attributes. The launcher's termuxColor*
      aliases are set from those roles in the base theme, but an overlay applied later does not
      re-resolve them for a theme that already bound the aliases, so they are pointed back at the
      roles here again, which is a no-op whenever the base theme already says the same thing.
    -->
    <style name="ThemeOverlay.Termux.SchemeColors" parent="">
        <item name="termuxColorPrimary">?attr/colorPrimary</item>
        <item name="termuxColorOnPrimary">?attr/colorOnPrimary</item>
        <item name="termuxColorSecondary">?attr/colorSecondary</item>
        <item name="termuxColorOnSecondary">?attr/colorOnSecondary</item>
        <item name="termuxColorSurfaceBase">?attr/colorSurface</item>
        <item name="termuxColorSurfacePanel">?attr/colorSurfaceContainer</item>
        <item name="termuxColorSurfacePanelHigh">?attr/colorSurfaceContainerHigh</item>
        <item name="termuxColorSurfacePanelHighest">?attr/colorSurfaceContainerHighest</item>
        <item name="termuxColorOnSurface">?attr/colorOnSurface</item>
        <item name="termuxColorOnSurfaceVariant">?attr/colorOnSurfaceVariant</item>
        <item name="termuxColorOutlineVariant">?attr/colorOutlineVariant</item>
        <item name="termuxColorAccentContainer">?attr/colorSecondaryContainer</item>
        <item name="termuxColorOnAccentContainer">?attr/colorOnSecondaryContainer</item>
        <item name="termuxColorPrimaryContainer">?attr/colorPrimaryContainer</item>
        <item name="termuxColorOnPrimaryContainer">?attr/colorOnPrimaryContainer</item>
        <item name="termuxColorTertiaryContainer">?attr/colorTertiaryContainer</item>
        <item name="termuxColorOnTertiaryContainer">?attr/colorOnTertiaryContainer</item>
        <item name="termuxColorError">?attr/colorError</item>
        <item name="termuxColorErrorContainer">?attr/colorErrorContainer</item>
        <item name="termuxColorOnErrorContainer">?attr/colorOnErrorContainer</item>
        <!-- Not a Material role, so it gets its own overridable resource. -->
        <item name="termuxColorScrollbar">@color/launcher_scheme_scrollbar</item>
    </style>

    <!--
      Light/dark spellings of the same overlay. A scheme decides its own brightness, which need not
      match the system night mode: a light scheme under a dark system theme still has to tell the
      framework it is light, or ripples, edge effects and scrollbar thumbs stay tuned for the wrong
      background.
    -->
    <style name="ThemeOverlay.Termux.SchemeColors.Light" parent="ThemeOverlay.Termux.SchemeColors">
        <item name="android:isLightTheme" tools:targetApi="q">true</item>
    </style>

    <style name="ThemeOverlay.Termux.SchemeColors.Dark" parent="ThemeOverlay.Termux.SchemeColors">
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.TermuxCropImageActivity" parent="Theme.TermuxApp.DayNight.DarkActionBar">
        <item name="android:windowBackground">?attr/termuxColorSurfaceBase</item>
        <item name="android:navigationBarColor">?attr/termuxColorSurfaceBase</item>
    </style>

</resources>
