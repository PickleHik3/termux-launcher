    android:layout_height="48dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/terl_settings_reset"
    android:scaleType="center"
    android:src="@drawable/ic_symbol_undo"
    android:tint="@color/settings_row_chevron" />
