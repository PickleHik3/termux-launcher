<?xml version="1.0" encoding="utf-8"?>
<!-- One pane: a TerminalView wrapped in a frame that can show the active-pane border.
     Inflated once per leaf in the pane tree (see TerminalPaneController). The frame owns the
     pane's rounded shape and holds the terminal clear of its corner arcs (PaneContentFrame). -->
<com.termux.app.terminal.PaneContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- This pane's glass: the shared pre-blurred wallpaper drawn through the pane's own rect,
         with the terminal tint and film grain over it. Hidden unless the terminal glass is on
         (TerminalPaneController.applyPaneGlass). -->
    <com.termux.app.terminal.PaneGlassBackdropView
        android:id="@+id/terminal_pane_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <com.termux.view.TerminalView
        android:id="@+id/terminal_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:defaultFocusHighlightEnabled="false"
        android:focusableInTouchMode="true"
        android:overScrollMode="never"
        android:smoothScrollbar="false"
        android:scrollingCache="true"
        android:fastScrollEnabled="false"
        android:fadeScrollbars="true"
        android:scrollbarSize="3dp"
        android:scrollbarThumbVertical="@drawable/pane_scroll_thumb"
        android:scrollbars="vertical"
        tools:ignore="UnusedAttribute" />
</com.termux.app.terminal.PaneContentFrame>
