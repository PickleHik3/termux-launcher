<?xml version="1.0" encoding="utf-8"?>
<!-- One pick row beneath the miniature: what the setting is called, and one control for the
     orientation the toggle above is showing. The same shape the appearance editor's rows have, so
     the two editors read as one launcher. Four segment slots are declared and the ones a value set
     does not use are taken off, which keeps the group's corners at the ends of what is offered.
     Generated per group in LayoutEditorPlan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/layout_editor_row_label"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="12.5sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/layout_editor_row_pills"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layout_editor_row_segment_0"
            style="@style/Widget.Termux.SurfaceEditor.Segment" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layout_editor_row_segment_1"
            style="@style/Widget.Termux.SurfaceEditor.Segment" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layout_editor_row_segment_2"
            style="@style/Widget.Termux.SurfaceEditor.Segment" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layout_editor_row_segment_3"
            style="@style/Widget.Termux.SurfaceEditor.Segment" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
