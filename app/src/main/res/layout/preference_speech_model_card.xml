<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard › Voice input › Speech model: one installed speech model as a selectable card, in
     the Model centre's nested-card language. The radio marks the one voice input uses; the whole
     card is the tap target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="3dp"
    android:paddingEnd="16dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/speech_card_shell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tai_centre_shell"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tai_centre_core"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <RadioButton
                android:id="@+id/speech_card_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@android:id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/termuxColorOnSurface"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@android:id/summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/termuxColorOnSurfaceVariant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/speech_card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/termuxColorPrimary"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/speech_card_window"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/tai_centre_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/speech_card_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="8dp"
                android:background="@drawable/tai_centre_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="@string/speech_model_in_use"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
