<?xml version="1.0" encoding="utf-8"?>
<!-- A section heading in either editor's body: one word naming what the rows under it change.

     The heading is set in the accent colour over a thin accent rule, so each group of rows reads as
     its own block at a glance; the 12dp of air above it still carries most of the break. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_shell_section_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:fontFamily="sans-serif-medium"
    android:gravity="center_vertical"
    android:letterSpacing="0.08"
    android:minHeight="24dp"
    android:background="@drawable/editor_shell_section_rule"
    android:paddingBottom="3dp"
    android:textColor="?attr/termuxColorPrimary"
    android:textAllCaps="true"
    android:textSize="12sp" />
