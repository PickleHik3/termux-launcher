<?xml version="1.0" encoding="utf-8"?>
<!-- A row that leaves the editor for a screen of its own — the keyboard's colours. The chevron is
     what says the tap goes somewhere rather than changing a value in place; the whole row is the
     target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/editor_shell_row_label"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="14sp"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform" />

    <com.termux.app.editorshell.EditorShellControlHost
        android:id="@+id/editor_shell_row_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_weight="1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="@string/termux_surface_editor_action_chevron"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="14sp" />
    </com.termux.app.editorshell.EditorShellControlHost>

    <Space
        android:id="@+id/editor_shell_row_value"
        android:layout_width="52dp"
        android:layout_height="1dp"
        android:layout_marginEnd="8dp" />

    <Space
        android:layout_width="28dp"
        android:layout_height="1dp" />
</LinearLayout>
