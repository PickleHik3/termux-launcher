<?xml version="1.0" encoding="utf-8"?>
<!-- The Layout editor's card: the layout canvas of the place the user is looking at, with a
     Portrait / Landscape toggle above it, parked over the live place so the real thing stays
     visible behind.

     Everything else about the editor is the canvas itself (spec §3.5): a bar is dragged to an
     edge by its grip, anything is put away by dropping it in the tray under the phone and brought
     back by its chip there, and a tap selects an element and shows its resize handle. Every write
     goes straight through. The header carries the whole chrome: the revert glyph and Discard
     appear only once something has moved, and ✓ is the way out that keeps it.

     The fill is opaque for the same reason the Appearance card's is: the card sits over the chrome
     it is moving, and a translucent one left neither edge reading as belonging to anything.

     The card is a sheet, the same one the Appearance editor's is (EditorShellSheet): the handle and
     the header stay put and everything under them — the toggle, the canvas and its tray — is one
     list that scrolls in editor_shell_sheet_body. On a portrait screen it rests
     about a fifth of the screen down, so the place it is editing keeps its status strip and its
     chip row in view above it; a pull on the handle, the header or the list grows it toward the
     top inset before the list scrolls, and a firm pull down past rest closes it the way Back does. -->
<com.termux.app.editorshell.EditorShellSheet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_editor_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- The sheet's handle: the mark that says the card came up from the bottom edge. The view is
         the touch slot; the controller paints the 32x4 bar centred in it, and EditorShellSheet
         names it for a screen reader and makes a tap on it toggle the card's two heights. -->
    <View
        android:id="@+id/editor_shell_sheet_handle"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal" />

    <include
            layout="@layout/editor_shell_header" />

    <!-- The body: one scroller for everything under the header. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/editor_shell_sheet_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:theme="@style/ThemeOverlay.Termux.EditorShellScroller">

        <LinearLayout
            android:id="@+id/layout_editor_card_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- The shell's one chooser slot: the choice that changes what the whole card is
                 showing. Layout fills it with the orientation on the miniature, which moves the
                 picture and the target of the next drag, and never the place behind the card: an
                 orientation the phone is not in shows up there only once the phone is turned. It
                 is the list's first row and scrolls with it. -->
            <FrameLayout
                android:id="@+id/editor_shell_chooser_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layout_editor_orientation_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:orientation="horizontal">

                    <!-- No label and no words: two segments that each draw a phone, standing up
                         or on its side, are the question as well as the answer, and each says its
                         word to a screen reader. The host is given its width in code, from the
                         shell's own segment metric. -->
                    <com.termux.app.editorshell.EditorShellControlHost
                        android:id="@+id/layout_editor_orientation_host"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/layout_editor_orientation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/layout_editor_orientation_portrait"
                                style="@style/Widget.Termux.EditorShell.Segment"
                                android:contentDescription="@string/settings_layout_orientation_portrait"
                                app:icon="@drawable/ic_symbol_phone_portrait"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="20dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/layout_editor_orientation_landscape"
                                style="@style/Widget.Termux.EditorShell.Segment"
                                android:contentDescription="@string/settings_layout_orientation_landscape"
                                app:icon="@drawable/ic_symbol_phone_landscape"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="20dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </com.termux.app.editorshell.EditorShellControlHost>
                </LinearLayout>
            </FrameLayout>

            <!-- The toggle can be left on the orientation the phone is not in, where the place
                 behind the card cannot follow the edit. LayoutEditorController shows this line
                 while that is so; its text never changes. -->
            <TextView
                android:id="@+id/layout_editor_orientation_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/termux_layout_editor_other_orientation_notice"
                android:textColor="?attr/termuxColorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- The arrangement's own cost, above the picture it is about: a narrow canvas from
                 bars down the side of a portrait screen, and a status bar itself parked on a side.
                 Neither blocks anything, both can apply at once, and
                 LayoutEditorController.syncNotice fills the text and visibility from the plan. -->
            <TextView
                android:id="@+id/layout_editor_narrow_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/termuxColorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- The layout canvas and what stands over it, in one frame. Its height is set in code
                 from the orientation it is showing and the card's width: the portrait frame
                 stands at about two fifths of the screen, the landscape one as wide as the card.

                 There are no rows under it (spec §3.5): a bar moves by its grip, anything is put
                 away by dropping it in the tray, and a size is a handle on the selected element.
                 Children in drawing order: the tray's chips under the canvas, so a lifted element's
                 drop zone is drawn over them; the canvas; and the keyboard's type chips over it. -->
            <FrameLayout
                android:id="@+id/layout_editor_canvas_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- The restore tray (spec §3.6): one chip per hidden element, with the eye-off
                     glyph, that brings it back to the edge it left; one short line when nothing
                     is hidden. It stands over the canvas's own tray strip at the bottom, whose
                     height and bottom air LayoutEditorController copies from the canvas. -->
                <FrameLayout
                    android:id="@+id/layout_editor_tray"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp">

                    <HorizontalScrollView
                        android:id="@+id/layout_editor_tray_scroller"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/layout_editor_tray_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            app:chipSpacingHorizontal="8dp"
                            app:singleLine="true" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/layout_editor_tray_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/layout_editor_tray_empty"
                        android:textColor="?attr/termuxColorOnSurfaceVariant"
                        android:textSize="12sp" />
                </FrameLayout>

                <com.termux.app.fragments.settings.LayoutCanvasView
                    android:id="@+id/layout_editor_miniature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- The keyboard's type (spec §3.5): three glyph chips, one of them checked, shown
                     beside the keyboard's handle while the keyboard is selected and gone on
                     deselect. LayoutEditorController places the group from the canvas's frame. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/layout_editor_keyboard_forms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/layout_editor_keyboard_form_docked"
                        style="@style/Widget.Termux.LayoutEditor.KeyboardFormChip"
                        android:contentDescription="@string/settings_layout_keyboard_form_docked"
                        app:chipIcon="@drawable/ic_symbol_keyboard_docked" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/layout_editor_keyboard_form_floating"
                        style="@style/Widget.Termux.LayoutEditor.KeyboardFormChip"
                        android:contentDescription="@string/settings_layout_keyboard_form_floating"
                        app:chipIcon="@drawable/ic_symbol_keyboard_floating" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/layout_editor_keyboard_form_split"
                        style="@style/Widget.Termux.LayoutEditor.KeyboardFormChip"
                        android:contentDescription="@string/settings_layout_keyboard_form_split"
                        app:chipIcon="@drawable/ic_symbol_keyboard_split" />
                </com.google.android.material.chip.ChipGroup>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.termux.app.editorshell.EditorShellSheet>
