<?xml version="1.0" encoding="utf-8"?>
<!-- The Layout editor's card: a miniature of the place the user is looking at, with a Portrait /
     Landscape toggle above it, parked over the live place so the real thing stays visible behind.

     Everything else about the editor is the miniature itself — a bar is dragged to an edge or into
     the tray under the phone, and the write goes straight through. The header carries the whole
     chrome: the revert glyph and Discard appear only once something has moved, and ✓ is the way
     out that keeps it.

     The fill is opaque for the same reason the Appearance card's is: the card sits over the chrome
     it is moving, and a translucent one left neither edge reading as belonging to anything.

     The card is a sheet, the same one the Appearance editor's is (EditorShellSheet): the handle and
     the header stay put and everything under them — the toggle, the miniature, the Hidden tray and
     every row — is one list that scrolls in editor_shell_sheet_body. On a portrait screen it rests
     about a fifth of the screen down, so the place it is editing keeps its status strip and its
     chip row in view above it; a pull on the handle, the header or the list grows it toward the
     top inset before the list scrolls, and a firm pull down past rest closes it the way Back does. -->
<com.termux.app.editorshell.EditorShellSheet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_editor_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- The sheet's handle: the mark that says the card came up from the bottom edge. The view is
         the touch slot; the controller paints the 32x4 bar centred in it, and EditorShellSheet
         names it for a screen reader and makes a tap on it toggle the card's two heights. -->
    <View
        android:id="@+id/editor_shell_sheet_handle"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal" />

    <include
            layout="@layout/editor_shell_header" />

    <!-- The body: one scroller for everything under the header. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/editor_shell_sheet_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:theme="@style/ThemeOverlay.Termux.EditorShellScroller">

        <LinearLayout
            android:id="@+id/layout_editor_card_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- The shell's one chooser slot: the choice that changes what the whole card is
                 showing. Layout fills it with the orientation on the miniature, which moves the
                 picture and the target of the next drag, and never the place behind the card: an
                 orientation the phone is not in shows up there only once the phone is turned. It
                 is the list's first row and scrolls with it. -->
            <FrameLayout
                android:id="@+id/editor_shell_chooser_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layout_editor_orientation_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:orientation="horizontal">

                    <!-- No label: two segments that each say a phone and a word are the question
                         as well as the answer. The host is given its width in code, from the
                         shell's own segment metric, so the pill stays the size of its words on
                         any card. -->
                    <com.termux.app.editorshell.EditorShellControlHost
                        android:id="@+id/layout_editor_orientation_host"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/layout_editor_orientation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/layout_editor_orientation_portrait"
                                style="@style/Widget.Termux.EditorShell.Segment"
                                android:text="@string/settings_layout_orientation_portrait"
                                app:icon="@drawable/ic_symbol_phone_portrait"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/layout_editor_orientation_landscape"
                                style="@style/Widget.Termux.EditorShell.Segment"
                                android:text="@string/settings_layout_orientation_landscape"
                                app:icon="@drawable/ic_symbol_phone_landscape"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </com.termux.app.editorshell.EditorShellControlHost>
                </LinearLayout>
            </FrameLayout>

            <!-- The toggle can be left on the orientation the phone is not in, where the place
                 behind the card cannot follow the edit. LayoutEditorController shows this line
                 while that is so; its text never changes. -->
            <TextView
                android:id="@+id/layout_editor_orientation_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/termux_layout_editor_other_orientation_notice"
                android:textColor="?attr/termuxColorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- The arrangement's own cost, above the picture it is about: a narrow canvas from
                 bars down the side of a portrait screen, and a status bar itself parked on a side.
                 Neither blocks anything, both can apply at once, and
                 LayoutEditorController.syncNotice fills the text and visibility from the plan. -->
            <TextView
                android:id="@+id/layout_editor_narrow_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/termuxColorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- One column on a phone, with the rows under the picture; two beside each other
                 where the card is wide enough for a whole row on each side, which is what turns a
                 150px miniature marooned between two 550px gutters into a miniature that fills
                 its column with the rows beside it. LayoutEditorController flips the orientation. -->
            <LinearLayout
                android:id="@+id/layout_editor_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="vertical">

                <!-- The canvas. Its height is set in code from the orientation it is showing and
                     the card's width: the portrait frame stands at about two fifths of the
                     screen, the landscape one as wide as the card. It scrolls with the rows. -->
                <com.termux.app.fragments.settings.PlaceMiniatureView
                    android:id="@+id/layout_editor_miniature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Everything about the place that no bar can be dragged into: how its keyboard
                     stands, and on Home how many cells its grid has. Filled in code from
                     LayoutEditorPlan; the list around it is what scrolls. -->
                <LinearLayout
                    android:id="@+id/layout_editor_rows_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.termux.app.editorshell.EditorShellSheet>
