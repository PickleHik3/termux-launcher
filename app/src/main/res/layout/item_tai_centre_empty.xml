<?xml version="1.0" encoding="utf-8"?>
<!-- Model centre: what a segment says when it has no rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="20dp"
    android:paddingEnd="32dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tai_centre_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tai_centre_empty_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="12sp" />
</LinearLayout>
