<?xml version="1.0" encoding="utf-8"?>
<!-- One count row beneath the miniature — the widget grid's columns and rows. Label, track and
     number, the same three columns the appearance editor's number rows stand in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/layout_editor_row_label"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="12.5sp" />

    <SeekBar
        android:id="@+id/layout_editor_row_slider"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:splitTrack="false" />

    <TextView
        android:id="@+id/layout_editor_row_value"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="11.5sp" />
</LinearLayout>
