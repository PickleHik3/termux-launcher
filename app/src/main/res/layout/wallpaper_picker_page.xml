<?xml version="1.0" encoding="utf-8"?>
<!-- The Appearance surface's Overview (appearance-round-2026-10-04.md; it was the wallpaper picker
     page of lock-live-wallpaper.md, "The picker page"), modelled on
     project-docs/reference/lock-wallpaper/reference-nothing-picker.png. WallpaperPickerPage fills
     it; the surface adds it to the activity's content and sets the system bar insets as padding.

     Top to bottom:
       (no bar: back, the Wallpaper | Look | Layout pill and Done are the surface's shared frame,
         appearance_page_frame, around this page);
       a 4dp progress bar, invisible until Apply runs;
       the pager (the rest of the height): Lock then Home, each a small label ("Lock screen",
         "Home screen") over a card at the 360x800 aspect of the lock cutout, the neighbour peeking
         (WallpaperPickerPage sizes the cards, less the label, and the padding);
       the pager (the rest of the height): Lock then Home, cards at the 360x800 aspect, the
         height-driven size filling the room between the bar and the row below;
       one row: Apply (40) and its more icon (40) at the start, Motion at the end: the switch
         with the AI-star Read again, or (a photo with no living still) the Bring to life button,
         or the determinate bar with the stage and a cancel while it runs; INVISIBLE switch on Home
         so the row never jumps, the Motion cell GONE below API 34;
       the thumbnail strip card: Same as Home (Lock only) then up to five photos last applied
         (six tiles), in equal cells across the row (no heading, no pre-made backgrounds); each
         thumbnail is at most 112 tall and shrinks, aspect kept, so six fit the row's width
         (WallpaperPickerLogic.stripThumbSize), never clipped; then Photo… beside More settings
         (the old Look page).

     Fixed heights, dp: 4 + (8 + 48 + 4) + (4 + 12 + 112 + 4 + 48 + 4 + 16); the pager gets the rest.
     The page follows the locale's direction; the cards' content does not mirror. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wallpaper_picker_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/wallpaper_picker_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="invisible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wallpaper_picker_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Apply, under the cards: the filled button puts the centred card's background on Home and
         points Lock at it; the icon beside it opens Home screen only / Lock screen only. The bar
         with back, the pill and Done is the Appearance surface's shared frame, not this page's. -->
    <LinearLayout
        android:id="@+id/wallpaper_picker_apply_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallpaper_picker_apply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/wallpaper_picker_apply" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallpaper_picker_apply_more"
            style="?attr/materialIconButtonFilledStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:checkable="true"
            android:contentDescription="@string/wallpaper_picker_apply_more"
            android:tooltipText="@string/wallpaper_picker_apply_more"
            app:icon="@drawable/m3_split_button_chevron_avd"
            app:iconSize="24dp" />

        <!-- Motion: at the row's end, beside Apply. Its states (the switch with the sparkle,
             Bring to life, the working bar) fill this cell, end-aligned. -->
        <FrameLayout
            android:id="@+id/wallpaper_picker_motion_row"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

        <!-- The Motion switch with, for a living still, the small "Read again" beside it. -->
        <LinearLayout
            android:id="@+id/wallpaper_picker_motion_group"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/wallpaper_picker_motion"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:switchPadding="12dp"
                android:text="@string/wallpaper_picker_motion"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface" />

            <!-- Read again: the same analysis over the living still's own copy. An icon button
                 with the AI star, not a text one: the switch says what it is beside. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/wallpaper_picker_living_again"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/living_read_again"
                android:tooltipText="@string/living_read_again"
                android:visibility="gone"
                app:icon="@drawable/ic_symbol_ai_star"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- A photo with no living still yet: the Bring to life button (API 34+). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wallpaper_picker_living_offer"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/living_bring_to_life"
            android:visibility="gone"
            app:icon="@drawable/ic_symbol_bring_to_life"
            app:iconSize="24dp" />

        <!-- While the analysis runs: the stage, a determinate bar and a cancel. -->
        <LinearLayout
            android:id="@+id/wallpaper_picker_living_working"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wallpaper_picker_living_stage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/wallpaper_picker_living_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wallpaper_picker_living_cancel"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/living_cancel"
                android:tooltipText="@string/living_cancel"
                app:icon="@drawable/ic_symbol_close"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/wallpaper_picker_strip_card"
        style="@style/Widget.Termux.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <!-- Equal cells across the row, each tile centred in its share: evenly spaced. Thumbnails
                 shrink to fit six cells in this width (12dp side padding), so the 112dp is a maximum. -->
            <LinearLayout
                android:id="@+id/wallpaper_picker_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wallpaper_picker_photo"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/wallpaper_picker_photo"
                    app:icon="@drawable/ic_symbol_photo"
                    app:iconSize="24dp" />

                <!-- The old Look page, for everything this page does not carry. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wallpaper_picker_more_settings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/wallpaper_picker_more_settings" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
