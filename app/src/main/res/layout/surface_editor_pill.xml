<?xml version="1.0" encoding="utf-8"?>
<!-- The surface editor's attached pill. It carries one property at a time and parks next to the
     surface it edits, so nothing here scrolls and nothing here has a second level: the chip row
     names what this surface owns, the row under it is whichever chip is open, and the footnote says
     whether that value is the surface's own or Base's.

     Sizes are the full shape. The compact and one-row shapes are the same views with rows dropped
     and padding tightened, because the pill must stay usable when a system IME collapses the band
     it lives in (issue #20) — see SurfaceEditorPillMetrics.

     The fill is deliberately opaque rather than glass. The editor draws on top of the very surfaces
     it tunes; a translucent panel over them left neither edge reading as belonging to anything, and
     it cost the frame an extra realtime blur exactly while the user was judging one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/surface_editor_pill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/surface_editor_pill_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The surface being edited, and the way to reach one that is off screen. Tapping the
             surface itself is the primary gesture; this is the reachable equivalent. -->
        <TextView
            android:id="@+id/surface_editor_pill_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="?attr/termuxColorOnSurface"
            android:textSize="17sp" />

        <!-- The editor writes through to preferences so the preview is live, so "unsaved" is
             tracked against the snapshot taken on entry rather than a draft buffer. -->
        <TextView
            android:id="@+id/surface_editor_pill_dirty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:paddingHorizontal="6dp"
            android:text="@string/termux_surface_tuning_unsaved_badge"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Complete looks, plus the shared layer and Reset. Presets are chosen rarely, so they do
             not hold the top of the editor permanently. -->
        <TextView
            android:id="@+id/surface_editor_pill_looks"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingHorizontal="8dp"
            android:text="@string/termux_surface_editor_looks"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/surface_editor_pill_done"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/dock_tuning_done_pill"
            android:gravity="center"
            android:minWidth="66dp"
            android:paddingHorizontal="16dp"
            android:text="@string/termux_dock_tuning_done"
            android:textColor="?attr/termuxColorOnAccentContainer"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/surface_editor_pill_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/termux_dock_tuning_cancel"
            android:gravity="center"
            android:text="@string/termux_surface_editor_close"
            android:textColor="?attr/termuxColorOnSurfaceVariant"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- What this surface owns, plus a trailing ⋯ for the rest of it. Wraps onto a second line
         rather than scrolling: a chip that has to be scrolled to is a chip nobody finds. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/surface_editor_pill_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="2dp"
        app:selectionRequired="true"
        app:singleLine="false"
        app:singleSelection="true" />

    <!-- Look: the glass triple said as one decision. Blur, opacity and grain are still editable
         raw, behind Fine, but they are no longer the first thing the editor shows — which is the
         change that removed the scrolling. -->
    <LinearLayout
        android:id="@+id/surface_editor_pill_look"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/surface_editor_pill_material"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_material_solid"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minHeight="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/termux_surface_tuning_material_solid"
                android:textSize="12sp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_material_glass"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minHeight="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/termux_surface_tuning_material_glass"
                android:textSize="12sp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_material_frost"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minHeight="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/termux_surface_tuning_material_frost"
                android:textSize="12sp"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/surface_editor_pill_look_fine"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingHorizontal="6dp"
                android:text="@string/termux_surface_editor_fine"
                android:textColor="?attr/termuxColorPrimary"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Docked and Floating resolve the dock's geometry differently and always have; the
                 choice is the dock's own, which is why it lives inside the dock's Look. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/surface_editor_pill_shape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/surface_editor_pill_shape_docked"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="32dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/termux_app_launcher_dock_style_default"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/surface_editor_pill_shape_floating"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="32dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/termux_app_launcher_dock_style_rounded"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- The one open row. Whichever chip is active points this at its own value; the pill may lose
         every other row but never this one. -->
    <LinearLayout
        android:id="@+id/surface_editor_pill_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Only drawn in the one-row shape, where it replaces the chip row entirely. -->
        <TextView
            android:id="@+id/surface_editor_pill_property"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:maxWidth="124dp"
            android:paddingEnd="6dp"
            android:textColor="?attr/termuxColorOnSurface"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/surface_editor_pill_slider"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:splitTrack="false" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/surface_editor_pill_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/surface_editor_pill_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="54dp"
            android:textColor="?attr/termuxColorOnSurfaceVariant"
            android:textSize="15sp" />

        <!-- Both states render: muted while the value follows Base, accented once the surface has
             its own — and then it is the way back. -->
        <TextView
            android:id="@+id/surface_editor_pill_reset"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/termux_surface_tuning_link_detached"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/surface_editor_pill_footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="12.5sp" />
</LinearLayout>
