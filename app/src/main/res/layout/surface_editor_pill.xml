<?xml version="1.0" encoding="utf-8"?>
<!-- The surface editor's card. Parked in the free room between the launcher's own chrome, never
     over the surface it is editing, and not on screen at all until asked for: the editor rests as
     the outlines plus surface_editor_float.xml, and the card is what either of those opens.

     The floating palette opens it on the shared layer: the presets, the two style pills, and the
     handful of numbers that move everything at once. Touching a surface on the home screen opens it
     on that surface — or slides it there if it is already up — and swaps the body for that surface's
     own rows: same rows, same order, the inapplicable ones dropped.

     Nothing here is a second level: the header's glyphs are the whole chrome, and the body is a
     plain list that scrolls inside its own cap when a raised keyboard shortens the room (issue #20).

     The fill is deliberately opaque rather than glass. The editor draws on top of the very surfaces
     it tunes; a translucent panel over them left neither edge reading as belonging to anything, and
     it cost the frame an extra realtime blur exactly while the user was judging one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/surface_editor_pill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <include
        layout="@layout/editor_shell_header" />

    <!-- The shell's one chooser slot: the choice that changes what the whole card is showing.
         Appearance fills it with the preset strip — complete looks, one tap each, on the shared
         layer only, because a preset writes every surface and that is not an answer to a question
         asked while editing one of them. It is pinned only while the body can afford it; below
         that the strip becomes the body's first row and scrolls with it. -->
    <FrameLayout
        android:id="@+id/editor_shell_chooser_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/surface_editor_pill_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp" />
    </FrameLayout>

    <!-- The two decisions that shape everything: how the surfaces sit, and what they are made
         of. One question per line: five equal segments on one line read as one five-way choice,
         and Docked / Floating is asked far less often than Solid / Glass / Frost.

         Both rows stand in the body under their own sections — Shape leads Shape, Material leads
         Material — so this is where they wait while the card is showing a single surface, which
         has neither. It is never drawn. -->
    <LinearLayout
        android:id="@+id/surface_editor_pill_pills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/surface_editor_pill_shape_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/editor_shell_row_label"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/termux_surface_editor_shape"
                android:textColor="?attr/termuxColorOnSurface"
                android:textSize="14sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />

            <com.termux.app.editorshell.EditorShellControlHost
                android:id="@+id/surface_editor_pill_shape_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/surface_editor_pill_shape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/surface_editor_pill_shape_docked"
                        style="@style/Widget.Termux.EditorShell.Segment"
                        android:text="@string/termux_app_launcher_dock_style_default" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/surface_editor_pill_shape_floating"
                        style="@style/Widget.Termux.EditorShell.Segment"
                        android:text="@string/termux_app_launcher_dock_style_rounded" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </com.termux.app.editorshell.EditorShellControlHost>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/surface_editor_pill_material_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/editor_shell_row_label"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/termux_surface_editor_material"
                android:textColor="?attr/termuxColorOnSurface"
                android:textSize="14sp"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />

            <com.termux.app.editorshell.EditorShellControlHost
                android:id="@+id/surface_editor_pill_material_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/surface_editor_pill_material"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="false"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/surface_editor_pill_material_solid"
                        style="@style/Widget.Termux.EditorShell.Segment"
                        android:text="@string/termux_surface_tuning_material_solid" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/surface_editor_pill_material_glass"
                        style="@style/Widget.Termux.EditorShell.Segment"
                        android:text="@string/termux_surface_tuning_material_glass" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/surface_editor_pill_material_frost"
                        style="@style/Widget.Termux.EditorShell.Segment"
                        android:text="@string/termux_surface_tuning_material_frost" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </com.termux.app.editorshell.EditorShellControlHost>
        </LinearLayout>
    </LinearLayout>

    <!-- The rows of whatever the card is showing. A scroller is added here in code so its height
         can be capped to the room the region has left; the card must never grow past the surfaces
         bounding it, and a list too tall for the room scrolls rather than pushing them off. -->
    <FrameLayout
        android:id="@+id/surface_editor_pill_rows_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
