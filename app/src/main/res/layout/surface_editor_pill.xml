<?xml version="1.0" encoding="utf-8"?>
<!-- The surface editor's panel. One card, parked in the free room between the launcher's own
     chrome, never over the surface it is editing.

     It opens on the shared layer: the presets, the two style pills, and the handful of numbers that
     move everything at once. Touching a surface on the home screen slides the card to it and swaps
     the body for that surface's own rows — same rows, same order, the inapplicable ones dropped.

     Nothing here is a second level: the header's four glyphs are the whole chrome, and the body is a
     plain list that scrolls inside its own cap when a raised keyboard shortens the room (issue #20).

     The fill is deliberately opaque rather than glass. The editor draws on top of the very surfaces
     it tunes; a translucent panel over them left neither edge reading as belonging to anything, and
     it cost the frame an extra realtime blur exactly while the user was judging one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/surface_editor_pill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/surface_editor_pill_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Names what the card is showing: "Presets" on the shared layer, the surface's own name
             once one is picked — and there it wears a back glyph and is the way out again. -->
        <TextView
            android:id="@+id/surface_editor_pill_title"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="?attr/termuxColorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Save and revert only exist once there is something to save or revert; the two of them
             appearing together is also how the card says the edit is unsaved. Icons set in code. -->
        <ImageView
            android:id="@+id/surface_editor_pill_save"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/termux_surface_editor_save_look"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/surface_editor_pill_reset"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/termux_surface_editor_revert"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Done is the only commit; ✕ and the back press both route through the unsaved gate. -->
        <ImageView
            android:id="@+id/surface_editor_pill_done"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/dock_tuning_done_pill"
            android:contentDescription="@string/termux_dock_tuning_done"
            android:padding="7dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/surface_editor_pill_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/termux_dock_tuning_cancel"
            android:padding="8dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Said once, and only until the user acts on it: the outlines breathing on the home screen
         are the invitation, and this is the sentence for anyone who does not read a pulse as one.
         Gone for good the first time a surface is picked. -->
    <TextView
        android:id="@+id/surface_editor_pill_tap_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="6dp"
        android:lineSpacingExtra="1sp"
        android:text="@string/termux_surface_editor_tap_hint"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Complete looks, one tap each, filled in code. The shared layer only: a preset writes every
         surface, which is not an answer to a question asked while editing one of them. -->
    <FrameLayout
        android:id="@+id/surface_editor_pill_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The two decisions that shape everything: how the surfaces sit, and what they are made of.
         Docked / Floating is the shorter of the two because it is the smaller question. -->
    <LinearLayout
        android:id="@+id/surface_editor_pill_pills"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/surface_editor_pill_shape"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="5"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_shape_docked"
                style="@style/Widget.Termux.SurfaceEditor.Segment"
                android:text="@string/termux_app_launcher_dock_style_default" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_shape_floating"
                style="@style/Widget.Termux.SurfaceEditor.Segment"
                android:text="@string/termux_app_launcher_dock_style_rounded" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/surface_editor_pill_material"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            app:selectionRequired="false"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_material_solid"
                style="@style/Widget.Termux.SurfaceEditor.Segment"
                android:text="@string/termux_surface_tuning_material_solid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_material_glass"
                style="@style/Widget.Termux.SurfaceEditor.Segment"
                android:text="@string/termux_surface_tuning_material_glass" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/surface_editor_pill_material_frost"
                style="@style/Widget.Termux.SurfaceEditor.Segment"
                android:text="@string/termux_surface_tuning_material_frost" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- The rows of whatever the card is showing. A scroller is added here in code so its height
         can be capped to the room the region has left; the card must never grow past the surfaces
         bounding it, and a list too tall for the room scrolls rather than pushing them off. -->
    <FrameLayout
        android:id="@+id/surface_editor_pill_rows_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
