<?xml version="1.0" encoding="utf-8"?>
<!-- The layout canvas over the Appearance editor's frame: the same rect the scaled launcher stands
     in, clipped at the same device radius. SurfaceEditorController shows it while the frame shows
     the other orientation, and while a surface held in the frame is being dragged;
     LayoutEditorController drives what is in it.

     The canvas's phone outline is this view's own bounds (LayoutCanvasView.setFillsView). It is
     spatial and stays left to right in every locale (the launcher shell is pinned LTR). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_editor_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="false"
    android:layoutDirection="ltr"
    android:visibility="gone">

    <com.termux.app.fragments.settings.LayoutCanvasView
        android:id="@+id/layout_editor_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
