<?xml version="1.0" encoding="utf-8"?>
<!-- Layout mode's frame (appearance-layout-editor SPEC §3.5, layout editor v2): the layout canvas at
     the full size of the editor's frame, the same rect the scaled launcher stands in, clipped at the
     same device radius. SurfaceEditorController places it over the scaled launcher and cross-fades
     between the two when the mode pill moves; LayoutEditorController drives what is in it.

     Layout is not a miniature: the canvas's phone outline is this view's own bounds
     (LayoutCanvasView.setFillsView), and the eye-off control a lifted bar is dropped on to hide it
     stands in the bottom area.

     The canvas is spatial and stays left to right in every locale (the launcher shell is pinned
     LTR); what stands over it is placed in code from the canvas's own rects.

     Children in drawing order:
       - the canvas;
       - the move control (DECISIONS items 4 and 5): a 48dp icon button standing outside the
         selected bar, whose menu sends the bar to an edge or hides it. Shown while a movable
         element is selected;
       - the keyboard's tools (DECISIONS item 6): the three type chips and, under them, Key radius,
         on one tonal card above the keyboard while it is selected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_editor_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="false"
    android:layoutDirection="ltr"
    android:visibility="gone">

    <com.termux.app.fragments.settings.LayoutCanvasView
        android:id="@+id/layout_editor_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/layout_editor_move"
        style="?attr/materialIconButtonFilledTonalStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:contentDescription="@string/layout_editor_move_description"
        android:tooltipText="@string/layout_editor_move_description"
        android:visibility="gone"
        app:icon="@drawable/ic_layout_move"
        app:iconSize="24dp" />

    <LinearLayout
        android:id="@+id/layout_editor_keyboard_tools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layoutDirection="locale"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/layout_editor_keyboard_forms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="4dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/layout_editor_keyboard_form_docked"
                style="@style/Widget.Termux.LayoutEditor.KeyboardFormChip"
                android:contentDescription="@string/settings_layout_keyboard_form_docked"
                app:chipIcon="@drawable/ic_symbol_keyboard_docked"
                app:chipIconSize="24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/layout_editor_keyboard_form_floating"
                style="@style/Widget.Termux.LayoutEditor.KeyboardFormChip"
                android:contentDescription="@string/settings_layout_keyboard_form_floating"
                app:chipIcon="@drawable/ic_symbol_keyboard_floating"
                app:chipIconSize="24dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/layout_editor_keyboard_form_split"
                style="@style/Widget.Termux.LayoutEditor.KeyboardFormChip"
                android:contentDescription="@string/settings_layout_keyboard_form_split"
                app:chipIcon="@drawable/ic_symbol_keyboard_split"
                app:chipIconSize="24dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Key radius: the key caps' radius, moved here from Look mode (DECISIONS item 6). -->
        <TextView
            android:id="@+id/layout_editor_key_radius_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.slider.Slider
            android:id="@+id/layout_editor_key_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/layout_editor_key_radius_description"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="24"
            app:labelBehavior="gone"
            app:tickVisibilityMode="hidden" />
    </LinearLayout>
</FrameLayout>
