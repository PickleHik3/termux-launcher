<?xml version="1.0" encoding="utf-8"?>
<!-- The Icon pack controls (Icons mode of the Appearance editor), living in the editor's bottom
     sheet under the real launcher: the row of round pack tiles (Default, then the installed
     packs; IconPackPage adds the tiles) and one rounded container holding the Pinned app icons
     only switch. The sheet supplies the 16dp side padding, its surface and the navigation inset,
     so there is no background and no scrolling here; the sheet is as tall as this content.

     Height, dp: tiles 4 + 64 + 6 + label (up to two LabelMedium lines, ~32) + 4 = ~110, then
     12 + the 64dp switch card = ~186 (the slot adds 8 above, the sheet 16 below). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/icon_pack_page"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/icon_pack_tiles_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/icon_pack_tiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/icon_pack_pinned_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/icon_pack_page_pinned_only"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
