<?xml version="1.0" encoding="utf-8"?>
<!-- The Icon pack page (appearance-round-2026-10-04.md, "Icons page"), modelled on Nothing OS's
     icon pack page. IconPackPage fills it; the host supplies the top bar and the system bar
     insets, so there is no title bar here.

     Top to bottom: the phone-shaped Home preview (a 9:16 card, 188 x 334dp, the Home still behind
     the pinned apps' icons in the chosen pack), the row of round pack tiles (Default, then the
     installed packs; IconPackPage adds the tiles), and one rounded container holding the
     Pinned app icons only switch. The page scrolls when the screen is short. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/icon_pack_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:layoutDirection="locale"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_pack_preview"
            android:layout_width="188dp"
            android:layout_height="334dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/icon_pack_page_preview_description"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/icon_pack_preview_still"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:id="@+id/icon_pack_preview_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:id="@+id/icon_pack_tiles_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/icon_pack_tiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/icon_pack_pinned_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/icon_pack_page_pinned_only"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
