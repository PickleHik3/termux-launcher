<?xml version="1.0" encoding="utf-8"?>
<!-- The Live half of the wallpaper picker: the five scenes in two columns (LiveScenePickerPage
     adds the tiles), and one line saying what Live needs. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_picker_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/settings_gutter"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/live_scenes_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="8dp"
            android:accessibilityHeading="true"
            android:text="@string/live_scenes_heading"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <GridLayout
            android:id="@+id/live_scene_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_app_menu_info"
                android:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/live_needs_android_13"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
