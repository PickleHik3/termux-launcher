<?xml version="1.0" encoding="utf-8"?>
<!-- The Appearance / Layout editor's bottom area (appearance-layout-editor SPEC §3.1–3.6): a
     non-modal M3 sheet docked at the foot of android.R.id.content. AppearanceEditorPanel paints
     its fill (colorSurfaceContainer) and its top corners (shapeAppearanceCornerExtraLarge);
     SurfaceEditorController adds the navigation inset to the bottom padding and sets the height,
     which is AppearanceEditorPanel.measureFor(mode): one fixed height per mode, measured from the
     rows that mode shows. Nothing in it scrolls, and nothing in it is weighted.

     One ConstraintLayout. The top row is both modes'; each mode's rows are a Group
     (appearance_editor_appearance_group / appearance_editor_layout_group), and a mode switch
     shows one Group and hides the other.

     Top row: the mode pill is the start anchor (wrap_content, never squeezed); Done is pinned to
     the end and Undo to Done's start. Undo is GONE while there is nothing to undo; the gap between
     the pill and Undo absorbs it, so neither the pill nor Done moves.

     Appearance rows. Row A: the Look slider, a label centred under each of its five stops (placed
     in code: the stops sit inside the slider's track padding, so equal-width labels would drift
     off them). Row B: the tapped element's name and up to three equal columns, each a label above
     its control. Row B is GONE until an element is tapped: the sheet's height follows its content
     (Row A alone, or Row A + Row B), the controller animates between the two, and the frame stands
     above the taller of the two so it never moves. The labels may wrap to two lines ("Contrast ·
     Normal" in a third of a phone's width); a Barrier under them keeps the sliders level.

     Layout rows. Row A: Orientation (two 48dp icon segments), Style (two 48dp icon segments), and
     the trash at the end (drop target, opens the hidden list, carries the count badge). Row B:
     Corner radius and Margin as two equal columns, each a label above its slider.

     Width arithmetic, dp. Sheet padding 16 + 16, so the content width is W - 32.
       Top row (LabelLarge 14sp, Roboto Medium): "Look" ≈ 30, "Layout" ≈ 43. A segment is
       12 pad + 18 check slot + 4 icon padding + text + 12 pad, minWidth 0: 76 + 89 = 165 for the
       pill. Widget.Termux.Button.Segment pads all four sides 12dp: Material 3's OutlinedButton
       sets paddingLeft/Right 24dp, which beat a paddingStart/End beside them and made every text
       segment 32dp too wide.
       Undo 48 (its own 4dp insets are the visual gaps on either side of it).
       Done (Widget.Material3.Button, minWidth 0 over AppCompat's 88): 24 + "Done" ≈ 33 + 24 = 81.
         360: 16 + 165 + 0 + 48 + 0 + 81 + 16 = 326 ≤ 360  (34 spare, in the pill → Undo gap)
         411: 326 + 85 of gap;  533: 326 + 207 of gap.  Clean (Undo gone): 48 more gap.
       Appearance Row A: the slider spans W - 32 (328 / 379 / 501); five LabelMedium words, the
         widest "Custom" ≈ 44, under stops (W - 32 - 2 × track padding) / 4 apart: ≥ 70 at 360.
       Appearance Row B: three columns, two 16dp gaps: (W - 64) / 3 = 98.7 / 115.7 / 156.3;
         two columns: (W - 48) / 2 = 156 / 181.5 / 242.5; one column: W - 32.
         The Soften toggle in a 156dp column: Off 12 + 18 + 4 + 20 + 12 = 66, On 66: 132 ≤ 156.
       Layout Row A: 96 + 8 + 96 + gap + 48 = 248 + gap; gap 80 / 131 / 253.
       Layout Row B: two columns, one 16dp gap: 156 / 181.5 / 242.5; "Corner radius · 40 dp"
         (LabelMedium) ≈ 120 ≤ 156.

     Heights, dp, without the navigation inset (the controller adds it to the bottom padding):
       top row 48 (every button keeps its 48dp touch height).
       Appearance: 12 + 48 + 8 + Row A (slider 48 + labels 16 = 64) + 8
                   + Row B (name 20 + 4 + label 2 × 16 + control 48 = 104) + 16 = 260.
       Layout:     12 + 48 + 8 + Row A 48 + 8 + Row B (label 16 + slider 48 = 64) + 16 = 204.
     The controller uses the measured heights, not these numbers. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appearance_editor_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="false"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- ===================================================================== top row -->

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/appearance_editor_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/appearance_editor_mode_description"
        app:checkedButton="@+id/appearance_editor_mode_appearance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_editor_mode_appearance"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:ellipsize="none"
            android:text="@string/appearance_editor_mode_look" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_editor_mode_layout"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:ellipsize="none"
            android:text="@string/action_layout_editor" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appearance_editor_undo"
        style="?attr/materialIconButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/appearance_editor_undo"
        android:tooltipText="@string/appearance_editor_undo"
        android:visibility="gone"
        app:icon="@drawable/ic_symbol_undo"
        app:layout_constraintBottom_toBottomOf="@id/appearance_editor_mode"
        app:layout_constraintEnd_toStartOf="@id/appearance_editor_done"
        app:layout_constraintTop_toTopOf="@id/appearance_editor_mode" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appearance_editor_done"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:maxLines="1"
        android:text="@string/appearance_editor_done"
        app:layout_constraintBottom_toBottomOf="@id/appearance_editor_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/appearance_editor_mode" />

    <!-- ============================================================ Appearance mode -->

    <com.google.android.material.slider.Slider
        android:id="@+id/appearance_editor_look"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/appearance_editor_look_description"
        android:stepSize="1"
        android:value="4"
        android:valueFrom="0"
        android:valueTo="4"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appearance_editor_mode"
        app:tickVisibilityMode="hidden" />

    <!-- One label per stop, centred under it in code. -->
    <FrameLayout
        android:id="@+id/appearance_editor_look_labels"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appearance_editor_look" />

    <!-- Row B: its own ConstraintLayout, so the columns' per-element visibility is not the
         Appearance group's to restate. GONE until an element is tapped (see the header). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appearance_editor_row2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appearance_editor_look_labels">

        <TextView
            android:id="@+id/appearance_editor_row2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Up to three equal columns: three labels in one chain, and under them a Barrier that
             the three controls hang from, so the sliders line up whichever label wraps. The
             16dp gaps sit on the end of c1 and cl, so whichever of c1 / cl is gone, the visible
             columns keep one gap between them: c1's goneMarginEnd keeps it when cl is gone, and
             c2 has no start margin. A column's views are shown and hidden together in code. -->
        <TextView
            android:id="@+id/appearance_editor_c1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@id/appearance_editor_cl_label"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_name"
            app:layout_goneMarginEnd="16dp" />

        <!-- The terminal's Contrast: its palette's contrast (SPEC §2, §3.4). -->
        <TextView
            android:id="@+id/appearance_editor_cl_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="1"
            android:text="@string/appearance_editor_legibility_normal"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/appearance_editor_c2_label"
            app:layout_constraintStart_toEndOf="@id/appearance_editor_c1_label"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_name" />

        <TextView
            android:id="@+id/appearance_editor_c2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/appearance_editor_cl_label"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_name" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/appearance_editor_row2_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="appearance_editor_c1_label,appearance_editor_cl_label,appearance_editor_c2_label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/appearance_editor_c1_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/appearance_editor_control_description"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="100"
            app:labelBehavior="gone"
            app:layout_constraintEnd_toEndOf="@id/appearance_editor_c1_label"
            app:layout_constraintStart_toStartOf="@id/appearance_editor_c1_label"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_barrier"
            app:tickVisibilityMode="hidden" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/appearance_editor_c1_soft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/appearance_editor_soft"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/appearance_editor_c1_label"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_barrier"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appearance_editor_soft_off"
                style="@style/Widget.Termux.Button.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/appearance_editor_soft_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appearance_editor_soft_on"
                style="@style/Widget.Termux.Button.Segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/appearance_editor_soft_on" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.slider.Slider
            android:id="@+id/appearance_editor_legibility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/appearance_editor_legibility_description"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="2"
            android:visibility="gone"
            app:labelBehavior="gone"
            app:layout_constraintEnd_toEndOf="@id/appearance_editor_cl_label"
            app:layout_constraintStart_toStartOf="@id/appearance_editor_cl_label"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_barrier"
            app:tickVisibilityMode="hidden" />

        <com.google.android.material.slider.Slider
            android:id="@+id/appearance_editor_c2_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/appearance_editor_control_description"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="100"
            app:labelBehavior="gone"
            app:layout_constraintEnd_toEndOf="@id/appearance_editor_c2_label"
            app:layout_constraintStart_toStartOf="@id/appearance_editor_c2_label"
            app:layout_constraintTop_toBottomOf="@id/appearance_editor_row2_barrier"
            app:tickVisibilityMode="hidden" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Group
        android:id="@+id/appearance_editor_appearance_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="appearance_editor_look,appearance_editor_look_labels" />

    <!-- ================================================================ Layout mode -->

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/layout_editor_orientation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/termux_layout_editor_orientation"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appearance_editor_mode"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layout_editor_orientation_portrait"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="@string/settings_layout_orientation_portrait"
            android:tooltipText="@string/settings_layout_orientation_portrait"
            app:icon="@drawable/ic_symbol_phone_portrait"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layout_editor_orientation_landscape"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="@string/settings_layout_orientation_landscape"
            android:tooltipText="@string/settings_layout_orientation_landscape"
            app:icon="@drawable/ic_symbol_phone_landscape"
            app:iconPadding="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/appearance_editor_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/appearance_editor_style_description"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/layout_editor_orientation"
        app:layout_constraintTop_toTopOf="@id/layout_editor_orientation"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_editor_style_docked"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="@string/appearance_editor_style_docked"
            android:tooltipText="@string/appearance_editor_style_docked"
            app:icon="@drawable/ic_style_docked"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_editor_style_floating"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:contentDescription="@string/appearance_editor_style_floating"
            android:tooltipText="@string/appearance_editor_style_floating"
            app:icon="@drawable/ic_style_floating"
            app:iconPadding="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- The trash: the drop target a lifted bar is put away in (LayoutEditorController tells the
         canvas this button's rect), and a tap lists what is hidden. Its count badge is attached
         to this button, after it is laid out. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/layout_editor_tray_trash"
        style="?attr/materialIconButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/layout_editor_trash_empty"
        android:visibility="gone"
        app:icon="@drawable/ic_symbol_delete"
        app:layout_constraintBottom_toBottomOf="@id/layout_editor_orientation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_editor_orientation" />

    <TextView
        android:id="@+id/appearance_editor_corners_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/appearance_editor_margin_label"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_editor_orientation" />

    <TextView
        android:id="@+id/appearance_editor_margin_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/appearance_editor_corners_label"
        app:layout_constraintTop_toTopOf="@id/appearance_editor_corners_label" />

    <!-- Under the two labels: the sliders hang from it, so they line up whichever label wraps. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/appearance_editor_layout_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="appearance_editor_corners_label,appearance_editor_margin_label" />

    <com.google.android.material.slider.Slider
        android:id="@+id/appearance_editor_corners"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/appearance_editor_corners_description"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="40"
        android:visibility="gone"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="@id/appearance_editor_corners_label"
        app:layout_constraintStart_toStartOf="@id/appearance_editor_corners_label"
        app:layout_constraintTop_toBottomOf="@id/appearance_editor_layout_barrier"
        app:tickVisibilityMode="hidden" />

    <com.google.android.material.slider.Slider
        android:id="@+id/appearance_editor_margin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/appearance_editor_margin_description"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="48"
        android:visibility="gone"
        app:labelBehavior="gone"
        app:layout_constraintEnd_toEndOf="@id/appearance_editor_margin_label"
        app:layout_constraintStart_toStartOf="@id/appearance_editor_margin_label"
        app:layout_constraintTop_toBottomOf="@id/appearance_editor_layout_barrier"
        app:tickVisibilityMode="hidden" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/appearance_editor_layout_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="layout_editor_orientation,appearance_editor_style,layout_editor_tray_trash,appearance_editor_corners_label,appearance_editor_margin_label,appearance_editor_corners,appearance_editor_margin" />
</androidx.constraintlayout.widget.ConstraintLayout>
