<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingStart="@dimen/settings_gutter"
    android:paddingTop="@dimen/settings_space_s"
    android:paddingEnd="@dimen/settings_gutter"
    android:paddingBottom="@dimen/settings_space_s">

    <requestFocus />

    <com.google.android.material.textfield.TextInputLayout
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:endIconMode="clear_text"
        app:hintTextColor="?attr/colorPrimary"
        app:shapeAppearance="?attr/shapeAppearanceCornerFull"
        app:startIconContentDescription="@null"
        app:startIconDrawable="@drawable/ic_symbol_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/settings_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
