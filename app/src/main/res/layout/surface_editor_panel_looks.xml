<?xml version="1.0" encoding="utf-8"?>
<!-- The Looks panel: complete looks, the shared layer behind them, and Reset.

     These three belong together and none of them belongs on the pill's standing rows. A preset is
     chosen rarely, so it should not hold the top of the editor permanently; Base is the layer every
     surface inherits until a property is detached, so it is the one place that means "change
     everything"; and Reset is Base taken all the way back. Expands inside the editor card itself —
     see the panel host in surface_editor_pill.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="@string/termux_surface_tuning_presets_section"
            android:textAllCaps="true"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Pins the live look into the Custom slot. Its own action rather than a side effect of
             Done: Done commits the edit, which happens every time the editor closes, and a pin
             that every exit overwrote would not be a pin. Icon set in code. -->
        <TextView
            android:id="@+id/surface_editor_looks_save"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/termux_surface_editor_save_look"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/surface_editor_looks_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="@string/termux_surface_editor_all_surfaces"
            android:textAllCaps="true"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Icon set in code. -->
        <TextView
            android:id="@+id/surface_editor_looks_reset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/termux_surface_editor_reset_all"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/termux_surface_editor_all_surfaces_summary"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/surface_editor_looks_material"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:selectionRequired="false"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/surface_editor_looks_material_solid"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/termux_surface_tuning_material_solid"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/surface_editor_looks_material_glass"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/termux_surface_tuning_material_glass"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/surface_editor_looks_material_frost"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/termux_surface_tuning_material_frost"
            android:textSize="12sp"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Intensity, then Base's own corner radius and margin, all generated into here. -->
    <LinearLayout
        android:id="@+id/surface_editor_looks_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
