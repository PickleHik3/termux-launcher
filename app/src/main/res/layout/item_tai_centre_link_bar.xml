<?xml version="1.0" encoding="utf-8"?>
<!-- Model centre, top: paste a Hugging Face link and Add, or pick a File. The MNN folder import
     sits behind the trailing overflow button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/tai_centre_link_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tai_centre_link_bar"
        android:gravity="center_vertical"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp">

        <EditText
            android:id="@+id/tai_centre_link_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="@string/tai_centre_link_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="36dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/termuxColorOnSurface"
            android:textColorHint="?attr/termuxColorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tai_centre_link_file"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/tai_centre_pill"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:clickable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/tai_centre_link_file"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tai_centre_link_add"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/tai_centre_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/tai_centre_link_add"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/tai_centre_link_more"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/tai_centre_round"
            android:contentDescription="@string/tai_centre_link_more"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tai_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/tai_centre_link_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="?attr/termuxColorError"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
