<?xml version="1.0" encoding="utf-8"?>
<!-- Model centre: the Functions | Installed | Get models segmented button. It switches which list the
     screen shows (a filter over one surface), so it is a segmented control, not tab navigation. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.termux.app.fragments.settings.termux.TaiSegmentedTabs
        android:id="@+id/tai_centre_segments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/tai_fn_segments_desc" />
</FrameLayout>
