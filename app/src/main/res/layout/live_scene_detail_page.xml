<?xml version="1.0" encoding="utf-8"?>
<!-- One scene's page (LiveSceneDetailPage), under the sheet's bar: its name and one fact, a
     preview that follows the knobs, the knobs (Density and Colour only for scenes that have
     them), "Also set as phone wallpaper" in terminal-app mode only, Use as wallpaper, Back to
     photo while a scene is in use, and the lock screen note. The knobs reuse the settings rows
     (preference_settings_seekbar, preference_segmented_pill). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/live_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/live_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:paddingStart="@dimen/settings_gutter"
                android:paddingEnd="@dimen/settings_gutter"
                android:paddingTop="4dp"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/live_detail_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/settings_gutter"
                android:paddingEnd="@dimen/settings_gutter"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp">

                <com.termux.app.chrome.wallpaper.LiveAspectFrame
                    android:id="@+id/live_detail_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="?attr/colorSurfaceContainerHighest">

                    <com.termux.app.chrome.scene.SceneThumbView
                        android:id="@+id/live_detail_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.termux.app.chrome.wallpaper.LiveAspectFrame>
            </FrameLayout>

            <include
                android:id="@+id/live_knob_speed"
                layout="@layout/preference_settings_seekbar" />

            <include
                android:id="@+id/live_knob_rate"
                layout="@layout/preference_segmented_pill" />

            <include
                android:id="@+id/live_knob_density"
                layout="@layout/preference_settings_seekbar" />

            <LinearLayout
                android:id="@+id/live_knob_colour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/settings_gutter"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/settings_gutter"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/live_knob_colour_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_knob_colour"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/live_palette_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="@dimen/settings_space_xs"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>

            <!-- Terminal-app mode only: the same remembered setting as the Photo page's. -->
            <LinearLayout
                android:id="@+id/live_also_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/settings_gutter"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/live_also_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wallpaper_picker_also_set_phone"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/live_also_phone_hint"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/live_also_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/live_detail_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginStart="@dimen/settings_gutter"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/settings_gutter"
                android:indeterminate="true"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/live_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_gutter"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/settings_gutter"
                android:minHeight="48dp"
                android:text="@string/live_use" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/live_back_to_photo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_gutter"
                android:layout_marginEnd="@dimen/settings_gutter"
                android:minHeight="48dp"
                android:text="@string/live_back_to_photo"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/settings_gutter">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_app_menu_info"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/live_lock_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
