<?xml version="1.0" encoding="utf-8"?>
<!-- Model centre section header: a small caps title with a dim fact at the end ("12.4 GB free"),
     and an optional second line (the download slots). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="22dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tai_centre_section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tai_centre_section_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/termuxColorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tai_centre_section_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="10.5sp"
        android:visibility="gone" />
</LinearLayout>
