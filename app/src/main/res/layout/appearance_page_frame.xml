<?xml version="1.0" encoding="utf-8"?>
<!-- A sub-page of the Appearance surface (Icon pack, Look, Layout): the Overview's top bar (back,
     the title straight after it, then the page's end actions) over the page's own content. Undo
     and Done are gone unless the page asks for them (Look and Layout do). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:layoutDirection="locale"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_page_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/wallpaper_picker_back"
            android:tooltipText="@string/wallpaper_picker_back"
            app:icon="@drawable/ic_symbol_arrow_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/appearance_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <!-- 48dp tall, as every icon button in the bar: it appears and goes with the dirty state. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_page_undo"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/appearance_editor_undo"
            android:tooltipText="@string/appearance_editor_undo"
            android:visibility="gone"
            app:icon="@drawable/ic_symbol_undo"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearance_page_done"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:maxLines="1"
            android:text="@string/appearance_editor_done"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/appearance_page_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
