<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:id="@+id/layout_overview_places_track"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/settings_segmented_pill_track"
        android:padding="3dp">

        <View
            android:id="@+id/layout_overview_places_indicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/settings_segmented_pill_indicator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/layout_overview_tab_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/settings_layout_tab_home"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/layout_overview_tab_terminal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/settings_layout_tab_terminal"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/layout_overview_tab_display"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/settings_layout_tab_display"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layout_overview_orientation_track"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/settings_segmented_pill_track"
        android:padding="3dp">

        <View
            android:id="@+id/layout_overview_orientation_indicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/settings_segmented_pill_indicator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/layout_overview_orientation_portrait"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/settings_layout_orientation_portrait"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/layout_overview_orientation_landscape"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/settings_layout_orientation_landscape"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <com.termux.app.fragments.settings.PlaceMiniatureView
        android:id="@+id/layout_overview_miniature"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:layout_marginTop="14dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
