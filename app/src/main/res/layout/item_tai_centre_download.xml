<?xml version="1.0" encoding="utf-8"?>
<!-- Model centre download row: a nested card (tonal shell, inner surface) with the kind icon, the
     name over "chat · 3.7 GB", the state pill and the actions, then the bar and the meta line
     ("2.3 / 3.7 GB · 8.4 MB/s" … "~3 min"). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="3dp"
    android:paddingEnd="16dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/tai_centre_shell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tai_centre_shell"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tai_centre_core"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="11dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/tai_centre_icon_well">

                    <ImageView
                        android:id="@+id/tai_centre_kind_icon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tai_centre_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="?attr/termuxColorOnSurface"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tai_centre_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="?attr/termuxColorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tai_centre_state_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tai_centre_pill"
                    android:fontFamily="sans-serif-medium"
                    android:maxWidth="150dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:textSize="10.5sp"
                    android:visibility="gone" />

                <!-- "Start now" for a queued row, "Retry" for a failed one. -->
                <TextView
                    android:id="@+id/tai_centre_text_action"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/tai_centre_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/tai_centre_toggle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/tai_centre_round"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/tai_centre_cancel"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/tai_centre_round"
                    android:contentDescription="@string/tai_centre_action_cancel"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tai_close"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/tai_centre_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="10000"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tai_centre_meta_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="?attr/termuxColorOnSurfaceVariant"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/tai_centre_meta_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/termuxColorOnSurfaceVariant"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
