<?xml version="1.0" encoding="utf-8"?>
<!-- Catalogue filters: one segmented button (all | LiteRT | MNN | Installed | Usable). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tai_backend_segment"
        style="?attr/materialButtonToggleGroupStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tai_catalog_filter_all"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/termux_ai_catalog_backend_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tai_catalog_filter_litert"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/termux_ai_backend_label_litert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tai_catalog_filter_mnn"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/termux_ai_backend_label_mnn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tai_catalog_filter_installed"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/termux_ai_catalog_filter_installed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tai_catalog_filter_usable"
            style="@style/Widget.Termux.Button.Segment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/termux_ai_catalog_filter_usable" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</FrameLayout>
