<?xml version="1.0" encoding="utf-8"?>
<!-- The re-run row, which is a job rather than a setting: same metrics as preference_settings_row,
     with a determinate bar that appears only while the run is on. No chevron: nothing navigates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="24dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="16sp" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lineSpacingExtra="2dp"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/category_sort_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:visibility="gone" />
</LinearLayout>
