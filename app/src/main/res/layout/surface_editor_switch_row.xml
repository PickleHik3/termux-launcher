<?xml version="1.0" encoding="utf-8"?>
<!-- A row that is on or off rather than a number — the terminal's frame. Same height and label
     column as the slider rows so the panel reads as one list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/surface_editor_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="12.5sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/surface_editor_row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
