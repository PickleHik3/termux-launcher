<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding_panel_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/onboarding_brand"
            android:textColor="?attr/termuxColorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_skip_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="@string/onboarding_skip"
            android:textColor="?attr/termuxColorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <ProgressBar
            android:id="@+id/onboarding_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:max="7"
            android:progress="1"
            android:progressBackgroundTint="?attr/termuxColorSurfacePanelHigh"
            android:progressTint="?attr/termuxColorPrimary" />

        <TextView
            android:id="@+id/onboarding_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="monospace"
            android:textColor="?attr/termuxColorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/onboarding_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/onboarding_hero_height"
                android:layout_marginBottom="@dimen/onboarding_hero_margin_bottom"
                android:background="@drawable/onboarding_hero_background"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/onboarding_capture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:text="&gt;_"
                    android:textColor="?attr/termuxColorOnSurfaceVariant"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/onboarding_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/settings_icon_background"
                    android:padding="10dp"
                    android:tint="?attr/termuxColorPrimary" />

                <TextView
                    android:id="@+id/onboarding_capture_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="22dp"
                    android:layout_marginBottom="18dp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/termuxColorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="1 / TL" />
            </FrameLayout>

            <TextView
                android:id="@+id/onboarding_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="?attr/termuxColorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/termuxColorOnSurface"
                android:textSize="@dimen/onboarding_title_text_size" />

            <TextView
                android:id="@+id/onboarding_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/termuxColorOnSurfaceVariant"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/onboarding_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/onboarding_code_background"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="?attr/termuxColorPrimary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/onboarding_final_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onboarding_home_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_choose_home"
                    android:textColor="?attr/termuxColorPrimary"
                    app:icon="@drawable/ic_settings_grid"
                    app:iconTint="?attr/termuxColorPrimary"
                    app:strokeColor="?attr/termuxColorOutlineVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onboarding_guide_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/onboarding_read_guide"
                    android:textColor="?attr/termuxColorPrimary" />
            </LinearLayout>

            <include
                android:id="@+id/onboarding_bullet_1"
                layout="@layout/onboarding_bullet_row" />

            <include
                android:id="@+id/onboarding_bullet_2"
                layout="@layout/onboarding_bullet_row" />

            <include
                android:id="@+id/onboarding_bullet_3"
                layout="@layout/onboarding_bullet_row" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/termuxColorOutlineVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_back_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_back"
            android:textColor="?attr/termuxColorOnSurfaceVariant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onboarding_next_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="132dp"
            android:text="@string/onboarding_next"
            android:textColor="?attr/termuxColorOnPrimary"
            app:backgroundTint="?attr/termuxColorPrimary"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
</FrameLayout>
