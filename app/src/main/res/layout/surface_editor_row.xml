<?xml version="1.0" encoding="utf-8"?>
<!-- One shared surface-editor row: label, slider, value read-out, link chip. Inflated once per
     SurfaceEditorRows entry; the inflating code re-ids the slider, value and chip to the row's
     historical view ids, so everything that looks controls up by id is untouched by generation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/surface_editor_row_label"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/termuxColorOnSurface"
        android:textSize="12sp" />

    <SeekBar
        android:id="@+id/surface_editor_row_slider"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:splitTrack="false" />

    <TextView
        android:id="@+id/surface_editor_row_value"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/termuxColorOnSurfaceVariant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/surface_editor_row_chip"
        android:layout_width="30dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:textSize="11sp" />
</LinearLayout>
