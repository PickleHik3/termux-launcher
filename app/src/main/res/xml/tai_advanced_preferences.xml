<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="tai_model_tuning_category"
        app:title="@string/termux_ai_model_tuning_header">
        <Preference
            app:key="tai_parameters_defaults"
            app:title="@string/termux_ai_parameters_defaults_title"
            app:summary="@string/termux_ai_parameters_defaults_summary"
            app:persistent="false"/>
        <com.termux.app.fragments.settings.termux.TaiOverridesPreference
            app:key="tai_runtime_overrides"
            app:persistent="false"
            app:selectable="false"/>
        <com.termux.app.fragments.settings.SegmentedPillPreference
            app:key="tai_memory_limits"
            app:title="@string/termux_ai_memory_limits_title"
            app:summary="@string/termux_ai_memory_limits_relaxed_summary"
            app:persistent="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="tai_support_category"
        app:title="@string/termux_ai_support_header">
        <Preference
            app:key="tai_share_diagnostics"
            app:title="@string/termux_ai_share_diagnostics_title"
            app:summary="@string/termux_ai_share_diagnostics_summary"
            app:persistent="false"/>
    </PreferenceCategory>
</PreferenceScreen>
