<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="tai_endpoint_category"
        app:title="@string/termux_ai_endpoint_header">
        <!-- Shows the live base URL; the dialog behind it copies, reveals and regenerates. -->
        <Preference
            app:key="tai_endpoint_copy"
            app:title="@string/termux_ai_endpoint_copy_title"
            app:summary="@string/termux_ai_endpoint_notice_summary"
            app:persistent="false"/>
        <androidx.preference.SwitchPreferenceCompat
            app:key="tai_openai_auto_load"
            app:title="@string/termux_ai_openai_auto_load_title"
            app:summaryOff="@string/termux_ai_openai_auto_load_summary_off"
            app:summaryOn="@string/termux_ai_openai_auto_load_summary_on"
            app:defaultValue="true"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="tai_access_category"
        app:title="@string/termux_ai_access_header">
        <androidx.preference.SwitchPreferenceCompat
            app:key="tai_api_auth_required"
            app:title="@string/termux_ai_auth_required_title"
            app:summaryOff="@string/termux_ai_auth_required_summary_off"
            app:summaryOn="@string/termux_ai_auth_required_summary_on"
            app:defaultValue="true"/>
        <androidx.preference.SwitchPreferenceCompat
            app:key="tai_lan_enabled"
            app:title="@string/termux_ai_lan_enabled_title"
            app:summaryOff="@string/termux_ai_lan_enabled_summary_off"
            app:summaryOn="@string/termux_ai_lan_enabled_summary_on"
            app:defaultValue="false"/>
        <Preference
            app:key="tai_lan_note"
            app:summary="@string/termux_ai_lan_note"
            app:persistent="false"
            app:selectable="false"/>
    </PreferenceCategory>
</PreferenceScreen>
