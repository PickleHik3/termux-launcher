<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Terminal › Linux apps: the old Display section. Its Linux apps page folded in on top; the
         display itself is a window of the Terminal now (docs/en/X11_Display.md). -->
    <PreferenceCategory app:title="@string/settings_x11_category_apps">
        <Preference
            app:key="x11_gui_apps_setup"
            app:title="@string/settings_gui_apps_title"
            app:persistent="false"
            app:summary="@string/settings_gui_apps_row_summary"
            app:fragment="com.termux.app.fragments.settings.termux.GuiAppsSetupGuideFragment" />
        <Preference
            app:key="x11_desktops"
            app:title="@string/settings_x11_desktops_title"
            app:summary="@string/settings_x11_desktops_summary"
            app:fragment="com.termux.app.fragments.settings.termux.DesktopsPreferencesFragment" />
        <Preference
            app:key="x11_apps"
            app:title="@string/settings_x11_apps_title"
            app:summary="@string/settings_x11_apps_summary"
            app:fragment="com.termux.app.fragments.settings.termux.X11AppsPreferencesFragment" />
        <!-- Shown only in a build with the Wayland host (X11DisplayPreferencesFragment). -->
        <ListPreference
            app:key="linux_display_backend"
            app:title="@string/settings_linux_display_title"
            app:dialogTitle="@string/settings_linux_display_title"
            app:entries="@array/settings_linux_display_entries"
            app:entryValues="@array/settings_linux_display_values"
            android:defaultValue="x11"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="linux_display_backend_hint"
            app:summary="@string/settings_linux_display_hint"
            app:selectable="false"
            app:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_x11_group_desktop">
        <!-- Entries are filled in by X11DisplayPreferencesFragment: one per distro with XFCE. -->
        <ListPreference
            app:key="x11_start_with"
            app:title="@string/settings_x11_start_with_title"
            app:dialogTitle="@string/settings_x11_start_with_title"
            android:defaultValue="" />
        <EditTextPreference
            app:key="x11_start_with_command"
            app:title="@string/settings_x11_start_with_command_title"
            app:dialogMessage="@string/settings_x11_start_with_command_message"
            app:isPreferenceVisible="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_x11_group_configure">
        <Preference
            app:key="x11_sub_input"
            app:persistent="false"
            app:title="@string/settings_x11_sub_input_title"
            app:summary="@string/settings_x11_sub_input_summary"
            app:fragment="com.termux.app.fragments.settings.termux.X11DisplayInputPreferencesFragment" />
        <Preference
            app:key="x11_sub_resolution"
            app:persistent="false"
            app:title="@string/settings_x11_sub_resolution_title"
            app:summary="@string/settings_x11_sub_resolution_summary"
            app:fragment="com.termux.app.fragments.settings.termux.X11DisplayResolutionPreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_x11_group_advanced">
        <Preference
            app:key="x11_gpu"
            app:title="@string/settings_x11_gpu_title"
            app:persistent="false"
            app:summary="@string/settings_x11_gpu_entry_summary"
            app:fragment="com.termux.app.fragments.settings.termux.GraphicsAccelerationFragment" />
        <EditTextPreference
            app:key="x11_window_manager"
            app:title="@string/settings_x11_window_manager_title"
            app:dialogMessage="@string/settings_x11_window_manager_summary"
            android:defaultValue="openbox"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:key="x11_window_manager_hint"
            app:summary="@string/settings_x11_window_manager_hint"
            app:selectable="false"
            app:persistent="false" />
        <Preference
            app:key="x11_sub_startup"
            app:persistent="false"
            app:title="@string/settings_x11_sub_startup_title"
            app:summary="@string/settings_x11_sub_startup_summary"
            app:fragment="com.termux.app.fragments.settings.termux.X11DisplayStartupPreferencesFragment" />
        <Preference
            app:key="x11_sub_troubleshooting"
            app:persistent="false"
            app:title="@string/settings_x11_sub_troubleshooting_title"
            app:summary="@string/settings_x11_sub_troubleshooting_summary"
            app:fragment="com.termux.app.fragments.settings.termux.X11DisplayTroubleshootingPreferencesFragment" />
    </PreferenceCategory>

</PreferenceScreen>
