<?xml version="1.0" encoding="utf-8"?>
<!-- Battery & performance: what makes the launcher lighter on a weak phone. Every key is the one it
     always was. Terminal's Text & display page keeps its own Terminal effect row and Home its own
     Wallpaper parallax row; each pair writes the same preference. Summaries here are the rows'
     normal ones: the fragment says why a row is greyed. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="performance_presets"
        app:title="@string/settings_performance_presets_header">
        <SwitchPreferenceCompat
            app:key="lazy_mode"
            app:icon="@drawable/ic_ms_bedtime"
            app:title="@string/settings_behavior_idle_title"
            app:summary="@string/settings_behavior_idle_summary"
            app:defaultValue="false">
            <!-- Its old name, so a search for it still lands here. -->
            <extra android:name="search_terms" android:value="lazy mode" />
        </SwitchPreferenceCompat>
        <SwitchPreferenceCompat
            app:key="low_memory_preset"
            app:icon="@drawable/ic_ms_memory"
            app:title="@string/settings_behavior_low_memory_title"
            app:summary="@string/settings_behavior_low_memory_summary"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="performance_motion"
        app:title="@string/settings_performance_motion_header">
        <SwitchPreferenceCompat
            app:key="fancier_glass"
            app:icon="@drawable/ic_ms_glass_refraction"
            app:title="@string/settings_performance_glass_refraction_title"
            app:summary="@string/settings_performance_glass_refraction_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="live_blur"
            app:icon="@drawable/ic_ms_live_blur"
            app:title="@string/settings_performance_live_blur_title"
            app:summary="@string/settings_performance_live_blur_summary"
            android:defaultValue="false" />
        <ListPreference
            app:key="glass_see_through"
            app:icon="@drawable/ic_ms_live_blur"
            app:title="@string/settings_performance_see_through_title"
            app:summary="@string/settings_performance_see_through_summary"
            app:entries="@array/settings_performance_see_through_entries"
            app:entryValues="@array/settings_performance_see_through_values"
            app:defaultValue="all" />
        <SwitchPreferenceCompat
            app:key="live_windows_while_swiping"
            app:icon="@drawable/ic_ms_desktop_windows"
            app:title="@string/settings_performance_live_windows_title"
            app:summary="@string/settings_performance_live_windows_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="fancier_glass_motion_light"
            app:icon="@drawable/ic_ms_living_glass"
            app:title="@string/settings_motion_light_title"
            app:summary="@string/settings_performance_living_glass_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="wallpaper_parallax"
            app:icon="@drawable/ic_ms_swipe"
            app:title="@string/settings_wallpaper_parallax_title"
            app:summary="@string/settings_performance_parallax_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="terminal_cursor_trail"
            app:icon="@drawable/ic_ms_cursor_trail"
            app:title="@string/settings_performance_cursor_trail_title"
            app:summary="@string/settings_performance_cursor_trail_summary"
            android:defaultValue="true" />
        <ListPreference
            app:key="terminal_retro_effect"
            app:icon="@drawable/ic_ms_tv_gen"
            app:title="@string/settings_terminal_retro_effect_title"
            app:summary="@string/settings_performance_terminal_effect_summary"
            app:entries="@array/settings_terminal_retro_effect_entries"
            app:entryValues="@array/settings_terminal_retro_effect_values"
            app:defaultValue="none" />
        <SwitchPreferenceCompat
            app:key="terminal_screen_events"
            app:icon="@drawable/ic_ms_screen_events"
            app:title="@string/settings_terminal_screen_events_title"
            app:summary="@string/settings_terminal_screen_events_summary"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="terminal_retro_composite"
            app:icon="@drawable/ic_ms_tv_gen"
            app:title="@string/settings_terminal_retro_composite_title"
            app:summary="@string/settings_terminal_retro_composite_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="idle_animations"
            app:icon="@drawable/ic_ms_animation"
            app:title="@string/settings_idle_animations_title"
            app:summary="@string/settings_idle_animations_summary"
            app:defaultValue="false" />
        <ListPreference
            app:key="idle_tear_rate"
            app:icon="@drawable/ic_ms_animation"
            app:title="@string/settings_idle_tear_rate_title"
            app:entries="@array/settings_idle_tear_rate_entries"
            app:entryValues="@array/settings_idle_tear_rate_values"
            app:dependency="idle_animations"
            app:useSimpleSummaryProvider="true"
            app:defaultValue="rare" />
    </PreferenceCategory>

</PreferenceScreen>
