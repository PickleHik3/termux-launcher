<?xml version="1.0" encoding="utf-8"?>
<!-- The door into the Layout editor, and nothing else: one row per place, each closing Settings
     and opening the launcher on that place with its layout editor up. Everything a place's layout
     holds — where its bars stand, how its keyboard opens, how many cells its grid has — is picked
     in the editor, beside the picture of the place it belongs to. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="layout_place_home"
        app:persistent="false"
        app:title="@string/settings_layout_tab_home" />

    <Preference
        app:key="layout_place_terminal"
        app:persistent="false"
        app:title="@string/settings_layout_tab_terminal" />

    <Preference
        app:key="layout_place_display"
        app:persistent="false"
        app:title="@string/settings_layout_tab_display" />

</PreferenceScreen>
