<?xml version="1.0" encoding="utf-8"?>
<!-- Never shown: the rows the Appearance editor holds instead of a Settings page, kept here so
     Settings search still finds them by their old names. A hit opens the editor
     (SettingsActivity.openSearchResult). Keys are the rows' own, so a later card can be picked by
     the key a hit carries. Plain rows: nothing here reads or writes a value. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="theme_mode"
        app:persistent="false"
        app:title="@string/settings_color_mode_title" />
    <Preference
        app:key="terminal_dynamic_colors_enabled"
        app:persistent="false"
        app:title="@string/settings_wallpaper_colors_title"
        app:summary="@string/settings_wallpaper_colors_summary" />
    <Preference
        app:key="terminal_contrast_level"
        app:persistent="false"
        app:title="@string/settings_terminal_contrast_title" />
    <Preference
        app:key="theme_templates_enabled"
        app:persistent="false"
        app:title="@string/settings_theme_templates_title"
        app:summary="@string/settings_theme_templates_summary_none" />
    <Preference
        app:key="use_system_wallpaper"
        app:persistent="false"
        app:title="@string/settings_wallpaper_title"
        app:summary="@string/termux_use_system_wallpaper_summary" />
    <Preference
        app:key="wallpaper_render_zoom"
        app:persistent="false"
        app:title="@string/settings_wallpaper_alignment_title"
        app:summary="@string/settings_wallpaper_alignment_summary" />
    <Preference
        app:key="widgets_on_glass"
        app:persistent="false"
        app:title="@string/settings_widgets_on_glass_title"
        app:summary="@string/settings_widgets_on_glass_summary" />
    <Preference
        app:key="app_launcher_bw_icons"
        app:persistent="false"
        app:title="@string/settings_icon_appearance_title"
        app:summary="@string/termux_app_launcher_bw_icons_summary" />
    <Preference
        app:key="app_launcher_icon_pack_package"
        app:persistent="false"
        app:title="@string/settings_icon_pack_title"
        app:summary="@string/termux_app_launcher_icon_pack_summary" />
    <Preference
        app:key="app_launcher_pinned_icon_pack_package"
        app:persistent="false"
        app:title="@string/settings_pinned_icon_pack_title"
        app:summary="@string/termux_app_launcher_pinned_icon_pack_summary" />
    <!-- From Terminal › Text & display. -->
    <Preference
        app:key="fullscreen"
        app:persistent="false"
        app:title="@string/settings_full_screen_title"
        app:summary="@string/termux_fullscreen_summary" />

</PreferenceScreen>
