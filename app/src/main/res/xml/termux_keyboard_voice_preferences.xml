<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_voice_group_speech">
        <com.termux.app.fragments.settings.SegmentedPillPreference
            app:key="keyboard_voice_engine"
            app:title="@string/settings_keyboard_voice_engine_title"
            app:entries="@array/settings_keyboard_voice_engine_entries"
            app:entryValues="@array/settings_keyboard_voice_engine_values"
            app:defaultValue="system" />
        <ListPreference
            app:key="keyboard_voice_language"
            app:title="@string/settings_keyboard_voice_language_title"
            app:entries="@array/settings_keyboard_voice_language_entries"
            app:entryValues="@array/settings_keyboard_voice_language_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_keyboard_voice_model_title">
        <Preference
            app:key="speech_model_pick"
            app:persistent="false" />
        <com.termux.app.fragments.settings.SegmentedPillPreference
            app:key="speech_model_accelerator"
            app:title="@string/speech_model_accelerator_title"
            app:entries="@array/speech_model_accelerator_entries"
            app:entryValues="@array/speech_model_accelerator_values"
            app:defaultValue="auto" />
        <Preference
            app:key="speech_model_idle_unload"
            app:persistent="false"
            app:title="@string/speech_model_idle_unload_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_voice_group_cleanup">
        <SwitchPreferenceCompat
            app:key="keyboard_voice_polish"
            app:title="@string/settings_keyboard_voice_polish_title"
            app:summary="@string/settings_keyboard_voice_polish_summary"
            android:defaultValue="true" />
        <Preference
            app:key="keyboard_voice_polish_model"
            app:persistent="false"
            app:dependency="keyboard_voice_polish"
            app:title="@string/settings_keyboard_voice_polish_model_title" />
        <ListPreference
            app:key="keyboard_voice_polish_level"
            app:dependency="keyboard_voice_polish"
            app:title="@string/settings_keyboard_voice_polish_level_title"
            app:entries="@array/settings_keyboard_voice_polish_level_entries"
            app:entryValues="@array/settings_keyboard_voice_polish_level_values"
            app:defaultValue="polished"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_voice_group_listening">
        <SwitchPreferenceCompat
            app:key="keyboard_voice_sounds"
            app:title="@string/settings_keyboard_voice_sounds_title"
            app:summary="@string/settings_keyboard_voice_sounds_summary"
            android:defaultValue="true" />
        <Preference
            app:key="keyboard_voice_details"
            app:persistent="false"
            app:title="@string/settings_voice_details_title"
            app:fragment="com.termux.app.fragments.settings.termux.KeyboardVoiceDetailsPreferencesFragment" />
    </PreferenceCategory>

</PreferenceScreen>
