<?xml version="1.0" encoding="utf-8"?>
<!-- The settings root, by the wall's halves (project-docs/active/settings-restructure-2026-10-19.md,
     refiled by project-docs/active/appearance-and-settings-rework-2026-10-24.md §4): what you see on
     Home and on the Terminal, then what holds everywhere, then the app itself. Every destination
     row's page and section are mirrored in SettingsTree. Appearance is a door, not a page: its row
     opens the Appearance editor (RootPreferencesFragment). -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.termux.app.fragments.settings.SettingsSearchPreference
        app:key="settings_search"
        app:title="@string/settings_search_hint"
        app:persistent="false" />

    <PreferenceCategory app:key="root_your_launcher" app:title="@string/settings_root_your_launcher_header">

        <Preference
            app:key="home"
            app:icon="@drawable/ic_symbol_home"
            app:title="@string/settings_section_home"
            app:summary="@string/settings_section_home_summary"
            app:fragment="com.termux.app.fragments.settings.termux.HomePreferencesFragment" />

        <Preference
            app:key="dock_drawer"
            app:icon="@drawable/ic_symbol_apps"
            app:title="@string/settings_section_dock_drawer"
            app:summary="@string/settings_section_dock_drawer_summary"
            app:fragment="com.termux.app.fragments.settings.termux.LauncherPreferencesFragment" />

        <Preference
            app:key="terminal"
            app:icon="@drawable/ic_symbol_terminal"
            app:title="@string/settings_destination_terminal"
            app:summary="@string/settings_section_terminal_summary"
            app:fragment="com.termux.app.fragments.settings.termux.TerminalPreferencesFragment" />

    </PreferenceCategory>

    <PreferenceCategory app:key="root_shared" app:title="@string/settings_root_shared_header">

        <Preference
            app:key="look"
            app:icon="@drawable/ic_symbol_palette"
            app:title="@string/settings_section_look"
            app:summary="@string/settings_section_look_summary"
            app:persistent="false" />

        <Preference
            app:key="keyboard_input"
            app:icon="@drawable/ic_symbol_keyboard"
            app:title="@string/settings_destination_keyboard_input"
            app:summary="@string/settings_section_keyboard_summary"
            app:fragment="com.termux.app.fragments.settings.termux.KeyboardPreferencesFragment" />

        <Preference
            app:key="notifications"
            app:icon="@drawable/ic_symbol_notification_settings"
            app:title="@string/settings_destination_notifications"
            app:summary="@string/settings_section_notifications_summary"
            app:fragment="com.termux.app.fragments.settings.termux.NotificationsPreferencesFragment" />

        <Preference
            app:key="on_device_ai"
            app:icon="@drawable/ic_symbol_smart_toy"
            app:title="@string/settings_tai_service_title"
            app:summary="@string/settings_section_ai_summary"
            app:fragment="com.termux.app.fragments.settings.termux.TaiPreferencesFragment" />

    </PreferenceCategory>

    <PreferenceCategory app:key="root_system" app:title="@string/settings_root_system_header">

        <Preference
            app:key="general"
            app:icon="@drawable/ic_symbol_tune"
            app:title="@string/settings_section_general"
            app:summary="@string/settings_section_general_summary"
            app:fragment="com.termux.app.fragments.settings.termux.GeneralPreferencesFragment" />

    </PreferenceCategory>

</PreferenceScreen>
