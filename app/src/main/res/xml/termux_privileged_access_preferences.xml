<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="privileged_access_overview"
        app:title="@string/termux_privileged_access_overview_title">

        <com.termux.app.fragments.settings.StatusCardPreference
            app:key="privileged_backend_status"
            app:title="@string/termux_privileged_backend_status_title"
            app:summary="@string/termux_privileged_backend_status_summary"
            app:persistent="false"
            app:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="privileged_access_backend"
        app:title="@string/termux_privileged_access_backend_title">

        <ListPreference
            app:key="priv_backend"
            app:title="@string/termux_privileged_backend_title"
            app:dialogTitle="@string/termux_privileged_backend_title"
            app:entries="@array/termux_privileged_backend_entries"
            app:entryValues="@array/termux_privileged_backend_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="priv_request_shizuku_permission"
            app:title="@string/termux_privileged_request_permission_title"
            app:summary="@string/termux_privileged_request_permission_summary" />

        <SwitchPreferenceCompat
            app:key="launcherctl_root_reboot"
            app:title="@string/termux_privileged_launcherctl_reboot_title"
            app:summary="@string/termux_privileged_launcherctl_reboot_summary"
            app:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="privileged_lane"
        app:title="@string/termux_privileged_lane_title">

        <com.termux.app.fragments.settings.StatusCardPreference
            app:key="priv_lane_status"
            app:title="@string/termux_privileged_lane_status_title"
            app:summary="@string/termux_privileged_lane_status_summary"
            app:persistent="false"
            app:selectable="false" />

        <SwitchPreferenceCompat
            app:key="priv_lane_enabled"
            app:title="@string/termux_privileged_lane_enabled_title"
            app:summaryOn="@string/termux_privileged_lane_enabled_on"
            app:summaryOff="@string/termux_privileged_lane_enabled_off"
            app:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
