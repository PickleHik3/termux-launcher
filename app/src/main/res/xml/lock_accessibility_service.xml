<?xml version="1.0" encoding="utf-8"?>
<!-- The service only performs global actions (lock, notifications, quick settings) when the
     launcher asks. It names no event types, so it is sent no events at all. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="false"
    android:canRetrieveWindowContent="false"
    android:description="@string/termux_app_launcher_accessibility_lock_prompt_message" />
