<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal: the Layout editor first, then one row per part of the Terminal half. The rows this
     page used to hold moved, keys unchanged, to Windows & panes, Text & display and Clipboard &
     compatibility; Status bar and the display (now Linux apps) joined from the root. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:key="terminal_layout_editor"
        app:persistent="false"
        app:title="@string/settings_layout_editor_title"
        app:summary="@string/settings_layout_editor_terminal_summary" />

    <Preference
        app:key="terminal_sub_windows"
        app:persistent="false"
        app:title="@string/settings_terminal_sub_windows_title"
        app:summary="@string/settings_terminal_sub_windows_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalWindowsPreferencesFragment" />

    <Preference
        app:key="status_bar"
        app:persistent="false"
        app:title="@string/settings_destination_status_bar"
        app:summary="@string/settings_terminal_sub_status_summary"
        app:fragment="com.termux.app.fragments.settings.termux.StatusBarPreferencesFragment" />

    <Preference
        app:key="terminal_sub_text"
        app:persistent="false"
        app:title="@string/settings_terminal_sub_text_title"
        app:summary="@string/settings_terminal_sub_text_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalTextPreferencesFragment" />

    <Preference
        app:key="terminal_sub_clipboard"
        app:persistent="false"
        app:title="@string/settings_terminal_sub_clipboard_title"
        app:summary="@string/settings_terminal_sub_clipboard_summary"
        app:fragment="com.termux.app.fragments.settings.termux.TerminalClipboardPreferencesFragment" />

    <Preference
        app:key="display"
        app:persistent="false"
        app:title="@string/settings_terminal_sub_linux_apps_title"
        app:summary="@string/settings_terminal_sub_linux_apps_summary"
        app:fragment="com.termux.app.fragments.settings.termux.X11DisplayPreferencesFragment" />
</PreferenceScreen>
