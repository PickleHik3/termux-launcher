<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_surfaces_header">
        <Preference
            app:key="live_surface_editor"
            app:icon="@drawable/ic_symbol_palette"
            app:persistent="false"
            app:title="@string/termux_dock_tune_live_title"
            app:summary="@string/termux_dock_tune_live_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_fonts_header">
        <Preference
            app:key="terminal_fonts"
            app:icon="@drawable/ic_symbol_terminal"
            app:persistent="false"
            app:title="@string/termux_fonts_preferences_title"
            app:summary="@string/termux_fonts_preferences_summary"
            app:fragment="com.termux.app.fragments.settings.termux.TermuxFontsPreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_theme_header">
        <ListPreference
            app:key="theme_mode"
            app:title="@string/settings_color_mode_title"
            app:entries="@array/termux_theme_mode_entries"
            app:entryValues="@array/termux_theme_mode_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="terminal_dynamic_colors_enabled"
            app:title="@string/settings_wallpaper_colors_title"
            app:summary="@string/settings_wallpaper_colors_summary"
            android:defaultValue="true" />
        <Preference
            app:key="terminal_dynamic_colors_hint"
            app:summary="@string/settings_wallpaper_colors_hint"
            app:persistent="false"
            app:selectable="false"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="terminal_contrast_level"
            app:title="@string/settings_terminal_contrast_title"
            app:entries="@array/terminal_contrast_entries"
            app:entryValues="@array/terminal_contrast_values"
            android:defaultValue="default" />
        <SwitchPreferenceCompat
            app:key="use_system_wallpaper"
            app:title="@string/settings_wallpaper_title"
            app:summary="@string/termux_use_system_wallpaper_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_icon_appearance_header">
        <SwitchPreferenceCompat
            app:key="app_launcher_bw_icons"
            app:title="@string/settings_icon_appearance_title"
            app:summary="@string/termux_app_launcher_bw_icons_summary"
            android:defaultValue="false" />
        <Preference
            app:key="app_launcher_icon_pack_package"
            app:icon="@drawable/ic_symbol_grid_view"
            app:title="@string/settings_icon_pack_title"
            app:summary="@string/termux_app_launcher_icon_pack_summary" />
        <Preference
            app:key="app_launcher_pinned_icon_pack_package"
            app:icon="@drawable/ic_symbol_grid_view"
            app:title="@string/settings_pinned_icon_pack_title"
            app:summary="@string/termux_app_launcher_pinned_icon_pack_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:key="keyboard_appearance" app:title="@string/settings_keyboard_look_header">
        <Preference
            app:key="customize_keyboard_surface"
            app:icon="@drawable/ic_symbol_palette"
            app:persistent="false"
            app:title="@string/settings_customize_keyboard_title"
            app:summary="@string/settings_customize_keyboard_summary" />
        <ListPreference
            app:key="in_app_keyboard_theme"
            app:entries="@array/termux_in_app_keyboard_theme_entries"
            app:entryValues="@array/termux_in_app_keyboard_theme_values"
            app:useSimpleSummaryProvider="true"
            app:title="@string/termux_in_app_keyboard_theme_title" />
        <Preference
            app:key="in_app_keyboard_color_scheme_editor"
            app:icon="@drawable/ic_symbol_palette"
            app:fragment="com.termux.app.fragments.settings.termux.KeyboardColorSchemeFragment"
            app:summary="@string/settings_keyboard_colors_summary"
            app:title="@string/settings_keyboard_colors_title" />
        <Preference
            app:key="in_app_keyboard_font"
            app:title="@string/settings_typeface_title" />
        <SeekBarPreference
            app:key="in_app_keyboard_bottom_padding"
            app:title="@string/settings_keyboard_bottom_padding_title"
            app:summary="@string/settings_keyboard_bottom_padding_summary"
            app:showSeekBarValue="true"
            android:max="48"
            android:defaultValue="0" />
    </PreferenceCategory>

    <!-- Deliberately last: the sessions drawer is a legacy surface (it only exists with split
         panes off), so its one styling control sits at the bottom rather than in the surface
         editor, which tunes the surfaces the launcher actually ships on. -->
    <PreferenceCategory app:title="@string/settings_sessions_sidebar_header">
        <SeekBarPreference
            app:key="sessions_opacity"
            app:title="@string/settings_sessions_opacity_title"
            app:summary="@string/settings_sessions_opacity_summary"
            app:showSeekBarValue="true"
            android:max="100"
            android:defaultValue="50" />
    </PreferenceCategory>

</PreferenceScreen>
