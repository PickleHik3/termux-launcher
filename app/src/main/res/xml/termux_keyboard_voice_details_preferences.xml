<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_voice_group_listening">
        <ListPreference
            app:key="keyboard_voice_pause_ms"
            app:title="@string/settings_keyboard_voice_pause_title"
            app:entries="@array/settings_keyboard_voice_pause_entries"
            app:entryValues="@array/settings_keyboard_voice_pause_values"
            app:defaultValue="600"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="keyboard_voice_mic_sensitivity"
            app:title="@string/settings_keyboard_voice_mic_sensitivity_title"
            app:entries="@array/settings_keyboard_voice_mic_sensitivity_entries"
            app:entryValues="@array/settings_keyboard_voice_mic_sensitivity_values"
            app:defaultValue="normal"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="keyboard_voice_silence_timeout_ms"
            app:title="@string/settings_keyboard_voice_silence_timeout_title"
            app:entries="@array/settings_keyboard_voice_silence_timeout_entries"
            app:entryValues="@array/settings_keyboard_voice_silence_timeout_values"
            app:defaultValue="5000"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_voice_details_header">
        <Preference
            app:key="keyboard_voice_details_cleanup"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/settings_voice_details_cleanup_title"
            app:summary="@string/settings_voice_details_cleanup_summary" />
        <Preference
            app:key="keyboard_voice_details_off"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/settings_voice_details_off_title"
            app:summary="@string/settings_voice_details_off_summary" />
        <Preference
            app:key="keyboard_voice_details_shell"
            app:persistent="false"
            app:selectable="false"
            app:title="@string/settings_voice_details_shell_title"
            app:summary="@string/settings_voice_details_shell_summary" />
    </PreferenceCategory>

</PreferenceScreen>
