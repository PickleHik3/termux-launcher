<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_status_clock_header">
        <SwitchPreferenceCompat
            app:key="top_pane_clock_am_pm"
            app:title="@string/settings_use_12_hour_title"
            app:summary="@string/settings_use_12_hour_summary"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_indicators_header">
        <SwitchPreferenceCompat
            app:key="status_widget_cpu"
            app:title="@string/settings_cpu_usage_title"
            app:summary="@string/termux_status_widget_cpu_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="status_widget_ram"
            app:title="@string/settings_memory_usage_title"
            app:summary="@string/settings_memory_usage_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="status_widget_media"
            app:title="@string/settings_status_media_title"
            app:summary="@string/settings_status_media_summary"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_status_weather_header">
        <SwitchPreferenceCompat
            app:key="status_widget_weather"
            app:title="@string/settings_weather_title"
            app:summary="@string/settings_weather_summary"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="status_widget_weather_fahrenheit"
            app:title="@string/settings_weather_fahrenheit_title"
            app:summary="@string/settings_weather_fahrenheit_summary"
            app:defaultValue="false"
            app:dependency="status_widget_weather" />
        <Preference
            app:key="status_widget_weather_location"
            app:persistent="false"
            app:title="@string/settings_weather_location_title"
            app:summary="@string/settings_weather_location_summary_device"
            app:dependency="status_widget_weather" />
    </PreferenceCategory>

    <!-- Where the bar shares the camera's band, its row leaves a gap for the camera (#163).
         Auto follows the phone's own cutout; Custom adds the sliders that move and size it. -->
    <PreferenceCategory app:title="@string/settings_status_cutout_header">
        <com.termux.app.fragments.settings.SegmentedPillPreference
            app:key="status_bar_cutout_mode"
            app:title="@string/settings_status_cutout_title"
            android:defaultValue="auto"
            app:entries="@array/settings_status_cutout_entries"
            app:entryValues="@array/settings_status_cutout_values" />
        <com.termux.app.fragments.settings.SliderPreference
            app:key="status_bar_cutout_margin"
            app:title="@string/settings_status_cutout_margin_title"
            app:summary="@string/settings_status_cutout_margin_summary"
            android:defaultValue="4"
            app:min="0"
            android:max="24"
            app:showSeekBarValue="true" />
        <com.termux.app.fragments.settings.SliderPreference
            app:key="status_bar_cutout_offset_x"
            app:title="@string/settings_status_cutout_x_title"
            app:summary="@string/settings_status_cutout_x_summary"
            android:defaultValue="0"
            app:min="-200"
            android:max="200"
            app:showSeekBarValue="true" />
        <com.termux.app.fragments.settings.SliderPreference
            app:key="status_bar_cutout_offset_y"
            app:title="@string/settings_status_cutout_y_title"
            android:defaultValue="0"
            app:min="-24"
            android:max="24"
            app:showSeekBarValue="true" />
        <com.termux.app.fragments.settings.SliderPreference
            app:key="status_bar_cutout_scale"
            app:title="@string/settings_status_cutout_size_title"
            android:defaultValue="100"
            app:min="50"
            android:max="200"
            app:showSeekBarValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
