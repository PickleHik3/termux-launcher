<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:key="keyboard_shapes" app:title="@string/settings_keyboard_shapes_header">
        <com.termux.app.fragments.settings.SliderPreference
            app:key="in_app_keyboard_floating_width"
            app:title="@string/settings_keyboard_floating_width_title"
            app:summary="@string/settings_keyboard_floating_width_summary"
            android:defaultValue="90"
            app:min="35"
            android:max="100"
            app:showSeekBarValue="true" />
        <com.termux.app.fragments.settings.SliderPreference
            app:key="in_app_keyboard_floating_height"
            app:title="@string/settings_keyboard_floating_height_title"
            app:summary="@string/settings_keyboard_floating_height_summary"
            android:defaultValue="100"
            app:min="60"
            android:max="160"
            app:showSeekBarValue="true" />
        <com.termux.app.fragments.settings.SliderPreference
            app:key="in_app_keyboard_split_gap"
            app:title="@string/settings_keyboard_split_gap_title"
            app:summary="@string/settings_keyboard_split_gap_summary"
            android:defaultValue="12"
            app:min="0"
            android:max="45"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
