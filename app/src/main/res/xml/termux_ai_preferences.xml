<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="tai_runtime_category"
        app:title="@string/termux_ai_zone_runtime_title">
        <com.termux.app.fragments.settings.StatusCardPreference
            app:key="tai_runtime_status"
            app:title="@string/termux_ai_runtime_status_title"
            app:summary="@string/termux_ai_runtime_status_summary"
            app:persistent="false"
            app:selectable="false"/>
        <!-- Stop, unload, logs and the detailed status live on TaiRuntimePreferencesFragment. -->
        <Preference
            app:key="tai_runtime_controls"
            app:title="@string/termux_ai_runtime_controls_title"
            app:summary="@string/termux_ai_runtime_controls_summary"
            app:persistent="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="tai_models_category"
        app:title="@string/termux_ai_zone_models_title">
        <!-- Everything about models (installed, catalogue, downloads, adding by link or file)
             lives in the Model centre; this page keeps one row into it. -->
        <com.termux.app.fragments.settings.termux.TaiModelCentreRowPreference
            app:key="tai_model_centre"
            app:title="@string/tai_model_centre_title"
            app:persistent="false"/>
        <Preference
            app:key="tai_welcome_card"
            app:title="@string/tai_welcome_pref_title"
            app:summary="@string/tai_welcome_pref_summary"
            app:persistent="false"/>
        <Preference
            app:key="tai_voice_input"
            app:title="@string/settings_keyboard_sub_voice_title"
            app:summary="@string/settings_keyboard_sub_voice_summary"
            app:persistent="false"/>
        <Preference
            app:key="tai_benchmark"
            app:title="@string/tai_bench_title"
            app:summary="@string/tai_bench_pref_summary"
            app:persistent="false"/>
        <!-- A bring-your-own-key OpenAI-compatible server; its rows live on their own screen
             (TaiRemotePreferencesFragment). -->
        <Preference
            app:key="tai_remote_provider"
            app:title="@string/tai_remote_row_title"
            app:summary="@string/tai_remote_row_summary_off"
            app:persistent="false"/>
        <Preference
            app:key="tai_huggingface_token"
            app:title="@string/termux_ai_huggingface_token_title"
            app:summary="@string/termux_ai_huggingface_token_summary"
            app:persistent="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="tai_developer_category"
        app:title="@string/termux_ai_developer_title">
        <Preference
            app:key="tai_local_api"
            app:title="@string/termux_ai_local_api_title"
            app:summary="@string/termux_ai_local_api_summary"
            app:persistent="false"/>
        <Preference
            app:key="tai_advanced"
            app:title="@string/termux_ai_zone_advanced_title"
            app:summary="@string/termux_ai_advanced_summary"
            app:persistent="false"/>
    </PreferenceCategory>
</PreferenceScreen>
