<?xml version="1.0" encoding="utf-8"?>
<!-- General: the switches that cut across the launcher (vibration, Recents), the way to Battery &
     performance, the app's own pages (backup, permissions, diagnostics, about) and setting it as the
     home app. Every key is the one it always was; App behavior, the old root rows and Apps' Set as
     default launcher folded in. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:key="general_motion" app:title="@string/settings_general_motion_header">
        <ListPreference
            app:key="animation_speed"
            app:persistent="true"
            app:title="@string/settings_animation_speed_title"
            app:dialogTitle="@string/settings_animation_speed_title"
            app:entries="@array/settings_animation_speed_entries"
            app:entryValues="@array/settings_animation_speed_values"
            app:useSimpleSummaryProvider="true"
            android:defaultValue="normal" />
        <!-- How every page turns: Home's pages, Home to the Workspace, and window to window. Opens
             the preview, growing out of this row; the summary names the effect in use. Its key is
             the one it had on Home. -->
        <Preference
            app:key="app_launcher_home_page_transition"
            app:persistent="false"
            app:fragment="com.termux.app.fragments.settings.termux.HomePageTransitionFragment"
            app:title="@string/settings_home_page_transition_title" />
    </PreferenceCategory>

    <PreferenceCategory app:key="general_vibration" app:title="@string/settings_behavior_vibration_header">
        <SwitchPreferenceCompat
            app:key="app_haptics_enabled"
            app:title="@string/settings_behavior_vibration_title"
            app:summary="@string/settings_behavior_vibration_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="app_launcher_row_haptics"
            app:title="@string/settings_behavior_launcher_vibration_title"
            app:summary="@string/settings_behavior_launcher_vibration_summary"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="in_app_keyboard_haptics_enabled"
            app:title="@string/settings_behavior_keyboard_vibration_title"
            app:summary="@string/settings_behavior_keyboard_vibration_summary" />
    </PreferenceCategory>

    <!-- Idle activity and the Low-memory preset live on Battery & performance. -->
    <PreferenceCategory app:key="general_battery" app:title="@string/settings_behavior_battery_header">
        <Preference
            app:key="performance_link"
            app:persistent="false"
            app:title="@string/settings_destination_performance"
            app:summary="@string/settings_destination_performance_summary"
            app:fragment="com.termux.app.fragments.settings.termux.PerformancePreferencesFragment" />
    </PreferenceCategory>

    <PreferenceCategory app:key="general_more" app:title="@string/settings_general_more_header">
        <Preference
            app:key="backup_restore"
            app:persistent="false"
            app:title="@string/settings_destination_backup_restore"
            app:summary="@string/settings_destination_backup_restore_summary"
            app:fragment="com.termux.app.fragments.settings.termux.BackupRestorePreferencesFragment" />
        <Preference
            app:key="services_permissions"
            app:persistent="false"
            app:title="@string/settings_destination_services_permissions"
            app:summary="@string/settings_destination_services_permissions_summary"
            app:fragment="com.termux.app.fragments.settings.termux.ServicesPermissionsPreferencesFragment" />
        <Preference
            app:key="advanced_diagnostics"
            app:persistent="false"
            app:title="@string/settings_destination_advanced_diagnostics"
            app:summary="@string/settings_destination_advanced_diagnostics_summary"
            app:fragment="com.termux.app.fragments.settings.termux.AdvancedDiagnosticsPreferencesFragment" />
        <Preference
            app:key="about_support"
            app:persistent="false"
            app:title="@string/settings_destination_about_support"
            app:summary="@string/settings_destination_about_support_summary"
            app:fragment="com.termux.app.fragments.settings.AboutSupportPreferencesFragment" />
        <Preference
            app:key="app_launcher_help"
            app:persistent="false"
            app:title="@string/help_settings_title"
            app:summary="@string/help_settings_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:key="general_home_app" app:title="@string/settings_general_home_app_header">
        <Preference
            app:key="app_launcher_set_home"
            app:persistent="false"
            app:title="@string/settings_set_default_launcher_title"
            app:summary="@string/settings_set_default_launcher_summary" />
        <Preference
            app:key="app_launcher_restart"
            app:persistent="false"
            app:title="@string/settings_restart_launcher_title"
            app:summary="@string/settings_restart_launcher_summary" />
        <SwitchPreferenceCompat
            app:key="show_in_recents_when_not_default"
            app:title="@string/settings_show_recents_title"
            app:summary="@string/settings_show_recents_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
