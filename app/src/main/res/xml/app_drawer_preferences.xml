<?xml version="1.0" encoding="utf-8"?>
<!-- Icon size and column/row counts are deliberately absent: every drawer view resolves its own
     geometry from the plane's width now, and the category cards size their previews to fill. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        app:key="app_launcher_drawer_view_type"
        app:title="@string/settings_app_drawer_view_type_title"
        android:defaultValue="vertical"
        app:entries="@array/app_launcher_drawer_view_type_entries"
        app:entryValues="@array/app_launcher_drawer_view_type_values"
        app:useSimpleSummaryProvider="true" />

    <Preference
        app:key="app_launcher_category_sort"
        app:title="@string/settings_app_drawer_category_sort_title"
        app:summary="@string/settings_app_drawer_category_sort_summary" />

    <com.termux.app.fragments.settings.termux.CategorySortProgressPreference
        app:key="app_launcher_category_refresh"
        app:title="@string/settings_app_drawer_category_refresh_title" />
</PreferenceScreen>
