<?xml version="1.0" encoding="utf-8"?>
<!-- Icon size and columns are segmented rows: Auto is the sizing the drawer always had, the
     numbers are the steps. Columns hide for Categories. A Rows row (Horizontal
     only) waits for a fifth segment in the pill. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.termux.app.fragments.settings.SegmentedPillPreference
        app:key="app_launcher_drawer_view_type"
        app:title="@string/settings_app_drawer_grid_title"
        android:defaultValue="default"
        app:entries="@array/app_launcher_drawer_view_type_entries"
        app:entryValues="@array/app_launcher_drawer_view_type_values" />

    <com.termux.app.fragments.settings.SegmentedPillPreference
        app:key="app_launcher_drawer_icon_size"
        app:title="@string/settings_drawer_icon_size_title"
        android:defaultValue="auto"
        app:entries="@array/app_launcher_drawer_icon_size_entries"
        app:entryValues="@array/app_launcher_drawer_icon_size_values" />

    <com.termux.app.fragments.settings.SegmentedPillPreference
        app:key="app_launcher_drawer_columns"
        app:title="@string/settings_drawer_columns_title"
        android:defaultValue="auto"
        app:entries="@array/app_launcher_drawer_columns_entries"
        app:entryValues="@array/app_launcher_drawer_columns_values" />

    <com.termux.app.fragments.settings.SegmentedPillPreference
        app:key="app_launcher_drawer_az_side"
        app:title="@string/settings_drawer_az_side_title"
        android:defaultValue="right"
        app:entries="@array/app_launcher_drawer_az_side_entries"
        app:entryValues="@array/app_launcher_drawer_az_side_values" />

    <SwitchPreferenceCompat
        app:key="app_launcher_drawer_search_on_open"
        app:title="@string/settings_app_drawer_search_on_open_title"
        app:summary="@string/settings_app_drawer_search_on_open_summary"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        app:key="app_launcher_drawer_search_android_keyboard"
        app:title="@string/settings_app_drawer_search_android_keyboard_title"
        app:summary="@string/settings_app_drawer_search_android_keyboard_summary"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        app:key="app_launcher_drawer_search_bottom"
        app:title="@string/settings_drawer_search_bottom_title"
        app:summary="@string/settings_drawer_search_bottom_summary"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        app:key="app_launcher_drawer_remember_position"
        app:title="@string/settings_drawer_remember_position_title"
        app:summary="@string/settings_drawer_remember_position_summary"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        app:key="app_launcher_drawer_lower_start"
        app:title="@string/settings_drawer_lower_start_title"
        app:summary="@string/settings_drawer_lower_start_summary"
        android:defaultValue="false" />

    <Preference
        app:key="app_launcher_category_sort"
        app:title="@string/settings_app_drawer_category_sort_title"
        app:summary="@string/settings_app_drawer_category_sort_summary" />

    <com.termux.app.fragments.settings.termux.CategorySortProgressPreference
        app:key="app_launcher_category_refresh"
        app:title="@string/settings_app_drawer_category_refresh_title" />
</PreferenceScreen>
