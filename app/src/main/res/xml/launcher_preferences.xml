<?xml version="1.0" encoding="utf-8"?>
<!-- Apps & dock (was Dock & drawer). The dock's own page folded in here (pinned apps and the
     usage-ranked page); Home's rows moved to Home and Set as default launcher to General. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:key="dock_drawer_dock" app:title="@string/settings_dock_header">
        <Preference
            app:key="app_launcher_default_buttons"
            app:title="@string/settings_edit_pinned_apps_title"
            app:summary="@string/settings_edit_pinned_apps_summary" />
        <SwitchPreferenceCompat
            app:key="app_launcher_most_used_page"
            app:title="@string/settings_most_used_page_title"
            app:summary="@string/settings_most_used_page_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- Swipe down for app drawer and Double-tap to lock moved to Home › Gestures. -->
    <PreferenceCategory app:key="dock_drawer_drawer" app:title="@string/settings_drawer_header">
        <Preference
            app:key="app_launcher_drawer_layout"
            app:title="@string/settings_app_drawer_view_type_title"
            app:fragment="com.termux.app.fragments.settings.termux.AppDrawerPreferencesFragment" />
        <Preference
            app:key="app_launcher_sub_search"
            app:persistent="false"
            app:title="@string/settings_apps_sub_search_title"
            app:summary="@string/settings_apps_sub_search_summary"
            app:fragment="com.termux.app.fragments.settings.termux.LauncherSearchPreferencesFragment" />
        <!-- Opens the Linux apps section; hidden in a build made without the X server. -->
        <Preference
            app:key="linux_apps_in_drawer"
            app:persistent="false"
            app:title="@string/settings_apps_linux_apps_link_title"
            app:summary="@string/settings_apps_linux_apps_link_summary"
            app:fragment="com.termux.app.fragments.settings.termux.X11DisplayPreferencesFragment" />
    </PreferenceCategory>
</PreferenceScreen>
