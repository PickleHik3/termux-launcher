<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme.TermuxApp.* now live once in values/themes.xml; only the wallpaper variant remains. -->
    <!--
     https://github.com/material-components/material-components-android/blob/master/lib/java/com/google/android/material/theme/res/values/themes.xml
     https://m3.material.io/components
    -->

    <style name="Theme.TermuxActivity.Wallpaper" parent="Theme.TermuxActivity.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

</resources>
